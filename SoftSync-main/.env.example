# Copy this file to .env for local Docker Compose. Never commit the real .env.
# Production callback: https://softsync.id.vn/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional initial administrator account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Single-account CV integration (also configure the FastAPI backend).
CV_FRONTEND_URL=
CV_API_URL=
SOFTSYNC_SHARED_SECRET=
SOFTSYNC_ISSUER=softsync

# Local frontend + backend (public URLs used by the browser).
FRONTEND_ORIGINS=http://localhost:3000
SOFTSYNC_APP_URL=http://localhost:8081
