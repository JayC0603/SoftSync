@inherits LocalizedComponentBase
<button type="button" class="btn btn-primary ss-save-button" disabled="@(Busy || Disabled)" aria-busy="@Busy.ToString().ToLowerInvariant()" @onclick="OnClick">
    @if(Busy){<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>}
    @(Busy ? (Ui.Current==AppLanguage.Vi ? "Đang lưu…" : "Saving…") : Ui.Text("Save"))
</button>
@code {
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
