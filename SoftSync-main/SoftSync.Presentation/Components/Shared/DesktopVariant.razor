@implements IAsyncDisposable
@inject IJSRuntime JS

@if (desktop)
{
    @Desktop
}
else
{
    @Mobile
}

@code {
    [Parameter, EditorRequired] public RenderFragment Desktop { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment Mobile { get; set; } = default!;
    private bool desktop;
    private int? subscription;
    private DotNetObjectReference<DesktopVariant>? reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        reference = DotNetObjectReference.Create(this);
        subscription = await JS.InvokeAsync<int>("ssDesktopVariant.subscribe", reference);
    }

    [JSInvokable]
    public Task SetDesktop(bool value)
    {
        if (desktop == value) return Task.CompletedTask;
        desktop = value;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (subscription is int id) await JS.InvokeVoidAsync("ssDesktopVariant.unsubscribe", id);
        }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
