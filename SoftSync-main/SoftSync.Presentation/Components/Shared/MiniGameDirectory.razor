@inherits LocalizedComponentBase

<div class="mg-directory">
    <header class="mg-hero">
        <div class="mg-intro">
            <span class="mg-kicker">@T("Inclusive Skill Challenge", "Thử thách kỹ năng")</span>
            <h1 id="game-title">Mini Game</h1>
            <p>@T("Practice soft skills through short interactive challenges. Choose a game and start training.", "Luyện kỹ năng mềm qua những thử thách tương tác ngắn. Chọn trò chơi và bắt đầu luyện tập.")</p>
        </div>
        <div class="mg-controller" aria-hidden="true">
            <svg viewBox="0 0 180 150" fill="none">
                <defs><linearGradient id="mg-pad" x1="40" y1="20" x2="135" y2="140" gradientUnits="userSpaceOnUse"><stop stop-color="#61c9ff"/><stop offset=".45" stop-color="#167bff"/><stop offset="1" stop-color="#1742dd"/></linearGradient><linearGradient id="mg-key" x2="1" y2="1"><stop stop-color="white"/><stop offset="1" stop-color="#b3e0ff"/></linearGradient></defs>
                <circle cx="95" cy="67" r="60" fill="#b6d9ff" opacity=".45"/>
                <path d="M44 39Q88 25 134 44Q149 53 158 108Q163 139 145 137Q131 136 113 113H66Q44 139 27 131Q11 124 23 91L34 52Z" fill="url(#mg-pad)" stroke="#82cfff" stroke-width="2"/>
                <path d="M52 59v28m-14-14h28" stroke="#0e50d2" stroke-width="13" stroke-linecap="round" transform="translate(1 3)"/><path d="M52 57v28M38 71h28" stroke="url(#mg-key)" stroke-width="11" stroke-linecap="round"/>
                <g fill="url(#mg-key)"><circle cx="120" cy="62" r="6"/><circle cx="134" cy="77" r="6"/><circle cx="106" cy="77" r="6"/><circle cx="120" cy="92" r="6"/></g>
                <path d="m150 24 7-12m3 25 12-6" stroke="#298bff" stroke-width="5" stroke-linecap="round"/>
            </svg>
        </div>
    </header>
    <nav class="mg-tabs" aria-label="@T("Game navigation", "Điều hướng trò chơi")">
        <span aria-current="page"><i class="bi bi-grid-fill" aria-hidden="true"></i>@T("Challenges", "Thử thách")</span>
        <a href="/game/history"><i class="bi bi-clock-history" aria-hidden="true"></i>@T("Attempt history", "Lịch sử làm bài")</a>
    </nav>
    <div class="mg-games">
        @foreach (var game in Games)
        {
            <article class="mg-card mg-game-@game.Key">
                <div class="mg-icon" aria-hidden="true">
                    @if (game.Key == "eisenhower")
                    {
                        <div class="mg-matrix"><b></b><b></b><b></b><b></b></div>
                    }
                    else
                    {
                        <i class="bi @game.Icon"></i>
                        @if (game.Key == "inbox-rush") { <span class="mg-unread"></span> }
                    }
                </div>
                <div class="mg-copy">
                    <h2>@game.Name</h2>
                    <p>@T(game.En, game.Vi)</p>
                    <div class="mg-metadata"><span><i class="bi bi-card-checklist" aria-hidden="true"></i>@T("Interactive", "Tương tác")</span><span><i class="bi bi-clock" aria-hidden="true"></i>@T("Self-paced", "Tự luyện")</span></div>
                </div>
                <span class="mg-scenery" aria-hidden="true"><i class="bi @game.Decoration"></i></span>
                <a class="mg-play" href="/games/@game.Key/index.html" aria-label="@(T("Play ", "Chơi ") + game.Name)">@T("Play now", "Chơi ngay") <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </article>
        }
    </div>
    <aside class="mg-note">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        <div><h2>@T("Challenge status", "Trạng thái thử thách")</h2><p>@T("Explore the games above. Published quizzes are available below, and completed quiz attempts appear in your history.", "Khám phá các trò chơi phía trên. Các bài kiểm tra đã xuất bản nằm bên dưới; kết quả hoàn thành được lưu trong lịch sử làm bài.")</p><a href="/game/history"><i class="bi bi-calendar-check" aria-hidden="true"></i>@T("View your attempt history", "Xem lịch sử làm bài của bạn")</a></div>
    </aside>
</div>

@code {
    private string T(string en, string vi) => L.Current == AppLanguage.Vi ? vi : en;
    private static readonly (string Key, string Name, string Icon, string Decoration, string En, string Vi)[] Games = [
        ("eisenhower", "Eisenhower Matrix", "bi-grid-fill", "bi-grid-fill", "Prioritize tasks by urgency and importance.", "Ưu tiên công việc theo mức độ khẩn cấp và quan trọng."),
        ("focus-fortress", "Focus Fortress", "bi-shield-fill-check", "bi-flag-fill", "Protect your focus by identifying distractions.", "Bảo vệ sự tập trung bằng cách nhận diện những yếu tố gây xao nhãng."),
        ("inbox-rush", "Inbox Rush", "bi-envelope-fill", "bi-send-fill", "Sort urgent messages and plan your next move.", "Sắp xếp tin nhắn khẩn cấp và lên kế hoạch cho bước tiếp theo.")];
}
