@inherits LocalizedComponentBase
@rendermode InteractiveServer
@if (ErrorNotice)
{
    <div id="blazor-error-ui">
        @DesktopText.Text("An unhandled error has occurred.")
        <a href="" class="reload">@DesktopText.Text("Reload")</a>
        <button type="button" class="dismiss" aria-label="@DesktopText.Text("Cancel")">🗙</button>
    </div>
}
else
{
    <a class="ss-skip-link" href="#main-content">@DesktopText.Text("Skip to main content")</a>
}
@code { [Parameter] public bool ErrorNotice { get; set; } }
