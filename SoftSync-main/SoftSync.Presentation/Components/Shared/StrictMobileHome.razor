@inherits LocalizedComponentBase
@using SoftSync.Common
@using SoftSync.Common.Dtos
@using SoftSync.Presentation.Components.Journey
@using System.Globalization

<div class="sh-home" id="sh-top">
    <section class="sh-search" aria-label="@T("Tìm kiếm học tập", "Learning search")">
        <div><i class="bi bi-search" aria-hidden="true"></i><input type="search" @bind="query" @bind:event="oninput" placeholder="@T("Tìm bài học, kỹ năng, lộ trình…", "Search lessons, skills, roadmap…")" aria-label="@T("Tìm trong lộ trình", "Search your roadmap")" /></div>
        <details><summary aria-label="@T("Bộ lọc", "Filters")"><i class="bi bi-sliders" aria-hidden="true"></i></summary><label>@T("Hiển thị bài học", "Show lessons")<select @bind="scope"><option value="all">@T("Tất cả", "All")</option><option value="available">@T("Có thể học", "Available")</option><option value="completed">@T("Đã hoàn thành", "Completed")</option></select></label></details>
        @if (!string.IsNullOrWhiteSpace(query) || scope != "all")
        {
            <div class="sh-search-results" aria-live="polite">
                @foreach (var item in Results) { <a href="@(Locked(item) ? MapUrl : Lesson(item))"><strong>@L.Ui(item.Title)</strong><small>@L.Ui(item.SkillName) · @(Locked(item) ? T("Chưa mở khóa", "Locked") : T("Bài học", "Lesson"))</small></a> }
                @if (ShowResourceResult) { <a href="/resources"><strong>@T("Tài nguyên học tập", "Learning resources")</strong><small>@T("Mở thư viện tài nguyên", "Open the resource library")</small></a> }
                else if (!Results.Any()) { <p>@T("Không tìm thấy bài học phù hợp.", "No matching lessons.")</p> }
            </div>
        }
    </section>
    <header class="sh-greeting">
        <h1>@T($"Chào {Name}!", $"Hi {Name}!") <span aria-hidden="true">👋</span></h1>
        <p>@T("Sẵn sàng cho một bước tiến mới?", "Ready for your next step?")</p>
        <img src="/images/home-approved/welcome_vietnam_mountain.webp" alt="" />
    </header>
    <section class="sh-goal sh-card">
        <div><h2>@T("Mục tiêu hôm nay", "Today's goal")</h2><p>@(Current is null ? Goal : AllDone ? T("Nhìn lại thành quả học tập", "Review your progress") : T("Hoàn thành 1 bài học", "Complete one lesson"))</p></div>
        <a href="@ContinueUrl">@T("Xem chi tiết", "View details") <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    </section>
    <section class="sh-continue sh-card" aria-labelledby="sh-continue-title">
        <img class="sh-lesson-art" src="/images/home-approved/hero_student_laptop.webp" alt="" />
        <div class="sh-lesson-copy">
            <h2 id="sh-continue-title">@T("BÀI HỌC HIỆN TẠI", "CURRENT LESSON")</h2>
            @if (Current is {} current)
            {
                <h3>@L.Ui(current.Title)</h3>
                <p><strong>@T($"Chặng {Ordinal(current)}/{SelectedItems.Count}", $"Level {Ordinal(current)}/{SelectedItems.Count}")</strong></p>
                <p>@T($"{current.CompletedActivityCount}/{current.TotalActivityCount} hoạt động", $"{current.CompletedActivityCount}/{current.TotalActivityCount} activities")</p>
            }
            else { <p class="sh-lesson-empty">@T("Lộ trình sẽ xuất hiện sau bài đánh giá kỹ năng.", "Your roadmap will appear after your skills assessment.")</p> }
            <a class="sh-primary" href="@ContinueUrl">@(Current is null ? T("Bắt đầu đánh giá", "Start assessment") : AllDone ? T("Xem thành quả", "View progress") : Locked(Current) ? T("Xem lộ trình", "View roadmap") : T("Tiếp tục bài học", "Continue lesson")) <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        </div>
    </section>
    <section class="sh-stats" aria-label="@T("Thống kê học tập", "Learning statistics")">
        <a href="/progress"><strong>@Items.Count(x => x.IsCompleted)</strong><small>@T("Bài học hoàn thành", "Lessons completed")</small></a>
        <a href="/progress"><strong>@Completed</strong><small>@T("Hoạt động hoàn thành", "Activities completed")</small></a>
        <a href="/progress"><strong>@User.ExperiencePoints</strong><small>@T("XP tích lũy", "Total XP")</small></a>
        <a href="/progress"><strong>@User.Level</strong><small>@T("Cấp độ hiện tại", "Current level")</small></a>
    </section>
    <section class="sh-journey sh-card">
        <header class="sh-heading"><h2>@T("Hành trình phát triển kỹ năng", "Your skills journey")</h2><a href="@MapUrl">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @foreach(var track in Ordered.GroupBy(SkillTheme.KeyFor))
        {
            var lessons = track.ToList();
            var target = lessons.FirstOrDefault(x => x.IsNextRecommended && !x.IsCompleted && !Locked(x)) ?? lessons.FirstOrDefault(x => !x.IsCompleted && !Locked(x)) ?? lessons.LastOrDefault(x => x.IsCompleted) ?? lessons[0];
            var done = lessons.Sum(x => x.CompletedActivityCount);
            var total = lessons.Sum(x => x.TotalActivityCount);
            var percent = RoadmapProgressCalculator.Percent(done, total);
            <a class="sh-journey-row" href="@($"/roadmap?skill={Uri.EscapeDataString(track.Key)}")">
                <img src="/images/home-approved/journey_mountains_student.webp" alt="" />
                <div><h3>@L.Ui(string.IsNullOrWhiteSpace(target.SkillName) ? target.Title : target.SkillName)</h3><div class="sh-bar-row"><small>@T($"{(lessons.All(x=>x.IsCompleted) ? "Hoàn thành" : "Đang học")} · {done}/{total} hoạt động", $"{done}/{total} activities")</small><strong>@percent%</strong></div><progress value="@percent" max="100" aria-label="@L.Ui(target.SkillName)"></progress></div>
            </a>
        }
        @if(Items.Count == 0) { <p class="sh-empty">@T("Chưa có lộ trình học tập.", "No learning roadmap yet.") <a href="@ContinueUrl">@T("Bắt đầu đánh giá", "Start assessment")</a></p> }
    </section>
    <section class="sh-quick sh-card">
        <header class="sh-heading"><h2>@T("Truy cập nhanh", "Quick access")</h2></header>
        <div class="sh-quick-grid">
            <a href="/progress"><img src="/images/home-approved/quick_progress.webp" alt="" /><span><strong>@T("Tiến độ", "Progress")</strong><small>@T("Xem quá trình học tập", "View learning progress")</small><i class="bi bi-chevron-right" aria-hidden="true"></i></span></a>
            <a href="/resources"><img src="/images/home-approved/quick_resources.webp" alt="" /><span><strong>@T("Tài nguyên", "Resources")</strong><small>@T("Tài liệu, mẫu CV, biểu mẫu…", "Documents, CV templates…")</small><i class="bi bi-chevron-right" aria-hidden="true"></i></span></a>
            <a href="@($"/assessment/{User.Id}")"><img src="/images/home-approved/quick_test.webp" alt="" /><span><strong>@T("Kiểm tra", "Assessment")</strong><small>@T("Bài kiểm tra kỹ năng", "Skills assessment")</small><i class="bi bi-chevron-right" aria-hidden="true"></i></span></a>
            <a href="/community"><img src="/images/home-approved/quick_community.webp" alt="" /><span><strong>@T("Cộng đồng", "Community")</strong><small>@T("Kết nối và thảo luận", "Connect and discuss")</small><i class="bi bi-chevron-right" aria-hidden="true"></i></span></a>
        </div>
    </section>
    <a class="sh-syncy sh-card" href="/assistant">
        <img src="/images/home-approved/syncy_support.webp" alt="" />
        <span><span class="sh-syncy-title"><strong>@T("Hỏi SYNCY", "Ask SYNCY")</strong><small>@T("Trợ lý AI của bạn", "Your AI assistant")</small></span><small>@T("Đặt câu hỏi, nhờ gợi ý lộ trình hoặc giải đáp thắc mắc về kỹ năng, nghề nghiệp nhé!", "Ask questions or get help with your roadmap, skills and career!")</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
    <section class="sh-recommendation sh-card"><header class="sh-heading"><h2>@T("Gợi ý dành cho bạn", "Suggestions for you")</h2><a href="/roadmap">@T("Xem thêm", "Explore") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (Suggestion is {} suggestion) { <a class="sh-list-row" href="@Lesson(suggestion)"><img src="@Thumbnail(suggestion)" alt="" /><span><small class="sh-skill-label">@L.Ui(suggestion.SkillName)</small><strong>@L.Ui(suggestion.Title)</strong><small>@T($"{suggestion.CompletedActivityCount}/{suggestion.TotalActivityCount} hoạt động", $"{suggestion.CompletedActivityCount}/{suggestion.TotalActivityCount} activities")</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a> }
        else { <p class="sh-empty">@T("Chưa có đề xuất khác trong lộ trình của bạn.", "No other suggestions in your roadmap yet.")</p> }
    </section>
    <section class="sh-mentors sh-card"><header class="sh-heading"><h2>@T("Đội ngũ cố vấn đồng hành", "Your mentor team")</h2><a href="/mentors">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (MentorLoading) { <p class="sh-empty" role="status">@T("Đang tải cố vấn…", "Loading mentors…")</p> }
        else if (MentorFailed) { <p class="sh-empty">@T("Chưa thể tải cố vấn.", "Unable to load mentors.") <button @onclick="RetryMentors">@T("Thử lại", "Retry")</button></p> }
        else { <div class="sh-mentor-grid ss-mentor-carousel" tabindex="0" aria-label="@T("Danh sách cố vấn, kéo ngang để xem thêm", "Mentors, scroll horizontally to explore")">@foreach (var mentor in Mentors.DistinctBy(x => x.Id).Take(3)) { <a href="/mentors/@mentor.Id"><img src="@mentor.AvatarUrl" alt="" /><span><strong>@mentor.Name</strong><small>@L.Ui(mentor.Expertise)</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a> }@if (Mentors.Count == 0) { <p class="sh-empty">@T("Chưa có cố vấn khả dụng.", "No mentors available.")</p> }</div> }
    </section>
    <section class="sh-achievements sh-card"><header class="sh-heading"><h2>@T("Thành tích gần đây", "Recent achievements")</h2><a href="/progress">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        <div id="sh-achievement-list">
        @foreach(var achievement in Achievements.Take(achievementsExpanded ? int.MaxValue : 1)) { <a @key="achievement.Key" class="sh-list-row" href="@achievement.Url"><i class="bi bi-trophy-fill sh-trophy" aria-hidden="true"></i><span><strong>@achievement.Title</strong><small>@L.Ui(achievement.Item.Title)</small></span><time datetime="@achievement.At.ToString("O")">@LocalDate(achievement.At)</time><i class="bi bi-check-circle-fill" aria-hidden="true"></i></a> }
        </div>
        @if(Achievements.Count == 0) { <p class="sh-empty">@T("Hoàn thành bài học đầu tiên để ghi lại thành tích của bạn.", "Complete your first lesson to record an achievement.")</p> }
        @if(Achievements.Count > 1) { <button class="sh-show-more" aria-expanded="@achievementsExpanded.ToString().ToLowerInvariant()" aria-controls="sh-achievement-list" @onclick="() => achievementsExpanded = !achievementsExpanded">@(achievementsExpanded ? T("Thu gọn", "Show less") : T($"Xem thêm ({Achievements.Count - 1})", $"Show more ({Achievements.Count - 1})")) <i class="bi @(achievementsExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i></button> }
    </section>
    <section class="sh-quote sh-card"><i class="bi bi-quote" aria-hidden="true"></i><blockquote><p>@T("Mỗi bước nhỏ hôm nay đều tạo nên phiên bản tốt hơn của bạn ngày mai.", "Every small step today builds a better version of you tomorrow.")</p><cite>— SYNCY</cite></blockquote><img src="/images/home-approved/quote_landscape.webp" alt="" /></section>
    <footer class="sh-footer">
        <div class="sh-footer-top"><div class="sh-footer-brand"><img src="/images/logo.png" alt="" /><strong>SoftSync</strong><small>@T("Học kỹ năng mềm cùng AI.", "Learn soft skills with AI.")</small></div><a href="https://www.facebook.com/SoftSyncSpace" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a></div>
        <nav aria-label="@T("Thông tin SoftSync", "About SoftSync")"><a href="/about">@T("Về chúng tôi", "About us")</a><a href="/mentors">Mentor</a><a href="/community">@T("Cộng đồng", "Community")</a><a href="/resources">@T("Tài nguyên", "Resources")</a></nav>
        <nav aria-label="@T("Hỗ trợ và pháp lý", "Support and legal")"><span aria-disabled="true" title="TBD — URL">@T("Trợ giúp", "Help")</span><span aria-disabled="true" title="TBD — URL">@T("Chính sách bảo mật", "Privacy")</span><span aria-disabled="true" title="TBD — URL">@T("Điều khoản sử dụng", "Terms")</span><span aria-disabled="true" title="TBD — URL">@T("Liên hệ", "Contact")</span></nav>
        <small class="sh-copyright">© @DateTime.UtcNow.AddHours(7).Year SoftSync</small>
    </footer>
</div>

@code {
    [Parameter, EditorRequired] public UserDto User { get; set; } = default!;
    [Parameter] public IReadOnlyList<RoadmapItemDto> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<MentorDto> Mentors { get; set; } = [];
    [Parameter] public bool MentorLoading { get; set; }
    [Parameter] public bool MentorFailed { get; set; }
    [Parameter] public EventCallback RetryMentors { get; set; }
    private bool Vi => L.Current == AppLanguage.Vi;
    private string T(string vi, string en) => Vi ? vi : en;
    private string Name => User.PublicName.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? User.PublicName;
    private string query = "", scope = "all";
    private string? selectedSkill;
    private IReadOnlyList<RoadmapItemDto> Ordered => VietnamJourney.Order(Items);
    private List<RoadmapItemDto> SelectedItems => Ordered.Where(x => selectedSkill == null || SkillTheme.KeyFor(x) == selectedSkill).ToList();
    private RoadmapItemDto? Current => SelectedItems.FirstOrDefault(x => x.IsNextRecommended && !x.IsCompleted && !Locked(x)) ?? SelectedItems.FirstOrDefault(x => !x.IsCompleted && !Locked(x)) ?? SelectedItems.LastOrDefault(x => x.IsCompleted) ?? SelectedItems.FirstOrDefault();
    private bool AllDone => Items.Count > 0 && Items.All(x => x.IsCompleted);
    private string ContinueUrl => Current is null ? $"/assessment/{User.Id}" : AllDone ? "/progress" : Locked(Current) ? MapUrl : Lesson(Current);
    private string MapUrl => selectedSkill is null ? "/roadmap" : $"/roadmap?skill={Uri.EscapeDataString(selectedSkill)}";
    private void SelectSkill(string key) => selectedSkill = key;
    protected override void OnParametersSet() { if (selectedSkill is null || !Items.Any(x => SkillTheme.KeyFor(x) == selectedSkill)) selectedSkill = Ordered.FirstOrDefault(x => !x.IsCompleted) is { } item ? SkillTheme.KeyFor(item) : Ordered.FirstOrDefault() is { } first ? SkillTheme.KeyFor(first) : null; }
    private string Lesson(RoadmapItemDto item) => $"/roadmap/lecture/{User.Id}/{item.Id}?step={JourneyProgress.ResumeStep(item)}";
    private bool Locked(RoadmapItemDto item) => JourneyProgress.State(item, Ordered.ToList().FindIndex(x => x.Id == item.Id), JourneyProgress.ActiveIndex(Ordered), RoadmapReviewMode.Enabled) == JourneyState.Locked;
    private int Ordinal(RoadmapItemDto item) => SelectedItems.FindIndex(x => x.Id == item.Id) + 1;
    private string Goal => Current is null ? T("Khám phá thế mạnh qua bài đánh giá kỹ năng.", "Discover your strengths with a skills assessment.") : AllDone ? T("Nhìn lại thành quả học tập của bạn.", "Reflect on your learning progress.") : T($"Tiếp tục bài “{L.Ui(Current.Title)}” trong lộ trình {L.Ui(Current.SkillName)}.", $"Continue “{L.Ui(Current.Title)}” in your {L.Ui(Current.SkillName)} journey.");
    private int Completed => Items.Sum(x => x.CompletedActivityCount);
    private int Total => Items.Sum(x => x.TotalActivityCount);
    private int Overall => RoadmapProgressCalculator.Percent(Completed, Total);
    private int ActiveSkills => Items.GroupBy(SkillTheme.KeyFor).Count(g => g.Any(x => !x.IsCompleted));
    private RoadmapItemDto? Suggestion => Ordered.FirstOrDefault(x => x.Id != Current?.Id && !x.IsCompleted && !Locked(x));
    private IEnumerable<RoadmapItemDto> Results => Ordered.Where(x => (scope == "all" || scope == "completed" && x.IsCompleted || scope == "available" && !Locked(x)) && $"{L.Ui(x.Title)} {L.Ui(x.SkillName)}".Contains(query.Trim(), StringComparison.CurrentCultureIgnoreCase)).Take(8);
    private bool ShowResourceResult => scope == "all" && !string.IsNullOrWhiteSpace(query) && T("Tài nguyên", "Resources").Contains(query.Trim(), StringComparison.CurrentCultureIgnoreCase);
    private static string Thumbnail(RoadmapItemDto item) => $"/images/home-v3/{(SkillTheme.KeyFor(item) switch { "time" => "time-management", "teamwork" => "teamwork", _ => "roadmap-landscape" })}.webp";
    private static IEnumerable<(DateTime At, int Step)> Stamps(RoadmapItemDto item) { var dates = new[] { item.VideoCompletedAtUtc, item.ScriptCompletedAtUtc, item.SummaryCompletedAtUtc, item.PracticeCompletedAtUtc, item.ScenarioCompletedAtUtc, item.ReflectionCompletedAtUtc }; for (var i = 0; i < dates.Length; i++) if (dates[i] is { } at) yield return (at, i + 1); }
    private int Streak { get { var days = Items.SelectMany(Stamps).Select(x => x.At.AddHours(7).Date).ToHashSet(); var today = DateTime.UtcNow.AddHours(7).Date; var cursor = days.Contains(today) ? today : today.AddDays(-1); var count = 0; while (days.Contains(cursor)) { count++; cursor = cursor.AddDays(-1); } return count; } }
    private string LocalDate(DateTime at) => at.AddHours(7).ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
    private sealed record HomeEvent(RoadmapItemDto Item, string Title, DateTime At, string Url, bool Achievement, string Key);
    private List<HomeEvent> Events => Ordered.SelectMany(item => {
        var names = new[] { T("Video", "Video"), T("Nội dung", "Reading"), T("Tóm tắt", "Summary"), T("Quiz", "Quiz"), T("Thực hành", "Practice"), T("Phản tư", "Reflection") };
        // A passing quiz writes both PracticeCompletedAtUtc and QuizHistory using
        // the same timestamp. Render that persisted event once, preserving every
        // distinct attempt (including multiple valid attempts on the same day).
        var events = Stamps(item).Where(x => x.Step != 4 || !item.QuizHistory.Any(q => q.SubmittedAtUtc == x.At))
            .Select(x => new HomeEvent(item, $"{names[x.Step - 1]}: {L.Ui(item.Title)}", x.At, $"/roadmap/lecture/{User.Id}/{item.Id}?step={x.Step}", false, $"{item.Id}:step:{x.Step}:{x.At.Ticks}")).ToList();
        if (item.IsCompleted && Stamps(item).Any()) events.Add(new(item, T("Hoàn thành bài học", "Lesson completed"), Stamps(item).Max(x => x.At), Lesson(item), true, $"{item.Id}:completed"));
        events.AddRange(item.QuizHistory.Where(x => x.SubmittedAtUtc != default).Select(x => new HomeEvent(item, x.Passed ? T("Vượt qua kiểm tra", "Knowledge check passed") : T("Làm bài kiểm tra", "Knowledge check submitted"), x.SubmittedAtUtc, $"/roadmap/lecture/{User.Id}/{item.Id}?step=4", x.Passed, $"{item.Id}:quiz:{x.AttemptNumber}:{x.SubmittedAtUtc.Ticks}")));
        return events;
    }).OrderByDescending(x => x.At).ToList();
    private List<HomeEvent> Recent => Events.Where(x => !x.Achievement || x.Key != $"{x.Item.Id}:completed").DistinctBy(x => x.Key).ToList();
    private bool achievementsExpanded;
    private List<HomeEvent> Achievements => Events.Where(x => x.Achievement).DistinctBy(x => x.Key).ToList();
}
