@inherits LocalizedComponentBase
@using SoftSync.Common
@using SoftSync.Common.Dtos
@using SoftSync.Presentation.Components.Journey
@using System.Globalization

<div class="sh-home" id="sh-top">
    <section class="sh-search" aria-label="@T("Tìm kiếm học tập", "Learning search")">
        <div><i class="bi bi-search" aria-hidden="true"></i><input type="search" @bind="query" @bind:event="oninput" placeholder="@T("Tìm bài học, kỹ năng, lộ trình…", "Search lessons, skills, roadmap…")" aria-label="@T("Tìm trong lộ trình", "Search your roadmap")" /></div>
        <details><summary aria-label="@T("Bộ lọc", "Filters")"><i class="bi bi-sliders" aria-hidden="true"></i></summary><label>@T("Hiển thị bài học", "Show lessons")<select @bind="scope"><option value="all">@T("Tất cả", "All")</option><option value="available">@T("Có thể học", "Available")</option><option value="completed">@T("Đã hoàn thành", "Completed")</option></select></label></details>
        @if (!string.IsNullOrWhiteSpace(query) || scope != "all")
        {
            <div class="sh-search-results" aria-live="polite">
                @foreach (var item in Results) { <a href="@(Locked(item) ? MapUrl : Lesson(item))"><strong>@L.Ui(item.Title)</strong><small>@L.Ui(item.SkillName) · @(Locked(item) ? T("Chưa mở khóa", "Locked") : T("Bài học", "Lesson"))</small></a> }
                @if (ShowResourceResult) { <a href="/resources"><strong>@T("Tài nguyên học tập", "Learning resources")</strong><small>@T("Mở thư viện tài nguyên", "Open the resource library")</small></a> }
                else if (!Results.Any()) { <p>@T("Không tìm thấy bài học phù hợp.", "No matching lessons.")</p> }
            </div>
        }
    </section>
    <header class="sh-greeting"><h1>@T($"Chào mừng trở lại, {Name}!", $"Welcome back, {Name}!") <span aria-hidden="true">👋</span></h1><p>@T("Tiếp tục hành trình phát triển kỹ năng của bạn.", "Continue your skills development journey.")</p><img src="/images/home-v3/welcome-landscape.webp" alt="" /></header>
    <a class="sh-goal sh-card" href="@ContinueUrl"><i class="bi bi-bullseye" aria-hidden="true"></i><span><strong>@T("Mục tiêu hôm nay", "Today's goal")</strong><small>@Goal</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    <section class="sh-continue sh-card" aria-labelledby="sh-continue-title">
        <header><h2 id="sh-continue-title">@T("Tiếp tục học", "Continue learning")</h2>@if (Current is not null) { <span class="sh-status">@(AllDone ? T("Hoàn thành", "Completed") : Locked(Current) ? T("Chưa mở khóa", "Locked") : T("Đang học", "Learning"))</span> }</header>
        @if (Current is { } current)
        {
            <div class="sh-continue-body"><img src="@Thumbnail(current)" alt="" /><div><h3>@L.Ui(current.SkillName)</h3><p>@T($"Chặng {Ordinal(current)}/{SelectedItems.Count} · {L.Ui(current.Title)}", $"Level {Ordinal(current)}/{SelectedItems.Count} · {L.Ui(current.Title)}")</p><div class="sh-bar-row"><progress value="@current.ProgressPercent" max="100" aria-label="@T("Tiến độ bài học", "Lesson progress")"></progress><strong>@current.ProgressPercent%</strong></div></div></div>
        }
        else { <p class="sh-empty">@T("Lộ trình sẽ xuất hiện sau bài đánh giá kỹ năng.", "Your roadmap will appear after your skills assessment.")</p> }
        <a class="sh-primary" href="@ContinueUrl"><i class="bi bi-play-fill" aria-hidden="true"></i>@(Current is null ? T("Bắt đầu đánh giá", "Start assessment") : AllDone ? T("Xem thành quả", "View progress") : Locked(Current) ? T("Xem lộ trình", "View roadmap") : T("Tiếp tục học", "Continue learning"))<i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    </section>
    <section class="sh-map" aria-label="@T("Bản đồ hành trình của bạn", "Your journey map")">
        <VietnamAdventureMap Items="Items" UserId="User.Id" Vietnamese="Vi" SelectedSkill="selectedSkill" SelectedSkillChanged="SelectSkill" Compact="true" />
    </section>
    <section class="sh-progress"><header class="sh-heading"><h2>@T("Tiến độ tổng quan", "Overall progress")</h2><a href="/progress">@T("Chi tiết", "Details") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header><div class="sh-card"><div class="sh-overall"><div class="sh-ring" style="@($"--sh-percent:{Overall}%")" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Overall" aria-label="@T("Tiến độ toàn bộ lộ trình", "Overall roadmap progress")"><strong>@Overall%</strong></div><div><progress value="@Overall" max="100" aria-label="@T("Tiến độ tổng quan", "Overall progress")"></progress><p>@T($"Đã hoàn thành {Completed}/{Total} hoạt động", $"Completed {Completed}/{Total} activities")</p></div></div><div class="sh-stats"><a href="/roadmap"><i class="bi bi-book" aria-hidden="true"></i><span><strong>@ActiveSkills</strong><small>@T("Kỹ năng đang học", "Active skills")</small></span></a><a href="/progress"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span><strong>@Completed</strong><small>@T("Hoạt động đã xong", "Activities completed")</small></span></a><a href="/progress"><i class="bi bi-fire" aria-hidden="true"></i><span><strong>@Streak</strong><small>@T("Ngày liên tiếp", "Day streak")</small></span></a></div></div></section>
    <section class="sh-recommendation"><header class="sh-heading"><h2>@T("Đề xuất cho bạn", "Suggestions for you")</h2><a href="/roadmap">@T("Xem thêm", "Explore") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (Suggestion is { } suggestion) { <a class="sh-list-row sh-card" href="@Lesson(suggestion)"><img src="@Thumbnail(suggestion)" alt="" /><span><strong>@L.Ui(suggestion.Title)</strong><small>@L.Ui(suggestion.SkillName)</small><small>@L.Ui(suggestion.Objective)</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a> }
        else { <p class="sh-card sh-empty">@T("Chưa có đề xuất khác trong lộ trình của bạn.", "No other suggestions in your roadmap yet.")</p> }
    </section>
    <section class="sh-quick"><header class="sh-heading"><h2>@T("Truy cập nhanh", "Quick access")</h2></header><div>
        <a href="/progress"><img src="/images/home-v3/quick-progress.webp" alt="" /><strong>@T("Tiến độ", "Progress")</strong></a>
        <a href="/resources"><img src="/images/home-v3/quick-resources.webp" alt="" /><strong>@T("Tài nguyên", "Resources")</strong></a>
        <a href="@($"/assessment/{User.Id}")"><img src="/images/home-v3/quick-quiz.webp" alt="" /><strong>@T("Kiểm tra", "Assessment")</strong></a>
        <a href="/community"><img src="/images/home-v3/quick-community.webp" alt="" /><strong>@T("Cộng đồng", "Community")</strong></a>
        <a href="/assistant"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i><strong>@T("Hỏi SYNCY", "Ask SYNCY")</strong></a>
    </div></section>
    <section class="sh-recent"><header class="sh-heading"><h2>@T("Hoạt động gần đây", "Recent activity")</h2><a href="/progress">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header><div class="sh-card">
        @foreach (var entry in Recent.Take(3)) { <a class="sh-list-row" href="@entry.Url"><img src="@Thumbnail(entry.Item)" alt="" /><span><strong>@entry.Title</strong><small>@L.Ui(entry.Item.SkillName)</small></span><time datetime="@entry.At.ToString("O")">@LocalDate(entry.At)</time><i class="bi bi-chevron-right" aria-hidden="true"></i></a> }
        @if (Recent.Count == 0) { <p class="sh-empty">@T("Chưa có hoạt động học tập được ghi nhận.", "No learning activity recorded yet.")</p> }
    </div></section>
    <section class="sh-mentors"><header class="sh-heading"><h2>@T("Đội ngũ cố vấn đồng hành", "Your mentor team")</h2><a href="/mentors">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (MentorLoading) { <p class="sh-card sh-empty" role="status">@T("Đang tải cố vấn…", "Loading mentors…")</p> }
        else if (MentorFailed) { <p class="sh-card sh-empty">@T("Chưa thể tải cố vấn.", "Unable to load mentors.") <button @onclick="RetryMentors">@T("Thử lại", "Retry")</button></p> }
        else { <div class="sh-mentor-grid">@foreach (var mentor in Mentors.Take(2)) { <a class="sh-card" href="/mentors/@mentor.Id"><img src="@mentor.AvatarUrl" alt="" /><span><strong>@mentor.Name</strong><small>@L.Ui(mentor.Expertise)</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a> }@if (Mentors.Count == 0) { <p class="sh-empty">@T("Chưa có cố vấn khả dụng.", "No mentors available.")</p> }</div> }
    </section>
    <section class="sh-achievements"><header class="sh-heading"><h2>@T("Thành tích gần đây", "Recent achievements")</h2><a href="/progress">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (Achievement is { } achievement) { <a class="sh-list-row sh-card" href="@achievement.Url"><i class="bi bi-trophy-fill sh-trophy" aria-hidden="true"></i><span><strong>@achievement.Title</strong><small>@L.Ui(achievement.Item.Title)</small></span><time datetime="@achievement.At.ToString("O")">@LocalDate(achievement.At)</time><i class="bi bi-check-circle-fill" aria-hidden="true"></i></a> }
        else { <p class="sh-card sh-empty">@T("Hoàn thành bài học đầu tiên để ghi lại thành tích của bạn.", "Complete your first lesson to record an achievement.")</p> }
    </section>
    <section class="sh-quote sh-card"><i class="bi bi-quote" aria-hidden="true"></i><blockquote><p>@T("“Mỗi bước nhỏ hôm nay đều tạo nên phiên bản tốt hơn của bạn ngày mai.”", "“Every small step today builds a better version of you tomorrow.”")</p><cite>— SYNCY</cite></blockquote><img src="/images/home-v3/quote-landscape.webp" alt="" /></section>
    <footer class="sh-footer"><div class="sh-footer-brand"><img src="/images/logo.png" alt="" /><strong>SoftSync</strong><small>@T("Học kỹ năng mềm cùng AI.", "Learn soft skills with AI.")</small></div><nav aria-label="@T("Thông tin SoftSync", "About SoftSync")"><a href="/about">@T("Về SoftSync", "About SoftSync")</a><span aria-disabled="true" title="TBD — URL">@T("Trợ giúp", "Help")</span><span aria-disabled="true" title="TBD — URL">@T("Chính sách bảo mật", "Privacy")</span><span aria-disabled="true" title="TBD — URL">@T("Điều khoản", "Terms")</span></nav><div class="sh-footer-contact"><a href="https://www.facebook.com/SoftSyncSpace" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a><span aria-disabled="true" title="TBD — URL">@T("Liên hệ", "Contact")</span><button type="button" onclick="window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});document.getElementById('main-content')?.scrollTo({top:0})">@T("Về đầu trang", "Back to top") ↑</button></div><small>© @DateTime.UtcNow.AddHours(7).Year SoftSync</small></footer>
</div>

@code {
    [Parameter, EditorRequired] public UserDto User { get; set; } = default!;
    [Parameter] public IReadOnlyList<RoadmapItemDto> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<MentorDto> Mentors { get; set; } = [];
    [Parameter] public bool MentorLoading { get; set; }
    [Parameter] public bool MentorFailed { get; set; }
    [Parameter] public EventCallback RetryMentors { get; set; }
    private bool Vi => L.Current == AppLanguage.Vi;
    private string T(string vi, string en) => Vi ? vi : en;
    private string Name => User.PublicName.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? User.PublicName;
    private string query = "", scope = "all";
    private string? selectedSkill;
    private IReadOnlyList<RoadmapItemDto> Ordered => VietnamJourney.Order(Items);
    private List<RoadmapItemDto> SelectedItems => Ordered.Where(x => selectedSkill == null || SkillTheme.KeyFor(x) == selectedSkill).ToList();
    private RoadmapItemDto? Current => SelectedItems.FirstOrDefault(x => x.IsNextRecommended && !x.IsCompleted && !Locked(x)) ?? SelectedItems.FirstOrDefault(x => !x.IsCompleted && !Locked(x)) ?? SelectedItems.LastOrDefault(x => x.IsCompleted) ?? SelectedItems.FirstOrDefault();
    private bool AllDone => Items.Count > 0 && Items.All(x => x.IsCompleted);
    private string ContinueUrl => Current is null ? $"/assessment/{User.Id}" : AllDone ? "/progress" : Locked(Current) ? MapUrl : Lesson(Current);
    private string MapUrl => selectedSkill is null ? "/roadmap" : $"/roadmap?skill={Uri.EscapeDataString(selectedSkill)}";
    private void SelectSkill(string key) => selectedSkill = key;
    protected override void OnParametersSet() { if (selectedSkill is null || !Items.Any(x => SkillTheme.KeyFor(x) == selectedSkill)) selectedSkill = Ordered.FirstOrDefault(x => !x.IsCompleted) is { } item ? SkillTheme.KeyFor(item) : Ordered.FirstOrDefault() is { } first ? SkillTheme.KeyFor(first) : null; }
    private string Lesson(RoadmapItemDto item) => $"/roadmap/lecture/{User.Id}/{item.Id}?step={JourneyProgress.ResumeStep(item)}";
    private bool Locked(RoadmapItemDto item) => JourneyProgress.State(item, Ordered.ToList().FindIndex(x => x.Id == item.Id), JourneyProgress.ActiveIndex(Ordered), RoadmapReviewMode.Enabled) == JourneyState.Locked;
    private int Ordinal(RoadmapItemDto item) => SelectedItems.FindIndex(x => x.Id == item.Id) + 1;
    private string Goal => Current is null ? T("Khám phá thế mạnh qua bài đánh giá kỹ năng.", "Discover your strengths with a skills assessment.") : AllDone ? T("Nhìn lại thành quả học tập của bạn.", "Reflect on your learning progress.") : T($"Tiếp tục bài “{L.Ui(Current.Title)}” trong lộ trình {L.Ui(Current.SkillName)}.", $"Continue “{L.Ui(Current.Title)}” in your {L.Ui(Current.SkillName)} journey.");
    private int Completed => Items.Sum(x => x.CompletedActivityCount);
    private int Total => Items.Sum(x => x.TotalActivityCount);
    private int Overall => RoadmapProgressCalculator.Percent(Completed, Total);
    private int ActiveSkills => Items.GroupBy(SkillTheme.KeyFor).Count(g => g.Any(x => !x.IsCompleted));
    private RoadmapItemDto? Suggestion => Ordered.FirstOrDefault(x => x.Id != Current?.Id && !x.IsCompleted && !Locked(x));
    private IEnumerable<RoadmapItemDto> Results => Ordered.Where(x => (scope == "all" || scope == "completed" && x.IsCompleted || scope == "available" && !Locked(x)) && $"{L.Ui(x.Title)} {L.Ui(x.SkillName)}".Contains(query.Trim(), StringComparison.CurrentCultureIgnoreCase)).Take(8);
    private bool ShowResourceResult => scope == "all" && !string.IsNullOrWhiteSpace(query) && T("Tài nguyên", "Resources").Contains(query.Trim(), StringComparison.CurrentCultureIgnoreCase);
    private static string Thumbnail(RoadmapItemDto item) => $"/images/home-v3/{(SkillTheme.KeyFor(item) switch { "time" => "time-management", "teamwork" => "teamwork", _ => "roadmap-landscape" })}.webp";
    private static IEnumerable<(DateTime At, int Step)> Stamps(RoadmapItemDto item) { var dates = new[] { item.VideoCompletedAtUtc, item.ScriptCompletedAtUtc, item.SummaryCompletedAtUtc, item.PracticeCompletedAtUtc, item.ScenarioCompletedAtUtc, item.ReflectionCompletedAtUtc }; for (var i = 0; i < dates.Length; i++) if (dates[i] is { } at) yield return (at, i + 1); }
    private int Streak { get { var days = Items.SelectMany(Stamps).Select(x => x.At.AddHours(7).Date).ToHashSet(); var today = DateTime.UtcNow.AddHours(7).Date; var cursor = days.Contains(today) ? today : today.AddDays(-1); var count = 0; while (days.Contains(cursor)) { count++; cursor = cursor.AddDays(-1); } return count; } }
    private string LocalDate(DateTime at) => at.AddHours(7).ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
    private sealed record HomeEvent(RoadmapItemDto Item, string Title, DateTime At, string Url, bool Achievement);
    private List<HomeEvent> Events => Ordered.SelectMany(item => {
        var names = new[] { T("Video", "Video"), T("Nội dung", "Reading"), T("Tóm tắt", "Summary"), T("Quiz", "Quiz"), T("Thực hành", "Practice"), T("Phản tư", "Reflection") };
        var events = Stamps(item).Select(x => new HomeEvent(item, $"{names[x.Step - 1]}: {L.Ui(item.Title)}", x.At, $"/roadmap/lecture/{User.Id}/{item.Id}?step={x.Step}", false)).ToList();
        if (item.IsCompleted && Stamps(item).Any()) events.Add(new(item, T("Hoàn thành bài học", "Lesson completed"), Stamps(item).Max(x => x.At), Lesson(item), true));
        events.AddRange(item.QuizHistory.Where(x => x.SubmittedAtUtc != default).Select(x => new HomeEvent(item, x.Passed ? T("Vượt qua kiểm tra", "Knowledge check passed") : T("Làm bài kiểm tra", "Knowledge check submitted"), x.SubmittedAtUtc, $"/roadmap/lecture/{User.Id}/{item.Id}?step=4", x.Passed)));
        return events;
    }).OrderByDescending(x => x.At).ToList();
    private List<HomeEvent> Recent => Events.Where(x => !x.Achievement || x.Title != T("Hoàn thành bài học", "Lesson completed")).DistinctBy(x => (x.Item.Id, x.At, x.Url)).ToList();
    private HomeEvent? Achievement => Events.FirstOrDefault(x => x.Achievement);
}
