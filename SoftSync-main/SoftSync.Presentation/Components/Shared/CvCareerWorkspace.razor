@using CvReviewException = SoftSync.Presentation.Services.CvReviewException
@inherits LocalizedComponentBase
@implements IAsyncDisposable
@inject SoftSync.Presentation.Services.CvReviewService Review
@inject CvDocumentExtractionService Reader
@using SoftSync.BLL.Services
@using System.Text.Json
@inject IServiceScopeFactory Scopes
@inject ILogger<CvCareerWorkspace> Logger
@inject AuthenticationStateProvider Authentication

@* Route styles load in App.razor before enhanced navigation inserts this content. *@
@if (busy)
{
    <div class="career-busy-overlay">
        <section class="career-busy-card" role="status" aria-live="polite" aria-atomic="true">
            <div class="career-busy-visual" aria-hidden="true">
                <span class="career-busy-orbit"></span>
                <div class="career-busy-document"><i class="bi bi-file-earmark-person"></i><span></span><span></span><span></span></div>
                <span class="career-busy-scan"></span>
                <i class="bi bi-stars career-busy-spark"></i>
            </div>
            <h2>@T("Đang xử lý", "Working on it")</h2>
            <p>@(string.IsNullOrEmpty(processing) ? T("Đang cập nhật kho CV của bạn…", "Updating your CV workspace…") : processing)</p>
            <div class="career-busy-track" aria-hidden="true"><span></span></div>
            <small>@T("Vui lòng giữ màn hình này trong khi xử lý.", "Please keep this screen open while we work.")</small>
            @if (cancellation is not null)
            {
                <button type="button" class="career-busy-cancel" @onclick="Cancel">@T("Hủy xử lý", "Cancel processing")</button>
            }
        </section>
    </div>
}
<div class="career-cv @(screen == "library" ? "career-library" : "")" inert="@busy" aria-busy="@busy">
@if (!string.IsNullOrEmpty(notice))
{
    <p class="alert alert-success" role="status">@notice</p>
}
@if (screen == "home")
{
    <header class="career-hero"><div><span>SOFTSYNC CAREER</span><h1>Smart CV</h1><p>@T("Quản lý hồ sơ và đánh giá mức độ phù hợp với công việc, nhận gợi ý cải thiện.", "Manage your CVs, explore job fit and get practical feedback.")</p></div><div class="career-illustration" aria-hidden="true"><div><b>CV</b><i></i><i></i><i></i><i></i><i></i></div><span class="bi bi-search"></span></div></header>
    <div class="career-menu">
    @foreach (var item in Menu)
    {
        <button class="career-menu-card @(item.Id == "review" ? "featured" : "")" @onclick="() => Go(item.Id)"><span class="career-icon @item.Id"><i class="bi @item.Icon"></i></span><span><strong>@item.Title</strong><small>@item.Description</small></span><i class="bi bi-chevron-right"></i></button>
    }
    </div>
    <aside class="career-tip"><i class="bi bi-info-circle-fill"></i><div><strong>@T("Mẹo nhỏ", "Quick tip")</strong><p>@T("Hãy mô tả công việc (JD) càng chi tiết để kết quả đánh giá chính xác hơn.", "Add a detailed job description for a more useful assessment.")</p></div></aside>
}
else
{
    <header class="career-top"><button aria-label="@T("Quay lại", "Back")" @onclick='() => Go("home")'><i class="bi bi-chevron-left"></i></button><h1>@ScreenTitle</h1>@if(screen == "library") { <label class="career-primary career-upload" for="career-upload">@T("Tải lên CV", "Upload CV")</label> } else if(screen == "result") { <button class="career-outline" disabled="@(saved || busy)" @onclick="Save">@(saved ? T("Đã lưu", "Saved") : T("Lưu", "Save"))</button> }</header>
    <div class="career-file-input"><InputFile id="career-upload" OnChange="Upload" accept=".pdf,.txt" disabled="@(busy || loadingDocuments)" /></div>
    @if(screen == "library")
    {
        @if (loadingDocuments) { <p class="career-loading" role="status">@T("Đang tải danh sách CV…", "Loading your CV list…")</p> }
        else if (!documentsLoaded) { <button class="career-outline" @onclick="LoadDocuments">@T("Thử tải lại kho CV", "Retry loading CVs")</button> }
        @if (loadingDocumentId is not null) { <p class="career-loading" role="status">@T("Đang mở CV đã chọn…", "Opening the selected CV…")</p> }
        <div class="career-tabs">@foreach(var type in new[]{"all","pdf","txt"}) { <button class="@(filter == type ? "active" : "")" @onclick="() => filter = type">@(type == "all" ? T("Tất cả", "All") : type.ToUpperInvariant()) (@Documents.Count(x => type == "all" || x.Extension == type))</button> }</div>
        <div class="career-search"><i class="bi bi-search"></i><input aria-label="@T("Tìm kiếm CV", "Search CVs")" placeholder="@T("Tìm kiếm CV…", "Search CVs…")" @bind="query" @bind:event="oninput" /></div>
        <div class="career-sort"><select aria-label="@T("Sắp xếp", "Sort")" @bind="sort"><option value="new">@T("Mới nhất", "Newest")</option><option value="old">@T("Cũ nhất", "Oldest")</option></select><span>@T("PDF hoặc TXT · Tối đa 10 MB", "PDF or TXT · Up to 10 MB")</span></div>
        <div class="career-list">
            @foreach (var doc in VisibleDocuments)
            {
                <article class="career-document">
                    <button class="career-doc-main" title="@doc.Name" @onclick="() => Select(doc)">
                        <span class="career-paper" aria-hidden="true"><b>CV</b><i></i><i></i><i></i></span>
                        <span class="career-doc-copy"><strong>@doc.Name</strong></span>
                    </button>
                    <div class="career-doc-footer">
                        <span class="career-meta"><em class="@doc.Extension">@doc.Extension.ToUpperInvariant()</em><span>@doc.At.ToString("dd/MM/yyyy") · @(doc.Size / 1024) KB</span></span>
                        <div class="career-doc-actions">
                            <a class="career-delete career-download" href="@($"/api/cv/documents/{doc.Id}/download")" aria-label="@T("Tải CV gốc", "Download original CV")" title="@T("Tải CV gốc", "Download original CV")"><i class="bi bi-download"></i></a>
                            <button class="career-delete" disabled="@busy" aria-label="@T("Xóa CV", "Delete CV")" title="@T("Xóa CV", "Delete CV")" @onclick="() => Remove(doc)"><i class="bi bi-trash3"></i></button>
                        </div>
                    </div>
                </article>
            }
        </div>
        @if(documentsLoaded && !VisibleDocuments.Any()) { <div class="career-empty"><i class="bi bi-file-earmark-plus"></i><h2>@T("Kho CV của bạn", "Your CV library")</h2><p>@T("Chưa có CV phù hợp. Tải PDF hoặc TXT lên để bắt đầu.", "No matching CVs. Upload a PDF or TXT to get started.")</p><label class="career-primary" for="career-upload">@T("Tải lên CV", "Upload CV")</label></div> }
    }
    else if(screen == "review")
    {
        <div class="career-steps"><span class="active"><b>1</b>@T("Chọn CV", "Choose CV")</span><span class="@(selected is not null ? "active" : "")"><b>2</b>@T("Nhập mô tả công việc", "Add job description")</span><span><b>3</b>@T("Phân tích", "Analyze")</span></div>
        <h2 class="career-step-title"><b>1</b>@T("Chọn CV từ kho", "Choose a CV")</h2>
        <div class="career-card career-selection"><span class="career-paper"><b>CV</b><i></i><i></i><i></i></span><div><strong>@(selected?.Name ?? T("Chưa chọn CV", "No CV selected"))</strong><small>@(selected is null ? T("Tải lên hoặc chọn từ kho của bạn", "Upload or choose from your library") : $"{selected.Size / 1024} KB · {selected.At:dd/MM/yyyy}")</small></div><button class="career-outline" disabled="@busy" @onclick='() => Go("library")'>@T("Thay đổi", "Choose")</button></div>
        <h2 class="career-step-title"><b>2</b>@T("Nhập mô tả công việc (JD)", "Add job description (JD)")</h2>
        <div class="career-card career-jd"><div class="career-tabs"><button class="@(!jdFileMode ? "active" : "")" disabled="@busy" @onclick="() => jdFileMode = false">@T("Dán văn bản", "Paste text")</button><button class="@(jdFileMode ? "active" : "")" disabled="@busy" @onclick="() => jdFileMode = true">@T("Tải file", "Upload file")</button></div>
        @if(jdFileMode) { <InputFile OnChange="UploadJd" accept=".pdf,.txt" disabled="@busy" /><small>@jdFileName</small> } else { <textarea aria-describedby="career-jd-feedback" aria-invalid="@JdTooLong" @bind="jd" @bind:event="oninput" disabled="@busy" aria-label="@T("Mô tả công việc", "Job description")" placeholder="@T("Dán mô tả công việc tại đây…", "Paste the job description here…")"></textarea> }
        <small class="career-count">@jd.Length.ToString("N0") / @SoftSync.Presentation.Services.CvReviewService.MaxJdCharacters.ToString("N0") @T("ký tự", "characters")</small>
        <div id="career-jd-feedback" aria-live="polite">
        @if (JdTooLong)
        {
            <p role="alert">@T("JD vượt quá 20.000 ký tự. Nội dung vẫn được giữ nguyên; chọn Dán văn bản để chỉnh sửa. Giữ yêu cầu bắt buộc, kỹ năng, kinh nghiệm và trách nhiệm; bỏ phần giới thiệu hoặc nội dung lặp trước khi phân tích.", "The JD exceeds 20,000 characters. Your text is retained; select Paste text to edit it. Keep mandatory requirements, skills, experience and responsibilities; remove introductions or repeated content before analyzing.")</p>
        }
        else if (jd.Length > 5_000)
        {
            <p>@T("JD dài có thể cần thêm thời gian phân tích. Toàn bộ nội dung sẽ được gửi để đánh giá.", "A long JD may take more time to analyze. The full text will be sent for review.")</p>
        }
        </div>
        <p>@T("Hoặc chọn mẫu JD phổ biến", "Or start with a job template")</p><div class="career-templates">@foreach(var role in Roles) { <button disabled="@busy" @onclick="() => UseTemplate(role)">@role</button> }</div></div>
        <button class="career-primary career-analyze" disabled="@(busy || selected is null || JdTooLong)" @onclick="Analyze"><i class="bi @(busy ? "bi-hourglass-split" : "bi-stars")"></i>@(busy ? T("Đang phân tích…", "Analyzing…") : T("Phân tích ngay", "Analyze now"))</button>
    }
    else if(screen == "result" && result is not null)
    {
        <div class="career-result-person"><span class="career-paper"><b>CV</b><i></i><i></i><i></i></span><div><strong>@resultName</strong><small>@resultRole</small><small>@T("Phân tích ngày", "Reviewed on") @resultAt.ToString("dd/MM/yyyy")</small></div></div>
        @if (result.OutputLanguage is "vi" or "en")
        {
            <p class="career-footnote">@T("Ngôn ngữ nhận xét: ", "Review language: ")@(result.OutputLanguage == "vi" ? "Tiếng Việt" : "English"). @if (result.OutputLanguage != L.Code) { <span>@T("Phân tích lại bằng ngôn ngữ đang chọn để tạo nhận xét tương ứng.", "Analyze again in your selected language to generate matching feedback.")</span> }</p>
        }
        <div class="career-scores"><article class="career-card"><h2>@T("Chất lượng CV", "CV quality")</h2><div class="career-ring" style="--score:@result.QualityScore"><strong>@result.QualityScore<small>/100</small></strong></div><p>@Text(result.Summary)</p></article><article class="career-card"><h2>@T("Mức phù hợp với JD", "Job fit")</h2><div class="career-ring" style="--score:@(result.JobMatch?.Score ?? 0)"><strong>@(result.JobMatch?.Score?.ToString() ?? "—")<small>/100</small></strong></div><p>@(result.JobMatch is {} match ? Text(match.Summary) : T("Thêm JD để đánh giá mức phù hợp.", "Add a JD to assess job fit."))</p></article></div>
        <div class="career-tabs career-result-tabs">@foreach(var tab in new[]{"overview","details","match","suggestions"}) { <button class="@(resultTab == tab ? "active" : "")" @onclick="() => resultTab = tab">@(tab == "overview" ? T("Tổng quan", "Overview") : tab == "details" ? T("Chi tiết tiêu chí", "Criteria") : tab == "match" ? T("Đối chiếu JD", "JD comparison") : T("Chỉnh sửa", "Edits"))</button> }</div>
        @if(resultTab is "overview" or "details") { <section class="career-card career-criteria"><h2>@T("Điểm theo tiêu chí", "Scores by criterion")</h2>@foreach(var item in result.Criteria) { <div class="career-criterion"><span>@Criterion(item.Id)</span><progress value="@(item.Score ?? 0)" max="100"></progress><b>@item.Score</b></div>@if(resultTab == "details") { <p>@Text(item.Feedback)</p> } }</section> }
        @if(resultTab == "overview") { <div class="career-feedback"><section class="positive"><h2><i class="bi bi-check-circle-fill"></i>@T("Điểm mạnh", "Strengths")</h2><ul>@foreach(var item in result.Strengths) { <li>@Text(item)</li> }</ul></section><section class="improve"><h2><i class="bi bi-exclamation-circle-fill"></i>@T("Việc cần ưu tiên", "Top priorities")</h2><ul>@foreach(var item in result.Improvements.Take(3)) { <li>@Text(item)</li> }</ul></section></div> }
        @if (resultTab == "match")
        {
            <section class="career-card career-match"><h2>@T("Yêu cầu công việc và bằng chứng", "Job requirements and evidence")</h2>
            @if (result.JobMatch is {} jobMatch)
            {
                @if (jobMatch.Requirements.Count > 0)
                {
                    <div class="career-table-scroll"><table><thead><tr><th>@T("Yêu cầu JD", "JD requirement")</th><th>@T("Mức đáp ứng", "Status")</th><th>@T("Trong CV", "CV evidence")</th><th>@T("Đề xuất", "Recommendation")</th></tr></thead><tbody>
                    @foreach (var item in jobMatch.Requirements)
                    {
                        <tr><td>@item.Requirement<small>@Importance(item.Importance)</small></td><td>@MatchStatus(item.Status)</td><td>@(string.IsNullOrEmpty(item.Evidence) ? T("Chưa thể hiện trong CV", "Not evidenced in the CV") : item.Evidence)</td><td>@Text(item.Recommendation)</td></tr>
                    }
                    </tbody></table></div>
                }
                else
                {
                    <h3>@T("Đã thể hiện", "Evidenced")</h3><ul>@foreach(var item in jobMatch.MatchedRequirements) { <li>@Text(item)</li> }</ul>
                    <h3>@T("Cần bổ sung bằng chứng", "Needs evidence")</h3><ul>@foreach(var item in jobMatch.MissingRequirements) { <li>@Text(item)</li> }</ul>
                }
            }
            else { <p>@T("Thêm JD khi phân tích để xem đối chiếu.", "Include a JD when analyzing to see the comparison.")</p> }
            </section>
        }
        @if (resultTab == "suggestions")
        {
            <section class="career-suggestions"><h2>@T("Chỉnh sửa theo mức ưu tiên", "Edits by priority")</h2>
            @foreach (var item in result.Actions)
            {
                <article class="career-rewrite"><strong>@Priority(item.Priority) · @Text(item.Section)</strong>
                @if (!string.IsNullOrEmpty(item.Requirement)) { <p><strong>@T("Yêu cầu JD: ", "JD requirement: ")</strong>@item.Requirement</p> }
                @if (!string.IsNullOrEmpty(item.Evidence)) { <blockquote>@item.Evidence</blockquote> }
                <p>@Text(item.Issue)</p><p><strong>@T("Cách sửa: ", "Action: ")</strong>@Text(item.Action)</p></article>
            }
            @if (result.Actions.Count == 0) { @foreach (var item in result.Improvements) { <article><p>@Text(item)</p></article> } }
            @foreach(var rewrite in result.Rewrites) { <article class="career-rewrite"><strong>@T("Gợi ý viết lại", "Suggested rewrite")</strong>@if(!string.IsNullOrEmpty(rewrite.Requirement)) { <p><strong>@T("Yêu cầu JD: ", "JD requirement: ")</strong>@rewrite.Requirement</p> }<blockquote>@rewrite.Original</blockquote><p>@Text(rewrite.Suggested)</p><small>@Text(rewrite.Reason)</small></article> }
            @if (result.Questions.Count > 0) { <h3>@T("Thông tin bạn cần bổ sung", "Information to add")</h3><ul>@foreach (var question in result.Questions) { <li>@Text(question)</li> }</ul> }
            </section>
        }
        @if (result.ElapsedMilliseconds > 0) { <p class="career-footnote">@T("Thời gian đánh giá AI: ", "AI review time: ") @((result.ElapsedMilliseconds / 1000d).ToString("0.0")) @T("giây", "seconds")</p> }
        <p class="career-footnote">@T("Điểm tham khảo dựa trên văn bản trong CV, không đánh giá hình thức trình bày.", "Scores assess readable CV text and do not evaluate visual design.")</p>
        @if (result.Model is not null && result.JobMatch is not null) { <p class="career-footnote">@T("Điểm JD dựa trên bằng chứng cho từng yêu cầu; yêu cầu bắt buộc có trọng số cao hơn. Đây không phải xác suất được tuyển dụng.", "JD scores reflect evidence for each requirement, with greater weight on mandatory criteria. They are not a hiring probability.")</p> }
    }
    else if(screen == "history")
    {
        @if (loadingHistory) { <p class="career-loading" role="status">@T("Đang tải lịch sử đánh giá…", "Loading review history…")</p> }
        else if (!historyLoaded) { <button class="career-outline" @onclick="LoadHistory">@T("Thử tải lại lịch sử", "Retry loading history")</button> }
        <div class="career-tabs career-history-filters">@foreach(var role in new[]{"all"}.Concat(History.Select(x => x.Role).Distinct())) { <button class="@(historyFilter == role ? "active" : "")" @onclick="() => historyFilter = role">@(role == "all" ? T("Tất cả", "All") : role) (@History.Count(x => role == "all" || x.Role == role))</button> }</div>
        <div class="career-list">@foreach(var entry in History.Where(x => historyFilter == "all" || x.Role == historyFilter).OrderByDescending(x => x.At)) { <button class="career-history career-card" @onclick="() => Open(entry)"><span class="career-paper"><b>CV</b><i></i><i></i><i></i></span><span><strong>@entry.Name</strong><small>@entry.Role · @entry.At.ToString("dd/MM/yyyy")</small><span class="career-badges"><em>CV <b>@entry.Result.QualityScore</b></em>@if(entry.Result.JobMatch?.Score is {} score) { <em>JD <b>@score</b></em> }</span></span><i class="bi bi-chevron-right"></i></button> }</div>
        @if(historyLoaded && History.Count == 0) { <div class="career-empty"><i class="bi bi-clock-history"></i><h2>@T("Chưa có đánh giá đã lưu", "No saved reviews")</h2><p>@T("Kết quả được tự động lưu tại đây sau mỗi lần phân tích thành công.", "Completed CV reviews are saved here automatically.")</p><button class="career-primary" @onclick='() => Go("review")'>@T("Đánh giá CV", "Review CV")</button></div> }
    }
}
@if(error is not null) { <p class="career-error" role="alert">@error</p> }
</div>

@code {
    private string historyFilter = "all", screen = "home", filter = "all", query = "", sort = "new";
    private string jd = "", jdFileName = "", resultTab = "overview", resultName = "", resultRole = "", processing = "";
    private bool busy, jdFileMode, saved;
    private bool documentsLoaded, historyLoaded, loadingDocuments, loadingHistory, disposed;
    private Guid? loadingDocumentId;
    private long selectionVersion;
    private readonly CancellationTokenSource lifetime = new();
    private int userId;
    private Guid resultId, resultDocumentId;
    private string resultJd = "";
    private string? error, notice;
    private CvDocument? selected;
    private CvReviewResult? result;
    private DateTime resultAt;
    private CancellationTokenSource? cancellation;
    private List<CvDocument> Documents = [];
    private List<ReviewEntry> History = [];
    private static readonly string[] Roles = ["Frontend Developer", "Backend Developer", "Data Analyst", "Product Manager", "UI/UX Designer"];
    private string T(string vi, string en) => L.Current == AppLanguage.Vi ? vi : en;
    private string Text(CvReviewText text) => text.ForLanguage(L.Code);
    private bool hasRendered;
    protected override void OnAfterRender(bool firstRender) => hasRendered = true;
    private Task RefreshProcessing() => hasRendered && !disposed ? InvokeAsync(StateHasChanged) : Task.CompletedTask;
    private (string Id, string Icon, string Title, string Description)[] Menu => [
        ("library", "bi-file-earmark-text-fill", T("Kho CV", "CV library"), T("Lưu trữ và quản lý các hồ sơ của bạn.", "Store and manage your application documents.")),
        ("review", "bi-bar-chart-fill", T("Đánh giá CV", "Review CV"), T("So khớp với mô tả công việc, chấm điểm và nhận gợi ý cải thiện.", "Explore job fit, scores and ways to improve.")),
        ("history", "bi-clock-history", T("Lịch sử", "History"), T("Xem lại các lần đánh giá trước đây.", "Revisit your saved reviews."))];
    private string ScreenTitle => screen switch { "library" => T("Kho CV", "CV library"), "review" => T("Đánh giá CV", "Review CV"), "result" => T("Kết quả đánh giá", "Review results"), _ => T("Lịch sử đánh giá", "Review history") };
    private IEnumerable<CvDocument> VisibleDocuments
    {
        get
        {
            var docs = Documents.Where(x => (filter == "all" || x.Extension == filter) && x.Name.Contains(query, StringComparison.OrdinalIgnoreCase));
            return sort == "old" ? docs.OrderBy(x => x.At) : docs.OrderByDescending(x => x.At);
        }
    }
    // Use a short-lived context per operation, rather than sharing a context across the Blazor circuit.
    private async Task<TValue> Store<TValue>(Func<CvWorkspaceService, Task<TValue>> operation)
    {
        await using var scope = Scopes.CreateAsyncScope();
        return await operation(scope.ServiceProvider.GetRequiredService<CvWorkspaceService>());
    }
    private async Task Store(Func<CvWorkspaceService, Task> operation)
    {
        await using var scope = Scopes.CreateAsyncScope();
        await operation(scope.ServiceProvider.GetRequiredService<CvWorkspaceService>());
    }
    protected override async Task OnInitializedAsync()
    {
        var auth = await Authentication.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out userId);
        // Do not query the database during prerender or block the initial interactive circuit.
    }
    private async Task LoadDocuments()
    {
        if (documentsLoaded || loadingDocuments || disposed) return;
        loadingDocuments = true;
        if (screen == "library") error = null;
        try
        {
            Documents = (await Store(s => s.ListDocumentSummariesAsync(userId, lifetime.Token))).Select(ToDocument).ToList();
            documentsLoaded = true;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { if (screen == "library") Failed(ex, T("Không thể tải kho CV. Vui lòng thử lại.", "Unable to load your CV library. Please retry.")); }
        finally { loadingDocuments = false; }
    }
    private async Task LoadHistory()
    {
        if (historyLoaded || loadingHistory || disposed) return;
        loadingHistory = true;
        if (screen == "history") error = null;
        try
        {
            var reviews = await Store(s => s.ListReviewsAsync(userId, lifetime.Token));
            foreach (var review in reviews)
            {
                try
                {
                    if (!History.Any(x => x.Id == review.Id) && JsonSerializer.Deserialize<CvReviewResult>(review.ResultJson) is { } parsed)
                        History.Add(new(review.Id, review.Name, review.Role, review.CreatedAtUtc.AddHours(7), parsed));
                }
                catch (JsonException) { Logger.LogWarning("Could not read saved CV review {ReviewId}", review.Id); }
            }
            historyLoaded = true;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { if (screen == "history") Failed(ex, T("Không thể tải lịch sử. Vui lòng thử lại.", "Unable to load review history. Please retry.")); }
        finally { loadingHistory = false; }
    }
    private static CvDocument ToDocument(SavedCv doc) => new(doc.Id, doc.Name, doc.Extension, doc.Size, doc.CreatedAtUtc.AddHours(7), doc.Text, doc.ExtractionJson);
    private void ReadingProgress(string value)
    {
        processing = value.StartsWith("ocr:", StringComparison.Ordinal)
            ? T("Đang nhận dạng chữ trong bản scan…", "Recognizing text in scanned pages…")
            : T("Đang trích xuất văn bản…", "Extracting document text…");
        _ = RefreshProcessing();
    }
    private string MatchStatus(string value) => value switch { "Met" => T("Đã thể hiện", "Evidenced"), "Partial" => T("Một phần", "Partial"), _ => T("Chưa thể hiện", "Not demonstrated") };
    private string Importance(string value) => value switch { "Required" => T("Bắt buộc", "Required"), "Preferred" => T("Ưu tiên", "Preferred"), _ => T("JD không nêu mức ưu tiên", "Priority not specified") };
    private string Priority(string value) => value switch { "High" => T("Ưu tiên cao", "High priority"), "Medium" => T("Ưu tiên vừa", "Medium priority"), _ => T("Ưu tiên thấp", "Low priority") };
    private void Failed(Exception ex, string message) { Logger.LogWarning("CV workspace operation failed ({FailureType})", ex.GetType().Name); error = message; }
    private async Task Go(string target)
    {
        if (busy || disposed) return;
        selectionVersion++; loadingDocumentId = null;
        screen = target; error = null; notice = null;
        if (target == "library") await LoadDocuments();
        else if (target == "history") await LoadHistory();
    }
    private async Task Select(CvDocument doc)
    {
        if (busy || disposed || loadingDocumentId == doc.Id) return;
        var version = ++selectionVersion;
        loadingDocumentId = doc.Id; error = null;
        try
        {
            var loaded = string.IsNullOrEmpty(doc.Text)
                ? await Store(s => s.GetDocumentAsync(userId, doc.Id, lifetime.Token))
                : new SavedCv(doc.Id, doc.Name, doc.Extension, doc.Size, doc.At.AddHours(-7), doc.Text, doc.ExtractionJson);
            if (version != selectionVersion || disposed) return;
            if (loaded is null) { error = T("CV không còn trong kho. Vui lòng chọn CV khác.", "This CV is no longer available. Please choose another."); return; }
            selected = ToDocument(loaded);
            var index = Documents.FindIndex(x => x.Id == doc.Id);
            if (index >= 0) Documents[index] = selected;
            await Go("review");
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { if (version == selectionVersion) Failed(ex, T("Không thể mở CV. Vui lòng thử lại.", "Unable to open the CV. Please retry.")); }
        finally { if (version == selectionVersion) loadingDocumentId = null; }
    }
    private async Task Remove(CvDocument doc)
    {
        if (busy) return;
        selectionVersion++; loadingDocumentId = null;
        busy = true; error = null; notice = null;
        try
        {
            await Store(s => s.DeleteDocumentAsync(userId, doc.Id));
            Documents.Remove(doc);
            if (selected?.Id == doc.Id) selected = null;
        }
        catch (Exception ex) { Failed(ex, T("Không thể xóa CV. Vui lòng thử lại.", "Unable to delete the CV. Please retry.")); }
        finally { busy = false; }
    }
    private async Task<string> Read(IBrowserFile file, CancellationToken token)
    {
        await using var stream = file.OpenReadStream(CvReviewDocumentReader.MaxFileBytes);
        return (await Reader.ExtractAsync(stream, file.Name, ReadingProgress, token)).Text;
    }
    private async Task Upload(InputFileChangeEventArgs e)
    {
        if (busy) return;
        using var logScope = Logger.BeginScope(new Dictionary<string, object> { ["CvOperationId"] = Guid.NewGuid().ToString("N") });
        selectionVersion++; loadingDocumentId = null;
        busy = true; error = null; notice = null;
        using var token = new CancellationTokenSource(TimeSpan.FromSeconds(120));
        cancellation = token; processing = T("Đang tải và đọc CV…", "Uploading and reading CV…");
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(CvReviewDocumentReader.MaxFileBytes);
            using var buffer = new MemoryStream();
            var stageTimer = System.Diagnostics.Stopwatch.StartNew();
            await stream.CopyToAsync(buffer, token.Token);
            Logger.LogInformation("CV stage upload completed in {ElapsedMilliseconds} ms", stageTimer.ElapsedMilliseconds);
            buffer.Position = 0;
            var extraction = await Reader.ExtractAsync(buffer, file.Name, ReadingProgress, token.Token);
            token.Token.ThrowIfCancellationRequested();
            var metadata = JsonSerializer.Serialize(new ExtractionInfo(extraction.Pages, extraction.ElapsedMilliseconds, extraction.Version));
            stageTimer.Restart();
            var stored = await Store(s => s.AddDocumentAsync(userId, file.Name, Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant(), extraction.Text, buffer.ToArray(), metadata));
            Logger.LogInformation("CV stage document-save completed in {ElapsedMilliseconds} ms", stageTimer.ElapsedMilliseconds);
            var doc = ToDocument(stored);
            Documents.Insert(0, doc);
            selected = doc;
            filter = "all"; query = ""; sort = "new";
            screen = "library";
            notice = T("Đã lưu CV vào kho của bạn.", "CV saved to your library.");
        }
        catch (CvReviewException ex) { error = Text(ex.Feedback); }
        catch (OperationCanceledException) { error = T("Đã dừng đọc CV. Bạn có thể thử lại.", "Reading stopped. You can retry."); }
        catch (Exception ex) { Failed(ex, T("Không thể lưu CV. Chọn PDF/TXT có văn bản, tối đa 10 MB và 40.000 ký tự, rồi thử lại.", "Unable to save your CV. Choose a text-readable PDF/TXT, up to 10 MB and 40,000 characters, and retry.")); }
        finally { busy = false; cancellation = null; processing = ""; }
    }
    private bool JdTooLong => jd.Trim().Length > SoftSync.Presentation.Services.CvReviewService.MaxJdCharacters;
    private async Task UploadJd(InputFileChangeEventArgs e)
    {
        if (busy) return;
        busy = true; error = null; notice = null;
        using var token = new CancellationTokenSource(TimeSpan.FromSeconds(120));
        cancellation = token; processing = T("Đang đọc JD…", "Reading JD…");
        try
        {
            var text = await Read(e.File, token.Token);
            jd = text; jdFileName = e.File.Name;
        }
        catch (CvReviewException ex) { error = Text(ex.Feedback); }
        catch (OperationCanceledException) { error = T("Đã dừng đọc JD.", "Reading the JD stopped."); }
        catch (Exception ex) { Failed(ex, T("Không thể đọc JD.", "Cannot read the JD.")); }
        finally { busy = false; cancellation = null; processing = ""; }
    }
    private void UseTemplate(string role)
    {
        resultRole = role;
        jd = role switch
        {
            "Frontend Developer" => "Frontend Developer: Build responsive web interfaces with HTML, CSS, JavaScript, React and TypeScript. Collaborate with designers, integrate REST APIs, use Git, and write maintainable, accessible code.",
            "Backend Developer" => "Backend Developer: Design and maintain REST APIs, relational databases and secure authentication. Use C# or Python, SQL, Git, automated tests and collaborate with frontend developers.",
            "Data Analyst" => "Data Analyst: Analyze business data with SQL, Excel and Python. Build dashboards, clean datasets, communicate findings and collaborate with stakeholders to define useful metrics.",
            "Product Manager" => "Product Manager: Research user needs, define product requirements, prioritize a roadmap and coordinate design and engineering. Analyze product metrics and communicate clearly with stakeholders.",
            _ => "UI/UX Designer: Research user needs, design wireframes and prototypes in Figma, conduct usability tests, create accessible interfaces and collaborate with product and engineering teams."
        };
        jdFileMode = false;
    }
    private async Task Analyze()
    {
        if (selected is null || busy || JdTooLong) return;
        using var logScope = Logger.BeginScope(new Dictionary<string, object> { ["CvOperationId"] = Guid.NewGuid().ToString("N") });
        busy = true; error = null; notice = null; saved = false;
        // Allow the initial provider request and one validated regeneration (110s each).
        using var token = new CancellationTokenSource(TimeSpan.FromSeconds(240));
        cancellation = token;
        processing = T("Đang đánh giá CV và đối chiếu JD…", "Reviewing CV and comparing the JD…");
        try
        {
            var request = new CvReviewRequest(selected.Text, jd, L.Code);
            var stageTimer = System.Diagnostics.Stopwatch.StartNew();
            SavedCvReview? previous = null;
            processing = T("Đang kiểm tra kết quả đã lưu…", "Checking saved reviews…");
            try
            {
                using var lookupDeadline = CancellationTokenSource.CreateLinkedTokenSource(token.Token);
                lookupDeadline.CancelAfter(TimeSpan.FromSeconds(3));
                previous = await Store(s => s.FindReusableReviewAsync(userId, selected.Id, jd, Review.GetCacheKey(request), lookupDeadline.Token));
                if (previous is not null)
                {
                    var parsed = JsonSerializer.Deserialize<CvReviewResult>(previous.ResultJson);
                    if (parsed is not null && Review.CanReuse(parsed, request)) result = parsed;
                    else previous = null;
                }
            }
            catch (OperationCanceledException) when (!token.IsCancellationRequested)
            {
                previous = null;
                Logger.LogWarning("CV saved-result lookup exceeded its deadline; continuing with analysis");
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex)
            {
                previous = null;
                Logger.LogWarning("CV saved-result lookup unavailable ({FailureType}); continuing with analysis", ex.GetType().Name);
            }
            Logger.LogInformation("CV stage saved-result-lookup completed in {ElapsedMilliseconds} ms; reused {Reused}", stageTimer.ElapsedMilliseconds, previous is not null);
            token.Token.ThrowIfCancellationRequested();
            if (previous is null)
            {
                processing = T("Đang đánh giá CV và đối chiếu JD…", "Reviewing CV and comparing the JD…");
                await RefreshProcessing();
                result = await Review.ReviewAsync(request, token.Token);
            }
            resultName = selected.Name;
            resultDocumentId = selected.Id; resultId = previous?.Id ?? Guid.NewGuid(); resultJd = jd;
            resultRole = string.IsNullOrWhiteSpace(jd) ? T("Đánh giá CV", "CV review") : Roles.FirstOrDefault(x => jd.StartsWith(x, StringComparison.OrdinalIgnoreCase)) ?? T("JD tùy chỉnh", "Custom JD");
            resultAt = (previous?.CreatedAtUtc ?? DateTime.UtcNow).AddHours(7); resultTab = "overview"; screen = "result";
            if (previous is not null)
            {
                saved = true;
                notice = T("Đã mở kết quả đã lưu cho cùng CV, JD và ngôn ngữ; không cần chờ AI phân tích lại.", "Opened your saved review for the same CV, JD and language; no new AI analysis was needed.");
                if (!History.Any(x => x.Id == resultId)) History.Insert(0, new(resultId, resultName, resultRole, resultAt, result!));
                return;
            }
            cancellation = null;
            processing = T("Đang lưu lịch sử đánh giá…", "Saving review history…");
            await RefreshProcessing();
            stageTimer.Restart();
            try { await PersistReview(); }
            catch (Exception ex)
            {
                Failed(ex, T("Đánh giá đã hoàn tất nhưng chưa lưu được lịch sử. Hãy bấm Lưu để thử lại trước khi rời trang.", "Your review is complete, but history could not be saved. Select Save to retry before leaving this page."));
            }
            Logger.LogInformation("CV stage review-save completed in {ElapsedMilliseconds} ms; saved {Saved}", stageTimer.ElapsedMilliseconds, saved);
        }
        catch (CvReviewException ex) { error = Text(ex.Feedback); }
        catch (OperationCanceledException) { error = T("Đã dừng phân tích. Bạn có thể thử lại.", "Analysis stopped. You can try again."); }
        catch (Exception ex) { Failed(ex, T("Chưa thể đánh giá CV. Vui lòng thử lại sau.", "Unable to review this CV. Please try again later.")); }
        finally { busy = false; cancellation = null; processing = ""; }
    }
    private void Cancel() => cancellation?.Cancel();
    private async Task Save()
    {
        if (result is null || saved || busy) return;
        busy = true; error = null; notice = null;
        try
        {
            await PersistReview();
        }
        catch (Exception ex) { Failed(ex, T("Chưa lưu được kết quả. Hãy thử lại; CV gốc cần còn trong kho.", "Unable to save the result. Retry; the original CV must still be in your library.")); }
        finally { busy = false; }
    }
    private async Task PersistReview()
    {
        if (result is null || saved) return;
        await Store(s => s.SaveReviewAsync(userId, new(resultId, resultDocumentId, resultName, resultRole, resultJd.Trim(), JsonSerializer.Serialize(result), resultAt.AddHours(-7))));
        if (!History.Any(entry => entry.Id == resultId))
            History.Insert(0, new(resultId, resultName, resultRole, resultAt, result));
        saved = true;
    }
    private Task Open(ReviewEntry entry)
    {
        if (busy) return Task.CompletedTask;
        result = entry.Result; resultId = entry.Id; resultName = entry.Name; resultRole = entry.Role;
        resultAt = entry.At; resultTab = "overview"; saved = true; return Go("result");
    }
    private string Criterion(string id) => id switch { "content" => T("Nội dung & kinh nghiệm", "Content & experience"), "clarity" => T("Diễn đạt rõ ràng", "Clarity"), "achievements" => T("Thành tích & minh chứng", "Achievements"), _ => T("Cấu trúc nội dung", "Text structure") };
    public ValueTask DisposeAsync() { disposed = true; lifetime.Cancel(); cancellation?.Cancel(); base.Dispose(); return ValueTask.CompletedTask; }
    public sealed record CvDocument(Guid Id, string Name, string Extension, long Size, DateTime At, string Text, string? ExtractionJson = null);
    public sealed record ExtractionInfo(IReadOnlyList<CvExtractionPage> Pages, long ElapsedMilliseconds, int Version);
    public sealed record ReviewEntry(Guid Id, string Name, string Role, DateTime At, CvReviewResult Result);
}
