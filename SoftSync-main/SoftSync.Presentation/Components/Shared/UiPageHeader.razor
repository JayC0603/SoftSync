<header class="ss-page-header">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <span>@Eyebrow</span> }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
    </div>
    @if (Actions is not null) { <div class="ss-page-header-actions">@Actions</div> }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
