@rendermode InteractiveServer
@inherits LocalizedComponentBase

<div id="blazor-error-ui">
    @Ui("An unhandled error has occurred.")
    <a href="" class="reload">@Ui("Reload")</a>
    <button type="button" class="dismiss" aria-label="@Ui("Dismiss error notification")">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
</div>
