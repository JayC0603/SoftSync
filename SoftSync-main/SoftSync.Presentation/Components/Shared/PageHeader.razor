<header class="ss-page-heading"><div>@if(!string.IsNullOrWhiteSpace(Eyebrow)){<p class="ss-eyebrow">@Eyebrow</p>}<h1 id="@HeadingId">@Title</h1>@if(!string.IsNullOrWhiteSpace(Description)){<p>@Description</p>}</div>@ChildContent</header>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? HeadingId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
