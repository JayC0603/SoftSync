@inherits LocalizedComponentBase
@using SoftSync.Common.Dtos
@using SoftSync.Presentation.Components.Journey
@using SoftSync.BLL.Interfaces
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<MobileHome> Logger

<div class="mobile-home">
    <section class="mh-search" aria-label="@T("Tìm kiếm học tập", "Learning search")">
        <div class="mh-search-input"><i class="bi bi-search" aria-hidden="true"></i><input type="search" aria-label="@T("Tìm bài học, kỹ năng, lộ trình", "Search lessons, skills and roadmap")" placeholder="@T("Tìm bài học, kỹ năng, lộ trình…", "Find lessons, skills, roadmap…")" @bind="query" @bind:event="oninput" aria-controls="mh-results" />@if (query.Length > 0) { <button type="button" @onclick="() => query = string.Empty" aria-label="@T("Xóa tìm kiếm", "Clear search")"><i class="bi bi-x-lg" aria-hidden="true"></i></button> }</div>
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <div id="mh-results" class="mh-results" aria-live="polite">
                <p>@T("Tìm trong bài học và lộ trình của bạn", "Searching your lessons and roadmap")</p>
                @foreach (var item in Results)
                {
                    <a href="@(IsLocked(item) ? "/roadmap" : LessonUrl(item))"><i class="bi @(IsLocked(item) ? "bi-lock" : "bi-journal-text")" aria-hidden="true"></i><span><strong>@item.Title</strong><small>@item.SkillName · @T("Bài học", "Lesson")</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
                @if (!Results.Any()) { <p>@T("Không tìm thấy nội dung phù hợp.", "No matching content found.")</p> }
            </div>
        }
    </section>

    <header class="mh-welcome"><div><h1>@T($"Chào mừng trở lại, {Name}!", $"Welcome back, {Name}!") <span aria-hidden="true">👋</span></h1><p>@T("Hôm nay là một ngày tuyệt vời để học thêm điều mới!", "Today is a great day to learn something new!")</p></div><img src="/images/home/welcome.webp" class="mh-welcome-art" alt="" width="110" height="72" /></header>

    <section class="mh-hero" aria-labelledby="mh-hero-title">
        <div class="mh-hero-copy"><span class="mh-badge"><i class="bi bi-play-circle-fill" aria-hidden="true"></i>@(AllDone ? T("Lộ trình hoàn thành", "Roadmap complete") : T("Tiếp tục học tập", "Continue learning"))</span><h2 id="mh-hero-title">@(Current?.Title ?? T("Bắt đầu hành trình của bạn", "Start your journey"))</h2><p>@(Current?.Objective ?? T("Khám phá thế mạnh của bạn và nhận lộ trình học phù hợp.", "Discover your strengths and get a personal learning roadmap."))</p></div>
        <div class="mh-hero-art" aria-hidden="true"><img src="/images/home/syncy-study.webp" alt="" width="220" height="180" fetchpriority="high" /></div>
        @if (Current is not null)
        {
            <div class="mh-progress"><div><span>@Current.CompletedActivityCount/@Current.TotalActivityCount @T("hoạt động", "activities")</span><strong>@Percent%</strong></div><progress value="@Percent" max="100" aria-label="@T("Tiến độ bài học", "Lesson progress")">@Percent%</progress></div>
        }
        <a class="mh-primary" href="@(Current is null ? $"/assessment/{User.Id}" : AllDone ? "/progress" : LessonUrl(Current))"><i class="bi @(AllDone ? "bi-check-circle" : "bi-play-fill")" aria-hidden="true"></i>@(Current is null ? T("Bắt đầu đánh giá", "Start assessment") : AllDone ? T("Xem thành quả", "View achievements") : T("Tiếp tục bài học", "Continue lesson"))<i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    </section>

    <section class="mh-stats" aria-label="@T("Tổng quan học tập", "Learning overview")">
        <a href="/progress"><i class="bi bi-book-fill" aria-hidden="true"></i><strong>@Items.Count(x => x.IsCompleted)</strong><span>@T("Bài học hoàn thành", "Lessons completed")</span></a>
        <a href="/progress"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><strong>@Items.Sum(x => x.CompletedActivityCount)</strong><span>@T("Hoạt động hoàn thành", "Activities completed")</span></a>
        <a href="/progress"><i class="bi bi-star-fill" aria-hidden="true"></i><strong>@User.ExperiencePoints.ToString("N0")</strong><span>@T("XP tích lũy", "Total XP")</span></a>
    </section>

    <section class="mh-roadmap mh-surface"><header><h2><i class="bi bi-map" aria-hidden="true"></i>@T("Lộ trình của bạn", "Your roadmap")</h2><a href="/roadmap">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (Items.Count == 0) { <p>@T("Lộ trình sẽ xuất hiện sau bài đánh giá kỹ năng.", "Your roadmap will appear after your skills assessment.")</p> }
        else if (AllDone) { <p><i class="bi bi-check-circle" aria-hidden="true"></i> @T("Bạn đã hoàn thành lộ trình hiện tại!", "You have completed your current roadmap!")</p><a href="@($"/assessment/{User.Id}")">@T("Đánh giá lại kỹ năng", "Reassess your skills") →</a> }
        else
        {
            <ol>@foreach (var item in Items.Where(x => !x.IsCompleted).Take(2)) {
                <li class="@(IsLocked(item) ? "is-locked" : "is-current")"><a href="@(IsLocked(item) ? "/roadmap" : LessonUrl(item))"><span class="mh-node">@item.WeekNumber</span><span><strong>@item.Title</strong><small>@item.CompletedActivityCount/@item.TotalActivityCount @T("hoạt động", "activities")</small><em>@(IsLocked(item) ? T("Chưa mở khóa", "Locked") : T("Đang học", "Learning"))</em></span><i class="bi @(IsLocked(item) ? "bi-lock" : "bi-chevron-right")" aria-hidden="true"></i></a></li>
            }</ol>
        }
        <img class="mh-mountain" src="/images/home/roadmap.webp" alt="" width="170" height="125" loading="lazy" />
    </section>

    <a href="/assistant" class="mh-syncy"><img src="/images/home/syncy-assistant.webp" alt="" width="90" height="100" loading="lazy" /><span><strong>@T("Hỏi SYNCY", "Ask SYNCY")</strong><small>@T("Trợ lý AI của bạn", "Your AI companion")</small><p>@T("Đặt câu hỏi, nhờ gợi ý lộ trình hoặc giải đáp thắc mắc về kỹ năng, nghề nghiệp nhé!", "Ask questions, get roadmap suggestions or explore skills and career advice!")</p></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>

    <section class="mh-quick mh-surface"><h2>@T("Truy cập nhanh", "Quick access")</h2><div>
        <a href="/progress"><i class="bi bi-bar-chart-fill" aria-hidden="true"></i><strong>@T("Tiến độ", "Progress")</strong><span>@T("Xem quá trình học tập", "Your learning journey")</span></a>
        <a href="/resources"><i class="bi bi-folder-fill" aria-hidden="true"></i><strong>@T("Tài nguyên", "Resources")</strong><span>@T("Tài liệu, mẫu CV, biểu mẫu...", "Guides, CV templates, forms...")</span></a>
        <a href="@($"/assessment/{User.Id}")"><i class="bi bi-clipboard-check-fill" aria-hidden="true"></i><strong>@T("Kiểm tra", "Assessment")</strong><span>@T("Bài kiểm tra kỹ năng", "Skills assessment")</span></a>
        <a href="/community"><i class="bi bi-people-fill" aria-hidden="true"></i><strong>@T("Cộng đồng", "Community")</strong><span>@T("Kết nối và thảo luận", "Connect and discuss")</span></a>
    </div></section>

    <section class="mh-mentors mh-surface" aria-labelledby="mh-mentors-title">
        <header class="mh-section-heading"><h2 id="mh-mentors-title">@T("Đội ngũ cố vấn đồng hành", "Your mentor team")</h2><a href="/mentors">@T("Xem tất cả", "View all") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></header>
        @if (mentorLoading) { <div class="mh-mentor-loading" role="status"><span class="ss-skeleton"></span>@T("Đang tải cố vấn…", "Loading mentors…")</div> }
        else if (mentorFailed) { <p role="status">@T("Chưa thể tải cố vấn.", "Mentors could not be loaded.") <button type="button" class="mh-retry" @onclick="LoadMentorsAsync">@T("Thử lại", "Try again")</button></p> }
        else if (mentors.Count > 0)
        {
            <div class="ss-mentor-carousel-tools"><span>@T("Kéo ngang để xem cố vấn", "Drag to explore mentors")</span><button type="button" onclick="window.ssDesign.scrollMentors(this,-1)" aria-label="@T("Cố vấn trước", "Previous mentor")"><i class="bi bi-chevron-left" aria-hidden="true"></i></button><button type="button" onclick="window.ssDesign.scrollMentors(this,1)" aria-label="@T("Cố vấn tiếp theo", "Next mentor")"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></div>
            <div class="mh-mentor-track ss-mentor-carousel" tabindex="0" aria-label="@T("Danh sách cố vấn, kéo ngang để xem thêm", "Mentors, scroll horizontally to see more")">
            @foreach (var mentor in mentors)
            {
            <article><img src="@mentor.AvatarUrl" alt="@mentor.Name" width="72" height="72" loading="lazy" /><div><h3>@mentor.Name</h3><p>@L.Ui(mentor.Expertise)</p><small>@L.Ui(mentor.ShortBio)</small></div><a class="mh-mentor-detail" href="/mentors/@mentor.Id">@T("Xem chi tiết", "View details") <i class="bi bi-chevron-right" aria-hidden="true"></i></a></article>
            }
            </div>
        }
        else { <p>@T("Chưa có cố vấn khả dụng.", "No mentors are available yet.")</p> }
    </section>

    <section class="mh-motivation mh-surface" aria-labelledby="mh-motivation-title"><h2 id="mh-motivation-title">@T("Tiến bộ mỗi ngày", "A little progress every day")</h2><blockquote><i class="bi bi-quote" aria-hidden="true"></i><div><p>@T("“Mỗi bước nhỏ hôm nay đều tạo nên phiên bản tốt hơn của bạn ngày mai.”", "“Every small step today builds a better version of you tomorrow.”")</p><cite>— SYNCY</cite></div></blockquote><img src="/images/home/syncy-growth.webp" alt="" width="170" height="100" loading="lazy" /></section>
</div>

@code {
    [Parameter, EditorRequired] public UserDto User { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<RoadmapItemDto> Items { get; set; } = [];
    private string query = string.Empty;
    private List<MentorDto> mentors = [];
    private bool mentorLoading = true;
    private bool mentorFailed;
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadMentorsAsync();
    }
    private async Task LoadMentorsAsync()
    {
        if (mentorRequestRunning) return;
        mentorRequestRunning = true;
        mentorLoading = true;
        mentorFailed = false;
        try
        {
            // Keep this query separate from other components sharing the circuit's DbContext.
            await using var scope = ScopeFactory.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<IMentorService>();
            mentors = (await service.GetAllAsync()).OrderBy(x => x.Id).Take(3).ToList();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not load dashboard mentor preview"); mentorFailed = true; }
        finally { mentorLoading = false; mentorRequestRunning = false; }
    }
    private bool mentorRequestRunning;
    private string T(string vi, string en) => L.Current == AppLanguage.Vi ? vi : en;
    private string Name => User.PublicName.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? User.PublicName;
    private RoadmapItemDto? Current => Items.FirstOrDefault(x => !x.IsCompleted) ?? Items.LastOrDefault();
    private bool AllDone => Items.Count > 0 && Items.All(x => x.IsCompleted);
    private int Percent => Math.Clamp(Current?.ProgressPercent ?? 0, 0, 100);
    private bool IsLocked(RoadmapItemDto item) => !item.IsCompleted && item.Id != Current?.Id;
    private string LessonUrl(RoadmapItemDto item) => $"/roadmap/lecture/{User.Id}/{item.Id}?step={JourneyProgress.ResumeStep(item)}";
    private IEnumerable<RoadmapItemDto> Results => Items.Where(x => $"{x.Title} {x.SkillName}".Contains(query.Trim(), StringComparison.CurrentCultureIgnoreCase)).Take(8);
}
