@page "/Account/AccessDenied"
@layout AccountLayout

<PageTitle>Access denied · SoftSync</PageTitle>

<main class="container tw:py-16">
    <section class="alert alert-warning tw:mx-auto tw:max-w-2xl" role="alert" aria-labelledby="access-denied-title">
        <h1 id="access-denied-title" class="tw:text-2xl tw:font-bold">Bạn không có quyền truy cập</h1>
        <p>Tài khoản của bạn chưa có quyền sử dụng khu vực này.</p>
        <a class="btn btn-primary" href="/">Về trang chủ</a>
    </section>
</main>
