@inherits LocalizedComponentBase
@page "/Account/AccessDenied"
@layout AccountLayout

<PageTitle>@Ui.Text("Access denied · SoftSync")</PageTitle>

<main class="container tw:py-16">
    <section class="alert alert-warning tw:mx-auto tw:max-w-2xl" role="alert" aria-labelledby="access-denied-title">
        <h1 id="access-denied-title" class="tw:text-2xl tw:font-bold">@Ui.Text("Bạn không có quyền truy cập")</h1>
        <p>@Ui.Text("Tài khoản của bạn chưa có quyền sử dụng khu vực này.")</p>
        <a class="btn btn-primary" href="/">@Ui.Text("Về trang chủ")</a>
    </section>
</main>
