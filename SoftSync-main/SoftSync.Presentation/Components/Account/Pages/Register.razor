@page "/Account/Register"
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SoftSync.DAL.Entities
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject LocalizationService L

<PageTitle>@L["auth.register.title"]</PageTitle>

<div class="register-heading">
    <span class="register-kicker">SoftSync Secure</span>
    <h2>@L["auth.register.title"]</h2>
    <p>@L["auth.register.subtitle"]</p>
</div>

<StatusMessage Message="@errorMessage" />

<EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger tw:mb-3" role="alert" />

    <div class="login-field tw:mb-3">
        <label for="register-fullname" class="form-label tw:font-medium">@L["profile.fullName"]</label>
        <div class="login-input-wrap"><i class="bi bi-person" aria-hidden="true"></i><InputText id="register-fullname" @bind-Value="Input.FullName" class="form-control form-control-lg" autocomplete="name" placeholder="@L["profile.fullName.placeholder"]" /></div>
        <ValidationMessage For="() => Input.FullName" class="text-danger" />
    </div>
    <div class="login-field tw:mb-3">
        <label for="register-email" class="form-label tw:font-medium">@L["auth.email"]</label>
        <div class="login-input-wrap"><i class="bi bi-envelope" aria-hidden="true"></i><InputText id="register-email" type="email" @bind-Value="Input.Email" class="form-control form-control-lg" autocomplete="email" placeholder="you@example.com" /></div>
        <ValidationMessage For="() => Input.Email" class="text-danger" />
    </div>
    <div class="login-field tw:mb-3">
        <label for="register-password" class="form-label tw:font-medium">@L["auth.password"]</label>
        <div class="login-input-wrap"><i class="bi bi-lock" aria-hidden="true"></i>
            <InputText id="register-password" type="password" @bind-Value="Input.Password" class="form-control form-control-lg" autocomplete="new-password" />
            <button type="button" class="ss-password-visibility" aria-label="@L["redesign.passwordToggle"]" aria-controls="register-password" aria-pressed="false"
                    onclick="window.ssDesign.togglePassword(this)">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <ValidationMessage For="() => Input.Password" class="text-danger" />
    </div>
    <div class="login-field tw:mb-4">
        <label for="register-confirmpassword" class="form-label tw:font-medium">@L["auth.confirmPassword"]</label>
        <div class="login-input-wrap"><i class="bi bi-lock" aria-hidden="true"></i>
            <InputText id="register-confirmpassword" type="password" @bind-Value="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
            <button type="button" class="ss-password-visibility" aria-label="@L["redesign.passwordToggle"]" aria-controls="register-confirmpassword" aria-pressed="false"
                    onclick="window.ssDesign.togglePassword(this)">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
    </div>

    <button type="submit" class="ss-btn-primary login-submit register-submit tw:w-full tw:py-3 tw:text-lg"><span>@L["auth.register.submit"]</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
</EditForm>

<div class="neo-social"><ExternalLoginPicker IsRegistration="true" ButtonLabel="@(L.Current == AppLanguage.Vi ? "Tiếp tục với Google" : "Continue with Google")" /></div>

<div class="register-login tw:text-center tw:mt-4 tw:text-sm">
    @L["auth.haveAccount"] <a href="Account/Login">@L["auth.login.title"]</a>
</div>

<style>
    .register-heading { margin-bottom: 26px; text-align: left; }
    .register-kicker { display: inline-flex; align-items: center; gap: 7px; margin-bottom: 15px; color: #9a93ff; font-size: .7rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
    .register-heading h2 { margin: 0 0 8px; color: #f8fbff; font-size: clamp(1.9rem,4vw,2.35rem); font-weight: 820; letter-spacing: -.04em; }
    .register-heading p { margin: 0; color: #9ba7c5; line-height: 1.55; }
    .register-submit { min-height: 52px; display: flex; align-items: center; justify-content: center; gap: 10px; border-radius: 13px; background: linear-gradient(90deg,#7267ff,#8d7dff 45%,#6f65ff); box-shadow: 0 14px 30px rgba(95,94,255,.25); }
    .register-submit i { transition: transform .18s ease; }
    .register-submit:hover i { transform: translateX(4px); }
    .register-login { padding-top: 20px; color: #939fbc; border-top: 1px solid rgba(143,162,255,.16); }
    .register-login a { color: #9a93ff; font-weight: 700; text-decoration: none; }
    .register-login a:hover { text-decoration: underline; }
    .form-label { color: #dce2f2; font-size: .82rem; font-weight: 700; }
    .form-control { min-height: 50px; color: #f8fbff; border-color: rgba(126,146,255,.22); background: rgba(7,11,24,.56); }
    .form-control:focus { color: #fff; border-color: #8d8cff; background: rgba(9,14,29,.78); box-shadow: 0 0 0 4px rgba(129,140,248,.13); }
    .password-toggle { color: #aab5d4; border-color: rgba(126,146,255,.22); background: rgba(7,11,24,.56); }
    .password-toggle:hover { color: #fff; background: rgba(61,72,117,.3); }
</style>

@code {
    private string? errorMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    public async Task RegisterUser(EditContext editContext)
    {
        var user = new ApplicationUser
        {
            FullName = Input.FullName,
            CreatedAt = DateTime.UtcNow,
            Role = SoftSync.Common.Enums.UserRole.Student
        };

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = (IUserEmailStore<ApplicationUser>)UserStore;
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            errorMessage = "Error: " + string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, SoftSync.BLL.Auth.CourseAuthorization.UserRole);
        if (!roleResult.Succeeded)
        {
            errorMessage = "Error: " + string.Join(" ", roleResult.Errors.Select(e => e.Description));
            return;
        }

        Logger.LogInformation("User created a new account with password.");
        await SignInManager.SignInAsync(user, isPersistent: true);
        WelcomeCookie.Set(HttpContext, user.FullName, isFirstLogin: true);

        // First-time users complete their profile (age/goal) next.
        RedirectManager.RedirectTo("profile-setup");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập họ tên.")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = "";

        [Phone(ErrorMessage = "Số điện thoại không hợp lệ.")]
        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [StringLength(100, ErrorMessage = "Mật khẩu phải từ {2} đến {1} ký tự.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Mật khẩu nhập lại không khớp.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
