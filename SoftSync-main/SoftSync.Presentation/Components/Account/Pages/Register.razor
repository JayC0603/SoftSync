@page "/Account/Register"
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SoftSync.DAL.Entities
@inject UserManager<ApplicationUser> UserManager
@inject EmailRegistrationService Registration
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject LocalizationService L

<PageTitle>@L["auth.register.title"]</PageTitle>

<StatusMessage Message="@errorMessage" />
@if (showAccountRecovery)
{
    <div class="tw:flex tw:gap-4 tw:mb-4" role="navigation" aria-label="@(L.Current == AppLanguage.Vi ? "Khôi phục truy cập" : "Account access")">
        <a href="Account/Login">@L["auth.login.submit"]</a>
        <a href="Account/ForgotPassword">@L["auth.forgot"]</a>
    </div>
}
<RegistrationWelcome>
    <ChildContent>
        <ExternalLoginPicker IsRegistration="true" ButtonLabel="@(L.Current == AppLanguage.Vi ? "Tạo tài khoản với Google" : "Create account with Google")" />
    </ChildContent>
    <Alternative>
        <details class="registration-email" open="@(HttpContext.Request.Method == "POST")">
            <summary>@(L.Current == AppLanguage.Vi ? "Hoặc đăng ký bằng email" : "Or sign up with email")</summary>
<EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger tw:mb-3" role="alert" />

    <div class="login-field tw:mb-3">
        <label for="register-fullname" class="form-label tw:font-medium">@L["profile.fullName"]</label>
        <div class="login-input-wrap"><i class="bi bi-person" aria-hidden="true"></i><InputText id="register-fullname" @bind-Value="Input.FullName" class="form-control form-control-lg" autocomplete="name" placeholder="@(L.Current == AppLanguage.Vi ? "Nhập họ và tên" : "Enter your full name")" /></div>
        <ValidationMessage For="() => Input.FullName" class="text-danger" />
    </div>
    <div class="login-field tw:mb-3">
        <label for="register-email" class="form-label tw:font-medium">@L["auth.email"]</label>
        <div class="login-input-wrap"><i class="bi bi-envelope" aria-hidden="true"></i><InputText id="register-email" type="email" @bind-Value="Input.Email" class="form-control form-control-lg" autocomplete="email" placeholder="you@example.com" /></div>
        <ValidationMessage For="() => Input.Email" class="text-danger" />
    </div>
    <div class="login-field tw:mb-3">
        <label for="register-password" class="form-label tw:font-medium">@L["auth.password"]</label>
        <div class="login-input-wrap"><i class="bi bi-lock" aria-hidden="true"></i>
            <InputText id="register-password" type="password" @bind-Value="Input.Password" class="form-control form-control-lg" autocomplete="new-password" placeholder="@(L.Current == AppLanguage.Vi ? "Tạo mật khẩu" : "Create a password")" />
            <button type="button" class="ss-password-visibility" aria-label="@L["redesign.passwordToggle"]" aria-controls="register-password" aria-pressed="false"
                    onclick="window.ssDesign.togglePassword(this)">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <ValidationMessage For="() => Input.Password" class="text-danger" />
    </div>
    <div class="login-field tw:mb-4">
        <label for="register-confirmpassword" class="form-label tw:font-medium">@(L.Current == AppLanguage.Vi ? "Xác nhận mật khẩu" : "Confirm password")</label>
        <div class="login-input-wrap"><i class="bi bi-lock" aria-hidden="true"></i>
            <InputText id="register-confirmpassword" type="password" @bind-Value="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" placeholder="@(L.Current == AppLanguage.Vi ? "Nhập lại mật khẩu" : "Confirm your password")" />
            <button type="button" class="ss-password-visibility" aria-label="@L["redesign.passwordToggle"]" aria-controls="register-confirmpassword" aria-pressed="false"
                    onclick="window.ssDesign.togglePassword(this)">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
    </div>

    <div class="register-consent">
        <InputCheckbox id="register-consent" @bind-Value="Input.AcceptTerms" class="form-check-input" aria-describedby="register-consent-error" />
        <div><label for="register-consent">@(L.Current == AppLanguage.Vi ? "Tôi đồng ý với" : "I agree to the")</label>
            <button type="button" class="auth-legal-link" onclick="document.getElementById('register-legal-notice').showModal()">@(L.Current == AppLanguage.Vi ? "Điều khoản" : "Terms")</button>
            @(L.Current == AppLanguage.Vi ? "và" : "and")
            <button type="button" class="auth-legal-link" onclick="document.getElementById('register-legal-notice').showModal()">@(L.Current == AppLanguage.Vi ? "Chính sách bảo mật" : "Privacy policy")</button>
        </div>
    </div>
    <div id="register-consent-error"><ValidationMessage For="() => Input.AcceptTerms" class="text-danger" /></div>
    <button type="submit" class="ss-btn-primary login-submit register-submit tw:w-full tw:py-3 tw:text-lg"><span>@L["auth.register.submit"]</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
</EditForm>

<dialog id="register-legal-notice" class="auth-legal-dialog" aria-labelledby="register-legal-title">
    <h3 id="register-legal-title">@(L.Current == AppLanguage.Vi ? "Điều khoản và Chính sách bảo mật" : "Terms and Privacy policy")</h3>
    <p>@(L.Current == AppLanguage.Vi ? "Nội dung chính thức đang được cập nhật." : "The official content is being updated.")</p>
    <form method="dialog"><button type="submit">@(L.Current == AppLanguage.Vi ? "Đóng" : "Close")</button></form>
</dialog>
        </details>
    </Alternative>
</RegistrationWelcome>

@code {
    private string? errorMessage;
    private bool showAccountRecovery;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(Name = "Input")] private InputModel? SuppliedInput { get; set; }
    private InputModel Input => SuppliedInput ??= new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    public async Task RegisterUser(EditContext editContext)
    {
        errorMessage = null;
        showAccountRecovery = false;
        var user = new ApplicationUser
        {
            Email = Input.Email,
            FullName = Input.FullName,
            CreatedAt = DateTime.UtcNow,
            Role = SoftSync.Common.Enums.UserRole.Student
        };

        var result = await Registration.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            showAccountRecovery = result.Errors.Any(e => e.Code == EmailRegistrationService.DuplicateAccount);
            errorMessage = "Error: " + string.Join(" ", result.Errors.Select(e => L.IdentityError(e.Code)));
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, SoftSync.BLL.Auth.CourseAuthorization.UserRole);
        if (!roleResult.Succeeded)
        {
            errorMessage = "Error: " + string.Join(" ", roleResult.Errors.Select(e => e.Description));
            return;
        }

        Logger.LogInformation("User created a new account with password.");
        await SignInManager.SignInAsync(user, isPersistent: true);
        WelcomeCookie.Set(HttpContext, user.FullName, isFirstLogin: true);

        // First-time users complete their profile (age/goal) next.
        RedirectManager.RedirectTo("profile-setup");
    }

    private sealed class InputModel
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "Vui lòng đồng ý với Điều khoản và Chính sách bảo mật / Please accept the Terms and Privacy policy.")]
        public bool AcceptTerms { get; set; }

        [Required(ErrorMessage = "Vui lòng nhập họ tên.")]
        public string FullName { get; set; } = "";

        private string email = "";
        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get => email; set => email = value?.Trim() ?? ""; }

        [Phone(ErrorMessage = "Số điện thoại không hợp lệ.")]
        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [StringLength(100, ErrorMessage = "Mật khẩu phải từ {2} đến {1} ký tự.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Mật khẩu nhập lại không khớp.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
