@page "/Account/Login"
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using SoftSync.DAL.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject LocalizationService L

<PageTitle>@L["auth.login.title"]</PageTitle>

<div class="login-heading">
    <span class="login-kicker"><i class="bi bi-shield-check"></i> SoftSync Secure</span>
    <h2>@L["auth.login.title"]</h2>
    <p>@(L.Current == AppLanguage.Vi ? "Chào mừng bạn quay lại SoftSync." : "Welcome back to SoftSync.")</p>
</div>

<div class="login-card">
@if (Suspended == 1)
{
    <div class="alert alert-warning tw:text-sm" role="alert">@L["settings.suspend.done"]</div>
}
@if (Deleted == 1)
{
    <div class="alert alert-info tw:text-sm" role="alert">@L["settings.delete.done"]</div>
}

<StatusMessage Message="@errorMessage" />
@if (GoogleError == 1)
{
    <div class="alert alert-warning" role="alert">@L["auth.googleCancelled"]</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger tw:mb-3" role="alert" />

    <div class="login-field tw:mb-3">
        <label for="login-identifier" class="form-label tw:font-medium">@L["auth.identifier"]</label>
        <div class="login-input-wrap">
            <i class="bi bi-person"></i>
            <InputText id="login-identifier" @bind-Value="Input.Identifier" class="form-control form-control-lg" autocomplete="username" placeholder="@(L.Current == AppLanguage.Vi ? "you@example.com hoặc +84" : "you@example.com or +84")" />
        </div>
        <ValidationMessage For="() => Input.Identifier" class="text-danger" />
    </div>
    <div class="login-field tw:mb-3">
        <label for="login-password" class="form-label tw:font-medium">@L["auth.password"]</label>
        <div class="login-input-wrap">
            <i class="bi bi-lock"></i>
            <InputText id="login-password" type="password" @bind-Value="Input.Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="@(L.Current == AppLanguage.Vi ? "Nhập mật khẩu của bạn" : "Enter your password")" />
            <button type="button" class="ss-password-visibility" onclick="window.ssDesign.togglePassword(this)" aria-controls="login-password" aria-label="@L["redesign.passwordToggle"]" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
        </div>
        <ValidationMessage For="() => Input.Password" class="text-danger" />
    </div>
    <div class="login-options">
        <div class="form-check">
            <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" id="rememberMe" />
            <label class="form-check-label" for="rememberMe">@L["auth.rememberMe"]</label>
        </div>
        <a href="Account/ForgotPassword">@L["auth.forgot"]</a>
    </div>

    <button type="submit" class="ss-btn-primary login-submit tw:w-full tw:py-3 tw:text-lg"><span>@L["auth.login.submit"]</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
</EditForm>

<div class="neo-social"><ExternalLoginPicker ButtonLabel="@(L.Current == AppLanguage.Vi ? "Tiếp tục với Google" : "Continue with Google")" /></div>

<div class="login-register">
    @L["auth.noAccount"] <a href="Account/Register">@(L.Current == AppLanguage.Vi ? "Đăng ký" : "Sign up")</a>
</div>
</div>


@code {
    private string? errorMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private int Suspended { get; set; }
    [SupplyParameterFromQuery] private int Deleted { get; set; }
    [SupplyParameterFromQuery] private int GoogleError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear any leftover external cookie so the login page starts clean.
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        // Allow logging in with either email or phone number.
        var user = await ResolveUserAsync(Input.Identifier);
        if (user?.UserName is null)
        {
            errorMessage = L["auth.error.invalidLogin"];
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user.UserName, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            WelcomeCookie.Set(HttpContext, user.FullName);
            var isAdmin = await UserManager.IsInRoleAsync(user, SoftSync.BLL.Auth.CourseAuthorization.AdminRole);
            RedirectManager.RedirectTo(isAdmin ? "/admin/dashboard" : SoftSync.BLL.Auth.LocalReturnUrl.Normalize(ReturnUrl));
        }
        else if (result.IsLockedOut)
        {
            errorMessage = L["auth.error.lockedOut"];
        }
        else
        {
            errorMessage = L["auth.error.invalidLogin"];
        }
    }

    private async Task<ApplicationUser?> ResolveUserAsync(string identifier)
    {
        if (identifier.Contains('@'))
            return await UserManager.FindByEmailAsync(identifier);

        var byName = await UserManager.FindByNameAsync(identifier);
        if (byName is not null) return byName;

        // Fall back to phone-number lookup.
        return UserManager.Users.FirstOrDefault(u => u.PhoneNumber == identifier);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email hoặc số điện thoại.")]
        public string Identifier { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}
