@page "/Account/Login"
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using SoftSync.DAL.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject LocalizationService L

<PageTitle>@L["auth.login.title"]</PageTitle>

<div class="login-heading">
    <span class="login-kicker"><i class="bi bi-shield-check"></i> SoftSync Secure</span>
    <h2>@L["auth.login.title"]</h2>
    <p>@L["auth.login.subtitle"]</p>
</div>

@if (Suspended == 1)
{
    <div class="alert alert-warning tw:text-sm" role="alert">@L["settings.suspend.done"]</div>
}
@if (Deleted == 1)
{
    <div class="alert alert-info tw:text-sm" role="alert">@L["settings.delete.done"]</div>
}

<StatusMessage Message="@errorMessage" />
@if (GoogleError == 1)
{
    <div class="alert alert-warning" role="alert">@L["auth.googleCancelled"]</div>
}

<ExternalLoginPicker />

<EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger tw:mb-3" role="alert" />

    <div class="login-field tw:mb-3">
        <label class="form-label tw:font-medium">@L["auth.identifier"]</label>
        <div class="login-input-wrap">
            <i class="bi bi-person"></i>
            <InputText @bind-Value="Input.Identifier" class="form-control form-control-lg" autocomplete="username" placeholder="@L["auth.identifier.placeholder"]" />
        </div>
        <ValidationMessage For="() => Input.Identifier" class="text-danger" />
    </div>
    <div class="login-field tw:mb-3">
        <label class="form-label tw:font-medium">@L["auth.password"]</label>
        <div class="login-input-wrap">
            <i class="bi bi-lock"></i>
            <InputText type="password" @bind-Value="Input.Password" class="form-control form-control-lg" autocomplete="current-password" />
        </div>
        <ValidationMessage For="() => Input.Password" class="text-danger" />
    </div>
    <div class="login-options">
        <div class="form-check">
            <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" id="rememberMe" />
            <label class="form-check-label" for="rememberMe">@L["auth.rememberMe"]</label>
        </div>
        <a href="Account/ForgotPassword">@L["auth.forgot"]</a>
    </div>

    <button type="submit" class="ss-btn-primary login-submit tw:w-full tw:py-3 tw:text-lg"><span>@L["auth.login.submit"]</span><i class="bi bi-arrow-right"></i></button>
</EditForm>

<a class="login-otp" href="Account/LoginWithOtp"><i class="bi bi-chat-dots"></i>@L["auth.loginWithOtp"]</a>

<div class="login-register">
    @L["auth.noAccount"] <a href="Account/Register">@L["auth.register"]</a>
</div>

<style>
    .login-heading { margin-bottom: 30px; }
    .login-kicker { display: inline-flex; align-items: center; gap: 7px; margin-bottom: 17px; color: #9a93ff; font-size: .7rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
    .login-heading h2 { margin: 0 0 9px; color: #f8fbff; font-size: clamp(2rem, 4vw, 2.45rem); font-weight: 820; letter-spacing: -.04em; }
    .login-heading p { margin: 0; color: #9ba7c5; line-height: 1.6; }
    .login-field label { margin-bottom: 8px; color: #dce2f2; font-size: .82rem; font-weight: 700; }
    .login-input-wrap { position: relative; }
    .login-input-wrap > i { position: absolute; z-index: 1; left: 15px; top: 50%; color: #8792b1; transform: translateY(-50%); pointer-events: none; }
    .login-options { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 4px 0 24px; color: #aab5d4; font-size: .86rem; }
    .login-options a, .login-register a { color: #9a93ff; font-weight: 700; text-decoration: none; }
    .login-options a:hover, .login-register a:hover { text-decoration: underline; }
    .login-submit { min-height: 52px; display: flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid rgba(196,201,255,.2); border-radius: 13px; background: linear-gradient(90deg,#7267ff,#8d7dff 45%,#6f65ff); box-shadow: 0 14px 30px rgba(95,94,255,.25), inset 0 1px 0 rgba(255,255,255,.25); }
    .login-submit i { transition: transform .18s ease; }
    .login-submit:hover i { transform: translateX(4px); }
    .login-otp { display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; margin-top: 12px; padding: 12px 16px; border: 1px solid rgba(143,162,255,.22); border-radius: 12px; color: #cbd3e8; font-weight: 650; text-decoration: none; background: rgba(9,14,29,.36); }
    .login-otp:hover { border-color: rgba(154,147,255,.55); color: #fff; background: rgba(61,72,117,.24); }
    .login-register { margin-top: 25px; padding-top: 21px; border-top: 1px solid rgba(143,162,255,.16); text-align: center; color: #939fbc; font-size: .9rem; }
    .form-control { min-height: 52px; padding-left: 44px; color: #f8fbff; border-radius: 12px; border-color: rgba(126,146,255,.22); background: rgba(7,11,24,.56); }
    .form-control::placeholder { color: #707c9b; }
    .form-control:focus { color: #fff; border-color: #8d8cff; background: rgba(9,14,29,.78); box-shadow: 0 0 0 4px rgba(129,140,248,.13); }
    .form-check-input { border-color: rgba(143,162,255,.36); background-color: rgba(7,11,24,.56); }
    .form-check-input:checked { border-color: #7c72ff; background-color: #7469ff; }
    @@media (max-width: 420px) { .login-options { align-items: flex-start; flex-direction: column; gap: 10px; } }
</style>

@code {
    private string? errorMessage;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private int Suspended { get; set; }
    [SupplyParameterFromQuery] private int Deleted { get; set; }
    [SupplyParameterFromQuery] private int GoogleError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear any leftover external cookie so the login page starts clean.
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        // Allow logging in with either email or phone number.
        var user = await ResolveUserAsync(Input.Identifier);
        if (user?.UserName is null)
        {
            errorMessage = L["auth.error.invalidLogin"];
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user.UserName, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            WelcomeCookie.Set(HttpContext, user.FullName);
            RedirectManager.RedirectTo(string.IsNullOrWhiteSpace(ReturnUrl) || ReturnUrl == "/" ? "dashboard" : ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            errorMessage = L["auth.error.lockedOut"];
        }
        else
        {
            errorMessage = L["auth.error.invalidLogin"];
        }
    }

    private async Task<ApplicationUser?> ResolveUserAsync(string identifier)
    {
        if (identifier.Contains('@'))
            return await UserManager.FindByEmailAsync(identifier);

        var byName = await UserManager.FindByNameAsync(identifier);
        if (byName is not null) return byName;

        // Fall back to phone-number lookup.
        return UserManager.Users.FirstOrDefault(u => u.PhoneNumber == identifier);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập email hoặc số điện thoại.")]
        public string Identifier { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}
