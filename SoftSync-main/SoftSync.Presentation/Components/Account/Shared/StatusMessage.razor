@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusClass = DisplayMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase)
        ? "alert-danger" : "alert-success";
    <div class="alert @statusClass tw:mb-4" role="alert">
        @LocalizedMessage
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter] public string? Message { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;
    private string LocalizedMessage => DisplayMessage?.StartsWith("Error: ", StringComparison.OrdinalIgnoreCase) == true
        ? (DesktopText.Current == AppLanguage.Vi ? "Lỗi: " : "Error: ") + DesktopText.Text(DisplayMessage[7..])
        : DesktopText.Text(DisplayMessage);

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];
        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
