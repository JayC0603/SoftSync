@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using SoftSync.DAL.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@if (externalLogins.Length > 0)
{
    <div class="external-divider"><span>@L["auth.or"]</span></div>
    <form class="tw:mt-2" action="Account/PerformExternalLogin" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in externalLogins)
        {
            <button type="submit" class="external-google tw:w-full tw:flex tw:items-center tw:justify-center tw:gap-2"
                    name="provider" value="@provider.Name" title="@provider.DisplayName">
                <i class="bi bi-google"></i> @L["auth.googleSignIn"]
            </button>
        }
    </form>
}

<style>
    .external-divider { display: flex; align-items: center; gap: 12px; margin: 22px 0 16px; color: #7783a2; font-size: .76rem; }
    .external-divider::before, .external-divider::after { content: ""; height: 1px; flex: 1; background: rgba(143,162,255,.16); }
    .external-google { min-height: 50px; padding: 11px 16px; border: 1px solid rgba(143,162,255,.24); border-radius: 12px; color: #e8ecf7; background: rgba(17,22,38,.72); font-weight: 700; transition: border-color .18s ease, background .18s ease, transform .18s ease; }
    .external-google:hover { border-color: rgba(154,147,255,.58); color: #fff; background: rgba(61,72,117,.3); transform: translateY(-1px); }
    .external-google i { color: #fff; }
</style>

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [Inject] private LocalizationService L { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
