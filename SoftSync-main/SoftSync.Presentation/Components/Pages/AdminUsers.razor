@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SoftSync.BLL.Auth.CourseAuthorization.AdminPolicy)]
@using SoftSync.Presentation.Services
@inject IdentityRoleManagementService RoleManagement
@inject AuthenticationStateProvider Auth

<PageTitle>Quản lý Teacher · SoftSync</PageTitle>

<main class="tw:min-h-screen tw:bg-slate-50 tw:px-4 tw:py-10">
    <section class="tw:mx-auto tw:max-w-6xl" aria-labelledby="user-management-title" aria-busy="@busy">
        <header class="tw:mb-6">
            <span class="badge bg-primary">Admin</span>
            <h1 id="user-management-title" class="tw:mt-2 tw:text-3xl tw:font-bold">Quản lý tài khoản Teacher</h1>
            <p>Chỉ thay đổi membership của role <code>Teacher</code>. Ownership Course/Quiz hiện tại không bị thay đổi.</p>
        </header>

        <div aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert @(error ? "alert-danger" : "alert-success")" role="@(error ? "alert" : "status")">@message</div>
            }
        </div>

        @if (busy && users.Count == 0)
        {
            <p role="status">Đang tải danh sách người dùng...</p>
        }
        else
        {
            <div class="table-responsive ss-glass tw:rounded-2xl tw:p-4">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">Danh sách người dùng và quyền Teacher</caption>
                    <thead><tr><th scope="col">Người dùng</th><th scope="col">Email</th><th scope="col">Roles</th><th scope="col">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <th scope="row">@(string.IsNullOrWhiteSpace(user.DisplayName) ? $"User #{user.Id}" : user.DisplayName)</th>
                            <td>@user.Email</td>
                            <td><span class="visually-hidden">Roles: </span>@RoleText(user)</td>
                            <td>
                                @if (user.IsAdmin || user.Id == adminUserId)
                                {
                                    <span class="text-muted">Được bảo vệ</span>
                                }
                                else if (user.IsTeacher)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => ChangeTeacher(user.Id, false)">Gỡ Teacher</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => ChangeTeacher(user.Id, true)">Gán Teacher</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>

@code {
    private int adminUserId;
    private bool busy = true;
    private bool error;
    private string message = string.Empty;
    private IReadOnlyList<ManagedUserRoleDto> users = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        adminUserId = state.User.GetUserId();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        busy = true;
        users = await RoleManagement.GetUsersAsync();
        busy = false;
    }

    private async Task ChangeTeacher(int userId, bool assign)
    {
        if (busy) return;
        busy = true;
        var result = assign
            ? await RoleManagement.AssignTeacherAsync(userId)
            : await RoleManagement.RemoveTeacherAsync(userId);
        error = !result.Succeeded;
        message = result.Succeeded
            ? assign ? "Đã gán role Teacher." : "Đã gỡ role Teacher; tài khoản vẫn giữ role User."
            : string.Join(" ", result.Errors.Select(x => x.Description));
        users = await RoleManagement.GetUsersAsync();
        busy = false;
    }

    private static string RoleText(ManagedUserRoleDto user) =>
        string.Join(", ", new[] { user.IsUser ? "User" : null, user.IsTeacher ? "Teacher" : null, user.IsAdmin ? "Admin" : null }.Where(x => x is not null));
}
