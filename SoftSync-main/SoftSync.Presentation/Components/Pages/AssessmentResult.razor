@page "/assessment-result/{UserId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits LocalizedComponentBase
@using SoftSync.BLL.Interfaces
@using SoftSync.Common
@using SoftSync.Common.Dtos
@using SoftSync.Common.Enums
@inject IAssessmentService AssessmentService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="max-800 mx-auto">
    @if (results is not null)
    {
        <StepIndicator CurrentStep="@TotalQuestionCount" TotalSteps="@TotalQuestionCount" IsComplete="true" />
    }

    <div class="tw:text-center tw:mb-12">
        <h2 class="tw:font-bold">@L["result.title.prefix"] <span class="ss-gradient-text">@L["result.title.highlight"]</span></h2>
        <p class="text-muted">@L["result.subtitle"]</p>
    </div>

    @if (results == null)
    {
        <div class="tw:text-center tw:py-12">@L["result.loading"]</div>
    }
    else
    {
        <div class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2 tw:gap-6 tw:mb-12">
            @foreach (var res in results)
            {
                <article aria-labelledby="skill-result-@res.SkillId">
                    <div class="ss-card ss-glass-interactive tw:p-6">
                        <div class="tw:flex tw:justify-between tw:items-center tw:mb-2">
                            <h3 id="skill-result-@res.SkillId" class="tw:font-bold tw:mb-0 tw:text-xl">@SkillName(res)</h3>
                            <span class="badge @GetLevelBadgeClass(res.Level)">@LevelLabel(res.Level)</span>
                        </div>
                        <div class="tw:flex tw:justify-between tw:text-sm text-muted tw:mb-1">
                            <span>@L["result.questionsCompleted"]</span>
                            <span>@AssessmentScoring.QuestionsPerSkill @L["result.questions"]</span>
                        </div>
                        <div class="tw:flex tw:justify-between tw:items-center tw:text-sm tw:mb-2">
                            <span class="text-muted">@L["result.score"]: @res.Score / @AssessmentScoring.MaxScore</span>
                            <strong class="performance-label">@PerformanceLabel(res.Level)</strong>
                        </div>
                        <div class="progress tw:mb-4" style="height: 12px; border-radius: 6px;" role="progressbar"
                             aria-label="@($"{SkillName(res)}: {res.Score}/{AssessmentScoring.MaxScore}")"
                             aria-valuemin="@AssessmentScoring.MinScore" aria-valuemax="@AssessmentScoring.MaxScore" aria-valuenow="@res.Score">
                            <div class="progress-bar" style="width: @(ScorePercent(res.Score))%; background: var(--gradient);"></div>
                        </div>
                        <p class="tw:text-sm text-muted">@LevelDescription(res.SkillId, res.Level)</p>
                        @{ var diagnosis = Diagnosis(res); }
                        <section class="diagnosis-section" aria-label="@Tx("Learning diagnosis", "Chẩn đoán học tập")">
                            <h4>@Tx("Strengths", "Điểm mạnh")</h4>
                            <ul>@foreach (var item in diagnosis.Strengths) { <li>@item</li> }</ul>
                            <h4>@Tx("Growth areas", "Điểm cần cải thiện")</h4>
                            <ul>@foreach (var item in diagnosis.Weaknesses) { <li>@item</li> }</ul>
                            <h4>@Tx("Evidence", "Bằng chứng")</h4>
                            <ul>@foreach (var item in diagnosis.Evidence) { <li>@item</li> }</ul>
                            <p><strong>@Tx("Interpretation:", "Diễn giải:")</strong> @diagnosis.Feedback</p>
                            <h4>@Tx("Next actions", "Hành động tiếp theo")</h4>
                            <ol>@foreach (var item in diagnosis.RecommendedActions) { <li>@item</li> }</ol>
                        </section>
                    </div>
                </article>
            }
        </div>

        <div class="ss-card tw:p-12 tw:text-center tw:mb-12" style="background: var(--gradient-soft);">
            <h2 class="tw:font-bold tw:mb-4">@Tx("Your next learning step", "Bước học tiếp theo")</h2>
            <p class="tw:text-xl tw:mb-6">@OverallRecommendation()</p>
            <button class="ss-btn-primary tw:px-12 tw:py-4 tw:text-xl" @onclick="GoToRoadmap">
                @L["result.viewRoadmap"] <i class="bi bi-calendar-check tw:ms-2"></i>
            </button>
            <button class="btn btn-outline-primary tw:ms-3 tw:px-8 tw:py-4" @onclick="RetakeAssessment">
                @Tx("Take another assessment", "Làm lại bài đánh giá")
            </button>
        </div>

        @if (history.Count > 1)
        {
            <section class="ss-card tw:p-6 tw:mb-12" aria-labelledby="assessment-history-title">
                <h2 id="assessment-history-title" class="tw:text-xl tw:font-bold">@Tx("Assessment history", "Lịch sử đánh giá")</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th scope="col">@Tx("Completed", "Hoàn thành")</th><th scope="col">@Tx("Skills", "Kỹ năng")</th><th scope="col">@Tx("Score range", "Khoảng điểm")</th></tr></thead>
                        <tbody>
                        @foreach (var attempt in history.Skip(1))
                        {
                            <tr><td>@attempt.CompletedAt.ToLocalTime().ToString("g")</td><td>@attempt.Results.Count</td><td>@attempt.Results.Min(x => x.Score)–@attempt.Results.Max(x => x.Score) / @AssessmentScoring.MaxScore</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public int UserId { get; set; }
    private IEnumerable<AssessmentResultDto>? results;
    private IReadOnlyList<AssessmentAttemptDto> history = [];
    private int TotalQuestionCount => (results?.Count() ?? 0) * AssessmentScoring.QuestionsPerSkill;

    protected override async Task OnInitializedAsync()
    {
        var signedInUserId = await AuthProvider.GetUserIdAsync();
        if (signedInUserId <= 0)
        {
            Nav.NavigateTo("Account/Login", forceLoad: true);
            return;
        }

        if (UserId <= 0 || UserId != signedInUserId)
            UserId = signedInUserId;

        results = await AssessmentService.GetLatestResultsAsync(signedInUserId, UserId);
        history = await AssessmentService.GetHistoryAsync(signedInUserId, UserId);
    }

    private static int ScorePercent(int score)
    {
        var clamped = Math.Clamp(score, 0, AssessmentScoring.MaxScore);
        return (int)Math.Round(clamped * 100.0 / AssessmentScoring.MaxScore);
    }

    private string LevelLabel(AssessmentLevel level) => L[$"result.level.{LevelKey(level)}"];

    private string PerformanceLabel(AssessmentLevel level) => L[$"result.performance.{LevelKey(level)}"];

    private string SkillName(AssessmentResultDto result) => result.SkillId is >= 1 and <= 7
        ? L[$"skill.name.{result.SkillId}"]
        : result.SkillName;

    private string LevelDescription(int skillId, AssessmentLevel level)
    {
        var skillKey = skillId switch
        {
            1 => "communication",
            3 => "timemanagement",
            4 => "criticalthinking",
            _ => string.Empty
        };
        var key = $"result.desc.{skillKey}.{LevelKey(level)}";
        var description = L[key];

        return description == key
            ? L[level >= AssessmentLevel.Proactive ? "result.feedback.high" : "result.feedback.low"]
            : description;
    }

    private static string LevelKey(AssessmentLevel level) => level.ToString().ToLowerInvariant();

    private bool IsVi => L.Current == SoftSync.Presentation.Services.AppLanguage.Vi;
    private string Tx(string en, string vi) => IsVi ? vi : en;
    private AssessmentDiagnosisTextDto Diagnosis(AssessmentResultDto result) => IsVi ? result.Diagnosis.Vietnamese : result.Diagnosis.English;

    private string OverallRecommendation()
    {
        var weakest = results?.OrderBy(result => result.Score).FirstOrDefault();
        return weakest is null
            ? Tx("Complete an assessment to receive a recommendation.", "Hoàn thành bài đánh giá để nhận đề xuất.")
            : Tx($"Prioritize {SkillName(weakest)} and begin with the first recommended action above.", $"Ưu tiên {SkillName(weakest)} và bắt đầu với hành động được đề xuất đầu tiên ở trên.");
    }

    private string GetLevelBadgeClass(AssessmentLevel level) => level switch
    {
        AssessmentLevel.Mastery => "bg-success",
        AssessmentLevel.Proactive => "bg-primary",
        AssessmentLevel.Developing => "bg-warning",
        _ => "bg-danger"
    };

    private void GoToRoadmap() => Nav.NavigateTo($"/roadmap/{UserId}");
    private void RetakeAssessment() => Nav.NavigateTo($"/assessment/{UserId}?retake=true");
}

<style>
    .max-800 { max-width: 800px; }
    .performance-label { color: var(--primary); }
    .diagnosis-section { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(99,102,241,.18); }
    .diagnosis-section h4 { margin: .8rem 0 .35rem; font-size: .9rem; font-weight: 800; }
    .diagnosis-section ul, .diagnosis-section ol { margin: 0; padding-left: 1.25rem; color: var(--text-muted); font-size: .88rem; }
    .diagnosis-section p { margin: .85rem 0 0; font-size: .88rem; }
</style>
