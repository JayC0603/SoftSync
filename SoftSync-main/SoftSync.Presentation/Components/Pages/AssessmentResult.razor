@page "/assessment-result/{UserId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits LocalizedComponentBase
@using SoftSync.BLL.Interfaces
@using SoftSync.Common
@using SoftSync.Common.Dtos
@using SoftSync.Common.Enums
@inject IAssessmentService AssessmentService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="max-800 mx-auto assessment-result-page">
    @if (results is not null)
    {
        <div class="result-completion"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @TotalQuestionCount / @TotalQuestionCount @L["result.questionsCompleted"]</div>
    }

    <div class="result-heading tw:text-center">
        <h2 class="tw:font-bold">@L["result.title.prefix"] <span class="ss-gradient-text">@L["result.title.highlight"]</span></h2>
        <p class="text-muted">@L["result.subtitle"]</p>
    </div>

    @if (results == null)
    {
        <div class="tw:text-center tw:py-12">@L["result.loading"]</div>
    }
    else
    {
        <div class="result-grid tw:grid tw:grid-cols-1 tw:md:grid-cols-2">
            @foreach (var res in results)
            {
                <article aria-labelledby="skill-result-@res.SkillId">
                    <div class="ss-card result-skill-card">
                        <div class="tw:flex tw:justify-between tw:items-center tw:mb-2">
                            <h3 id="skill-result-@res.SkillId" class="tw:font-bold tw:mb-0 tw:text-xl">@SkillName(res)</h3>
                            <span class="badge @GetLevelBadgeClass(res.Level)">@LevelLabel(res.Level)</span>
                        </div>
                        <div class="result-score-row">
                            <span><strong>@res.Score</strong> / @AssessmentScoring.MaxScore</span>
                            <span>@AssessmentScoring.QuestionsPerSkill @L["result.questions"]</span>
                        </div>
                        <div class="progress tw:mb-4" style="height: 12px; border-radius: 6px;" role="progressbar"
                             aria-label="@($"{SkillName(res)}: {res.Score}/{AssessmentScoring.MaxScore}")"
                             aria-valuemin="@AssessmentScoring.MinScore" aria-valuemax="@AssessmentScoring.MaxScore" aria-valuenow="@res.Score">
                            <div class="progress-bar" style="width: @(ScorePercent(res.Score))%; background: var(--gradient);"></div>
                        </div>
                        <p class="result-description text-muted">@LevelDescription(res.SkillId, res.Level)</p>
                        @{ var diagnosis = Diagnosis(res); }
                        <section class="diagnosis-section" aria-label="@Tx("Learning diagnosis", "Chẩn đoán học tập")">
                            <details class="result-detail">
                            <summary>@Tx("Strengths", "Điểm mạnh") <span>@diagnosis.Strengths.Count()</span></summary>
                            <ul>@foreach (var item in diagnosis.Strengths) { <li>@item</li> }</ul>
                            </details>
                            <details class="result-detail">
                            <summary>@Tx("Growth areas", "Điểm cần cải thiện") <span>@diagnosis.Weaknesses.Count()</span></summary>
                            <ul>@foreach (var item in diagnosis.Weaknesses) { <li>@item</li> }</ul>
                            </details>
                            <details class="result-detail">
                            <summary>@Tx("Evidence & interpretation", "Bằng chứng và diễn giải")</summary>
                            <ul>@foreach (var item in diagnosis.Evidence) { <li>@item</li> }</ul>
                            <p><strong>@Tx("Interpretation:", "Diễn giải:")</strong> @diagnosis.Feedback</p>
                            </details>
                            <details class="result-detail">
                            <summary>@Tx("Next actions", "Hành động tiếp theo") <span>@diagnosis.RecommendedActions.Count()</span></summary>
                            <ol>@foreach (var item in diagnosis.RecommendedActions) { <li>@item</li> }</ol>
                            </details>
                        </section>
                    </div>
                </article>
            }
        </div>

        <div class="ss-card result-next-step tw:text-center">
            <h2 class="tw:font-bold tw:mb-4">@Tx("Your next learning step", "Bước học tiếp theo")</h2>
            <p class="tw:text-xl tw:mb-6">@OverallRecommendation()</p>
            <div class="result-buttons">
            <button class="ss-btn-primary" @onclick="GoToRoadmap">
                @L["result.viewRoadmap"] <i class="bi bi-calendar-check tw:ms-2"></i>
            </button>
            <button class="btn btn-outline-primary" @onclick="RetakeAssessment">
                @Tx("Take another assessment", "Làm lại bài đánh giá")
            </button>
            </div>
        </div>

        @if (history.Count > 1)
        {
            <section class="ss-card tw:p-6 tw:mb-12" aria-labelledby="assessment-history-title">
                <h2 id="assessment-history-title" class="tw:text-xl tw:font-bold">@Tx("Assessment history", "Lịch sử đánh giá")</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th scope="col">@Tx("Completed", "Hoàn thành")</th><th scope="col">@Tx("Skills", "Kỹ năng")</th><th scope="col">@Tx("Score range", "Khoảng điểm")</th></tr></thead>
                        <tbody>
                        @foreach (var attempt in history.Skip(1))
                        {
                            <tr><td>@attempt.CompletedAt.ToLocalTime().ToString("g")</td><td>@attempt.Results.Count</td><td>@attempt.Results.Min(x => x.Score)–@attempt.Results.Max(x => x.Score) / @AssessmentScoring.MaxScore</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public int UserId { get; set; }
    private IEnumerable<AssessmentResultDto>? results;
    private IReadOnlyList<AssessmentAttemptDto> history = [];
    private int TotalQuestionCount => (results?.Count() ?? 0) * AssessmentScoring.QuestionsPerSkill;

    protected override async Task OnInitializedAsync()
    {
        var signedInUserId = await AuthProvider.GetUserIdAsync();
        if (signedInUserId <= 0)
        {
            Nav.NavigateTo("Account/Login", forceLoad: true);
            return;
        }

        if (UserId <= 0 || UserId != signedInUserId)
            UserId = signedInUserId;

        results = await AssessmentService.GetLatestResultsAsync(signedInUserId, UserId);
        history = await AssessmentService.GetHistoryAsync(signedInUserId, UserId);
    }

    private static int ScorePercent(int score)
    {
        var clamped = Math.Clamp(score, 0, AssessmentScoring.MaxScore);
        return (int)Math.Round(clamped * 100.0 / AssessmentScoring.MaxScore);
    }

    private string LevelLabel(AssessmentLevel level) => L[$"result.level.{LevelKey(level)}"];

    private string SkillName(AssessmentResultDto result) => result.SkillId is >= 1 and <= 7
        ? L[$"skill.name.{result.SkillId}"]
        : result.SkillName;

    private string LevelDescription(int skillId, AssessmentLevel level)
    {
        var skillKey = skillId switch
        {
            1 => "communication",
            3 => "timemanagement",
            4 => "criticalthinking",
            _ => string.Empty
        };
        var key = $"result.desc.{skillKey}.{LevelKey(level)}";
        var description = L[key];

        return description == key
            ? L[level >= AssessmentLevel.Proactive ? "result.feedback.high" : "result.feedback.low"]
            : description;
    }

    private static string LevelKey(AssessmentLevel level) => level.ToString().ToLowerInvariant();

    private bool IsVi => L.Current == SoftSync.Presentation.Services.AppLanguage.Vi;
    private string Tx(string en, string vi) => IsVi ? vi : en;
    private AssessmentDiagnosisTextDto Diagnosis(AssessmentResultDto result) => IsVi ? result.Diagnosis.Vietnamese : result.Diagnosis.English;

    private string OverallRecommendation()
    {
        var weakest = results?.OrderBy(result => result.Score).FirstOrDefault();
        return weakest is null
            ? Tx("Complete an assessment to receive a recommendation.", "Hoàn thành bài đánh giá để nhận đề xuất.")
            : Tx($"Prioritize {SkillName(weakest)} and begin with the first recommended action above.", $"Ưu tiên {SkillName(weakest)} và bắt đầu với hành động được đề xuất đầu tiên ở trên.");
    }

    private string GetLevelBadgeClass(AssessmentLevel level) => level switch
    {
        AssessmentLevel.Mastery => "bg-success",
        AssessmentLevel.Proactive => "bg-primary",
        AssessmentLevel.Developing => "bg-warning",
        _ => "bg-danger"
    };

    private void GoToRoadmap() => Nav.NavigateTo($"/roadmap/{UserId}");
    private void RetakeAssessment() => Nav.NavigateTo($"/assessment/{UserId}?retake=true");
}

<style>
    .assessment-result-page {
        max-width: 800px;
        --ss-primary: #1671d9;
        --ss-primary-hover: #1057b2;
        --gradient: linear-gradient(90deg, #2588ed, #155fc8);
    }
    .result-completion {
        display: flex; justify-content: center; align-items: center; gap: 7px;
        margin-bottom: 12px; color: #1671d9; font-size: .8rem; font-weight: 650;
    }
    .result-heading { margin-bottom: 20px; }
    .assessment-result-page .result-heading h2 { font-size: 1.4rem; margin: 0 0 6px; }
    .result-heading .ss-gradient-text { color: #1671d9; background: none; -webkit-text-fill-color: currentColor; }
    .assessment-result-page .result-heading p { font-size: .875rem; margin: 0; }
    .result-grid { gap: 14px; margin-bottom: 16px; align-items: start; }
    .assessment-result-page .result-skill-card { padding: 18px !important; border-radius: 18px !important; }
    .result-skill-card h3 { min-width: 0; font-size: 1.05rem !important; }
    .result-skill-card .badge { flex-shrink: 0; margin-left: 8px; }
    .result-score-row { display: flex; align-items: baseline; justify-content: space-between; margin: 12px 0 8px; color: var(--text-muted); font-size: .8rem; }
    .result-score-row strong { color: #1671d9; font-size: 1.75rem; line-height: 1; }
    .assessment-result-page .result-skill-card .progress { height: 6px !important; margin-bottom: 12px !important; }
    .assessment-result-page .result-description { margin: 0; font-size: .85rem; line-height: 1.55; }
    .diagnosis-section { margin-top: 14px; border-top: 1px solid #bedbf455; }
    .result-detail { border-bottom: 1px solid #bedbf455; }
    .result-detail:last-child { border-bottom: 0; }
    .result-detail summary {
        padding: 12px 0; min-height: 44px; cursor: pointer;
        color: var(--text); font-size: .85rem; font-weight: 650;
    }
    .result-detail summary::marker { color: #1671d9; }
    .result-detail summary span { margin-left: 6px; color: #1671d9; font-size: .75rem; }
    .result-detail summary:focus-visible { outline: 2px solid #1671d9; outline-offset: 2px; border-radius: 4px; }
    .result-detail[open] summary { color: #1671d9; }
    .diagnosis-section ul, .diagnosis-section ol { margin: 0 0 12px; padding-left: 1.25rem; color: var(--text-muted); font-size: .85rem; line-height: 1.55; }
    .diagnosis-section li + li { margin-top: 6px; }
    .diagnosis-section p { margin: 0 0 12px; font-size: .85rem; line-height: 1.55; }
    .assessment-result-page .result-next-step { padding: 20px !important; margin-bottom: 20px; background: #eaf5ff; border-radius: 18px !important; }
    .assessment-result-page .result-next-step h2 { font-size: 1.05rem; margin-bottom: 8px !important; }
    .assessment-result-page .result-next-step p { font-size: .875rem; line-height: 1.5; margin-bottom: 16px !important; }
    .result-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .result-buttons button { min-height: 44px; padding: 10px 18px; font-size: .875rem; border-radius: 12px; }
    body .ss-main-content .assessment-result-page .result-buttons button {
        color: #fff !important;
        border: 1px solid #1671d9 !important;
        background: #1671d9 !important;
    }
    body .ss-main-content .assessment-result-page .result-buttons button:hover:not(:disabled) {
        background: #1057b2 !important;
        border-color: #1057b2 !important;
    }
    .result-buttons button:focus-visible { outline: 3px solid #8cc9ff; outline-offset: 3px; }
    html[data-theme="dark"] .assessment-result-page .result-next-step { background: #173854; }
    html[data-theme="dark"] .assessment-result-page :is(.result-completion, .result-score-row strong, .result-detail[open] summary, .result-detail summary span) { color: #8cc9ff; }
    @@media (max-width: 900px) {
        body .page:has(.assessment-result-page) main#main-content.ss-main-content { padding: 16px 14px !important; }
        .result-grid { grid-template-columns: 1fr; }
        .assessment-result-page .result-skill-card { padding: 16px !important; }
        .result-buttons { flex-direction: column; }
        .result-buttons button { width: 100%; margin: 0; }
    }
</style>
