@page "/community"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@using SoftSync.Common.Enums
@inject ISkillService SkillService

<PageTitle>@Tx("Learning community", "Cộng đồng học tập") · SoftSync</PageTitle>
<main class="eco-page community-page" aria-labelledby="community-title">
    <header class="eco-page-head eco-page-head-compact"><span>@Tx("LEARN TOGETHER", "HỌC CÙNG NHAU")</span><h1 id="community-title">@Tx("A community organised around practice", "Cộng đồng được tổ chức quanh việc thực hành")</h1><p>@Tx("Find a skill group and useful learning channels without losing your place in the roadmap.", "Tìm nhóm kỹ năng và kênh học hữu ích mà không mất vị trí trong lộ trình.")</p></header>
    <section class="community-feature" aria-labelledby="activity-title"><div><span>@Tx("THIS WEEK", "TUẦN NÀY")</span><h2 id="activity-title">@Tx("Continue your current Practice before joining a group", "Hoàn thành Practice hiện tại trước khi tham gia nhóm")</h2><p>@Tx("Bring one concrete question or situation. Focused context makes peer and mentor support more useful.", "Mang theo một câu hỏi hoặc tình huống cụ thể. Ngữ cảnh tập trung giúp hỗ trợ từ bạn học và Mentor hữu ích hơn.")</p></div><a class="eco-primary" href="/roadmap">@Tx("Continue learning", "Tiếp tục học")<i class="bi bi-arrow-right" aria-hidden="true"></i></a></section>
    <section class="community-section" aria-labelledby="groups-title"><div class="eco-section-title"><div><span>@Tx("SKILL GROUPS", "NHÓM KỸ NĂNG")</span><h2 id="groups-title">@Tx("Start with what you are learning", "Bắt đầu từ kỹ năng bạn đang học")</h2></div></div>
        @if(loading){<div class="eco-state" role="status"><span class="spinner-border" aria-hidden="true"></span><p>@Tx("Loading skill groups...", "Đang tải nhóm kỹ năng...")</p></div>}
        else if(skills.Count==0){<div class="eco-state"><i class="bi bi-people" aria-hidden="true"></i><h3>@Tx("No skill groups are available yet", "Chưa có nhóm kỹ năng khả dụng")</h3><p>@Tx("Complete your skill selection first.", "Hãy hoàn tất lựa chọn kỹ năng trước.")</p></div>}
        else{<div class="community-groups">@foreach(var skill in skills){<a href="/community/skills/@skill.Id"><i class="bi @skill.IconName" aria-hidden="true"></i><span><strong>@skill.Name</strong><small>@skill.Description</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>}</div>}
    </section>
    <section class="community-section community-events" aria-labelledby="events-title"><div class="eco-section-title"><div><span>@Tx("WORKSHOPS", "WORKSHOP")</span><h2 id="events-title">@Tx("Upcoming learning events", "Sự kiện học tập sắp tới")</h2></div></div><div class="eco-state eco-state-quiet"><i class="bi bi-calendar2" aria-hidden="true"></i><h3>@Tx("No workshop has been scheduled", "Chưa có workshop được lên lịch")</h3><p>@Tx("We will show verified dates, facilitators and registration status here when they are available.", "Khi có dữ liệu xác thực, lịch, người hướng dẫn và trạng thái đăng ký sẽ xuất hiện tại đây.")</p></div></section>
    <section class="community-section" aria-labelledby="channels-title"><div class="eco-section-title"><div><span>@Tx("OFFICIAL CHANNEL", "KÊNH CHÍNH THỨC")</span><h2 id="channels-title">@Tx("More from SoftSync", "Thông tin khác từ SoftSync")</h2></div></div><a class="community-channel" href="https://softsync.id.vn/" target="_blank" rel="noopener noreferrer"><i class="bi bi-globe2" aria-hidden="true"></i><span><strong>@Tx("SoftSync website", "Website SoftSync")</strong><small>@Tx("Product information and public learning resources", "Thông tin sản phẩm và tài nguyên học công khai")</small></span><span>@Tx("Open external site", "Mở trang ngoài")<i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span></a></section>
    <section class="community-guidelines"><i class="bi bi-shield-check" aria-hidden="true"></i><div><h2>@Tx("Learn respectfully", "Học tập tôn trọng")</h2><p>@Tx("Share situations without exposing another person's private information. Give feedback about observable behaviour, not personal labels.", "Chia sẻ tình huống mà không tiết lộ thông tin riêng tư của người khác. Phản hồi về hành vi có thể quan sát, không gắn nhãn con người.")</p></div></section>
</main>

@code{private List<SkillDto> skills=[];private bool loading=true;protected override async Task OnInitializedAsync(){try{skills=(await SkillService.GetAllSkillsAsync()).ToList();}finally{loading=false;}}private string Tx(string en,string vi)=>L.Current==AppLanguage.Vi?vi:en;}
