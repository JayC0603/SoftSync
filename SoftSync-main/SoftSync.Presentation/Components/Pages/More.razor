@page "/more"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@attribute [Authorize]

<PageTitle>@T("Thêm", "More") · SoftSync</PageTitle>
<HeadContent><link rel="stylesheet" href="css/more.css?v=20261022" /></HeadContent>
<section class="ss-more-page" aria-labelledby="more-title">
    <header><h1 id="more-title">@T("Thêm", "More")</h1><p>@T("Các tiện ích khác trong SoftSync.", "More tools and connections in SoftSync.")</p></header>
    <section aria-labelledby="more-explore"><h2 id="more-explore">@T("Khám phá và kết nối", "Explore and connect")</h2><div class="ss-more-card">
        @foreach (var item in Explore)
        {
            <a href="@item.Url"><span><strong>@item.Title</strong><small>@item.Description</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        }
    </div></section>
    <section aria-labelledby="more-options"><h2 id="more-options">@T("Tùy chọn", "Preferences")</h2><div class="ss-more-card"><a href="/settings"><span><strong>@T("Cài đặt", "Settings")</strong><small>@T("Thông báo và tùy chọn cá nhân", "Notifications and personal preferences")</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a></div></section>
    <AuthorizeView Roles="Teacher"><Authorized><section aria-labelledby="more-teaching"><h2 id="more-teaching">@T("Giảng dạy", "Teaching")</h2><div class="ss-more-card"><a href="/teacher"><span><strong>@T("Không gian giảng viên", "Teacher Studio")</strong><small>@T("Quản lý khóa học và nội dung giảng dạy", "Manage courses and teaching content")</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a></div></section></Authorized></AuthorizeView>
</section>

@code {
    private string T(string vi, string en) => L.Current == AppLanguage.Vi ? vi : en;
    private (string Url, string Title, string Description)[] Explore => [
        ("/resources", T("Tài nguyên", "Resources"), T("Tài liệu, biểu mẫu và học liệu", "Documents, templates and learning materials")),
        ("/game", T("Trò chơi nhỏ", "Mini games"), T("Luyện tập kỹ năng theo cách thú vị", "Practice your skills through play")),
        ("/assistant", T("Trợ lý SYNCY", "SYNCY assistant"), T("Hỏi đáp và hỗ trợ học tập", "Questions, answers and learning support")),
        ("/community", T("Cộng đồng", "Community"), T("Trao đổi và chia sẻ cùng người học", "Connect and share with fellow learners"))
    ];
}
