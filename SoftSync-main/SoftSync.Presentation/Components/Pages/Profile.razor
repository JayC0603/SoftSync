@page "/profile"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits LocalizedComponentBase
@using SoftSync.BLL.Interfaces
@using SoftSync.Common
@using SoftSync.Common.Dtos
@using SoftSync.Presentation.Services
@inject IUserService UserService
@inject IProgressService ProgressService
@inject IAssessmentService AssessmentService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject UserProfileState UserProfileState

<PageTitle>@L["nav.profile"] · SoftSync</PageTitle>
<HeadContent><link rel="stylesheet" href="css/profile-reference.css?v=1" /></HeadContent>
<div class="pr-profile">
    <header class="pr-heading"><h1>@L["nav.profile"]</h1><p>@L["redesign.profile.description"]</p></header>
    @if (user is null)
    {
        <div class="pr-card" role="status"><span class="spinner-border text-primary" aria-hidden="true"></span> @T("Loading profile…", "Đang tải hồ sơ…")</div>
    }
    else
    {
        <section class="pr-card pr-identity" aria-label="@user.PublicName">
            <div class="pr-person">
                <div class="pr-avatar">
                    @if (!string.IsNullOrWhiteSpace(user.AvatarUrl)) { <img src="@user.AvatarUrl" alt="@user.PublicName" /> }
                    else { <span aria-hidden="true">@Initial</span> }
                    <label class="pr-camera" title="@L["profile.avatar.change"]"><i class="bi bi-camera-fill" aria-hidden="true"></i><InputFile OnChange="OnAvatarSelected" accept="image/*" aria-label="@L["profile.avatar.change"]" /></label>
                </div>
                <div class="pr-person-info"><h2>@user.PublicName</h2>
                    <div class="pr-level-row"><span class="pr-level"><i class="bi bi-star-fill" aria-hidden="true"></i>@L["nav.level"] @user.Level</span><span>@user.ExperiencePoints XP</span></div>
                    <div class="pr-progress" role="progressbar" aria-label="@T("Level progress", "Tiến độ cấp độ")" aria-valuenow="@user.LevelProgressPercent" aria-valuemin="0" aria-valuemax="100"><span style="width: @(user.LevelProgressPercent)%"></span></div>
                    <p>@(L.Current == AppLanguage.Vi ? $"Còn {Math.Max(0, xpForNext - xpIntoLevel)} XP để lên Cấp {user.Level + 1}" : $"{Math.Max(0, xpForNext - xpIntoLevel)} XP to Level {user.Level + 1}")</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(avatarError)) { <p class="text-danger" role="alert">@avatarError</p> }
            <div class="pr-stats">
                <div><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i><strong>@assessmentCount</strong><span>@L["profile.stat.assessments"]</span></div>
                <div><i class="bi bi-bar-chart-fill" aria-hidden="true"></i><strong>@completedSkills</strong><span>@L["profile.stat.skillsTracked"]</span></div>
                <div><i class="bi bi-award-fill" aria-hidden="true"></i><strong>@user.Level</strong><span>@L["profile.stat.currentLevel"]</span></div>
            </div>
        </section>
        <section class="pr-card pr-details" aria-labelledby="pr-details-title">
            <h2 id="pr-details-title">@T("Account information", "Thông tin tài khoản")</h2>
            <dl>
                <div><i class="bi bi-envelope" aria-hidden="true"></i><dt>@L["auth.email"]</dt><dd>@email</dd></div>
                <div><i class="bi bi-people" aria-hidden="true"></i><dt>@L["wizard.about.ageGroup"]</dt><dd>@(ProfileAgeGroups.LabelKey(user.Age) is { Length: > 0 } ageLabel ? L[ageLabel] : "—")</dd></div>
                <div><i class="bi bi-bullseye" aria-hidden="true"></i><dt>@L["profile.goal"]</dt><dd>@(string.IsNullOrWhiteSpace(user.Goal) ? "—" : L[user.Goal])</dd></div>
            </dl>
            <div class="pr-actions"><a href="/settings"><i class="bi bi-pencil" aria-hidden="true"></i>@L["profile.edit"]</a><button type="button" @onclick="GoJourney"><i class="bi bi-compass" aria-hidden="true"></i>@(profileComplete && hasAssessment ? T("Open Roadmap", "Mở Roadmap") : ResolveJourneyButtonText())</button></div>
        </section>
        <section class="pr-card pr-summary" aria-labelledby="pr-summary-title">
            <h2 id="pr-summary-title">@T("Quick summary", "Tóm tắt nhanh")</h2>
            <a href="/roadmap"><i class="bi bi-book" aria-hidden="true"></i><span>@T("Current skill", "Kỹ năng đang học")</span><strong>@(string.IsNullOrWhiteSpace(learningSkill) ? T("Not started", "Chưa bắt đầu") : L.Ui(learningSkill))</strong><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            <a href="/progress"><i class="bi bi-play-circle" aria-hidden="true"></i><span>@T("Latest skill activity", "Kỹ năng luyện gần nhất")</span><strong>@(string.IsNullOrWhiteSpace(latestSkill) ? T("No activity yet", "Chưa có hoạt động") : L.Ui(latestSkill))</strong><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            <a href="/progress"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span>@T("Learning progress", "Tiến độ học tập")</span><strong>@progressPercent%</strong><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        </section>
    }
</div>

@code {
    private string T(string en, string vi) => L.Current == AppLanguage.Vi ? vi : en;
    private string Initial => string.IsNullOrWhiteSpace(user?.PublicName) ? "?" : System.Globalization.StringInfo.GetNextTextElement(user.PublicName.Trim()).ToUpperInvariant();
    private string learningSkill = "";
    private string latestSkill = "";
    private int progressPercent;
    private const long MaxAvatarBytes = 3 * 1024 * 1024;
    private UserDto? user;
    private int userId;
    private string? email;
    private string? avatarError;
    private int assessmentCount;
    private int completedSkills;
    private int xpIntoLevel;
    private int xpForNext;
    private bool hasAssessment;
    private bool profileComplete;
    private string journeyButtonText = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        userId = state.User.GetUserId();
        email = state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? state.User.Identity?.Name;

        user = await UserService.GetUserByIdAsync(userId);
        if (user is not null)
        {
            xpIntoLevel = LevelSystem.XpIntoCurrentLevel(user.ExperiencePoints);
            xpForNext = LevelSystem.XpForNextLevel(user.ExperiencePoints);
        }

        var results = await AssessmentService.GetLatestResultsAsync(userId, userId);
        assessmentCount = (await AssessmentService.GetHistoryAsync(userId, userId)).Count;
        hasAssessment = results.Any();
        var progress = (await ProgressService.GetUserProgressAsync(userId)).ToList();
        learningSkill = progress.FirstOrDefault(x => x.PercentComplete < 100)?.SkillName ?? "";
        latestSkill = progress.OrderByDescending(x => x.UpdatedAt).FirstOrDefault()?.SkillName ?? "";
        progressPercent = progress.Count > 0 ? (int)progress.Average(x => x.PercentComplete) : 0;
        completedSkills = progress.Count();
        var selectedSkills = await UserService.GetSelectedSkillIdsAsync(userId);
        profileComplete = user is not null
            && !string.IsNullOrWhiteSpace(user.FullName)
            && user.Age > 0
            && user.Gender != SoftSync.Common.Enums.Gender.Unspecified
            && !string.IsNullOrWhiteSpace(user.Goal)
            && selectedSkills.Any();
        journeyButtonText = ResolveJourneyButtonText();
    }

    private string ResolveJourneyButtonText() => !profileComplete
        ? L["home.dashboard.completeProfile"]
        : hasAssessment
            ? L["home.dashboard.primaryCta"]
            : L["home.dashboard.continueAssessment"];

    private void GoJourney()
    {
        var route = !profileComplete
            ? "/profile-setup"
            : hasAssessment
                ? $"/roadmap/{userId}"
                : $"/assessment/{userId}";

        Nav.NavigateTo(route);
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        avatarError = null;
        var file = e.File;
        if (file is null || user is null) return;

        if (file.Size > MaxAvatarBytes) { avatarError = L["profile.avatar.tooLarge"]; return; }
        if (!file.ContentType.StartsWith("image/")) { avatarError = L["profile.avatar.notImage"]; return; }

        try
        {
            user.AvatarUrl = await ToDataUrlAsync(file);
            await UserService.SetAvatarAsync(userId, user.AvatarUrl);
            UserProfileState.NotifyAvatarChanged(user.AvatarUrl);
        }
        catch (Exception ex)
        {
            avatarError = L["profile.avatar.uploadFailed"] + " " + ex.Message;
        }
    }

    private static async Task<string> ToDataUrlAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxAvatarBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }
}
