@page "/cv"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inherits LocalizedComponentBase
@attribute [Authorize]
@implements IAsyncDisposable
@inject Microsoft.Extensions.Options.IOptions<CvIntegrationOptions> Options
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Ui("CV thông minh") · SoftSync</PageTitle>
<section class="ss-cv-workspace" aria-label="Smart CV">
    <CvCareerWorkspace />
    @if (Options.Value.Configured)
    {
        <details class="cv-legacy-tools"><summary>Công cụ CV mở rộng</summary><div class="ss-cv-frame-container">
            <p id="cv-connection-status" class="ss-cv-connection" role="status">@Ui("Đang kết nối tài khoản SoftSync…")</p>
            <iframe id="softsync-cv-frame" src="@FrameUrl" title="@Ui("Các công cụ CV của SoftSync")"
                allow="clipboard-write" referrerpolicy="no-referrer"
                sandbox="allow-scripts allow-same-origin allow-forms allow-downloads allow-popups allow-top-navigation-by-user-activation"></iframe>
        </div></details>
    }

</section>

<style>
    .ss-cv-heading { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:20px; }
    .ss-cv-heading span { color:var(--ss-primary); font-size:.875rem; letter-spacing:.12em; font-weight:700; }
    .ss-cv-heading h1 { margin:6px 0; font-size:clamp(2rem,3vw,2.25rem); }
    .ss-cv-heading p { color:var(--ss-text-muted); margin:0; font-size:1rem; }
    .ss-cv-heading a { white-space:nowrap; color:var(--ss-primary); font-size:1rem; text-decoration:none; }
    .ss-cv-frame-container { position:relative; min-height:620px; border:1px solid var(--ss-border); border-radius:18px; overflow:hidden; background:var(--ss-surface); }
    .ss-cv-frame-container iframe { width:100%; height:max(620px,calc(100dvh - 260px)); border:0; display:block; }
    .ss-cv-connection { margin:0; padding:15px 20px; color:var(--ss-text-muted); font-size:.85rem; }
    .ss-cv-connection[hidden] { display:none; }
    .ss-cv-unavailable { padding:28px; }
    @@media(max-width:600px) { .ss-cv-heading { align-items:flex-start; flex-direction:column; } .ss-cv-frame-container { border-radius:12px; } }
</style>

@code {
    private IJSObjectReference? module;
    private string FrameUrl => new Uri(Options.Value.FrontendOrigin!, "/cv").ToString()
        + "?integrated=1&host=" + Uri.EscapeDataString(new Uri(Navigation.Uri).GetLeftPart(UriPartial.Authority));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Options.Value.Configured) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cv-integration.js");
        await module.InvokeVoidAsync("mount", "softsync-cv-frame", Options.Value.FrontendOrigin!.GetLeftPart(UriPartial.Authority));
    }
    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("unmount", "softsync-cv-frame"); await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
