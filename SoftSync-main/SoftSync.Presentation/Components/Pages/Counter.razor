@page "/counter"
@inherits LocalizedComponentBase
@rendermode InteractiveServer

<PageTitle>@Ui("Counter")</PageTitle>

<h1>@Ui("Counter")</h1>

<p role="status">@Ui("Current count:") @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">@Ui("Click me")</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
