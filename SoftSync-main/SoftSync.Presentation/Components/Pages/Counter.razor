@page "/counter"
@rendermode InteractiveServer
@inherits LocalizedComponentBase

<PageTitle>@Ui.Text("Counter")</PageTitle>

<h1>@Ui.Text("Counter")</h1>

<p role="status">@Ui.Text("Current count:") @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">@Ui.Text("Click me")</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
