@page "/game/history"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@attribute [Authorize(Policy = SoftSync.BLL.Auth.CourseAuthorization.UserPolicy)]
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@inject IChallengeService Challenges
@inject AuthenticationStateProvider Auth

<PageTitle>@Ui("Quiz History") · SoftSync</PageTitle>
<HeadContent><link rel="stylesheet" href="css/quiz-history.css?v=1" /></HeadContent>
<section class="qh-history">
    <section class="tw:mx-auto tw:max-w-5xl" aria-labelledby="history-title" aria-busy="@loading">
        <a href="/game" class="btn btn-link tw:px-0">← @Ui("Mini Game")</a>
        <h1 id="history-title" class="tw:text-3xl tw:font-bold">@Ui("Lịch sử làm bài")</h1>
        @if (loading)
        {
            <p role="status">@Ui("Đang tải lịch sử làm bài...")</p>
        }
        else if (attempts.Count == 0)
        {
            <div class="alert alert-info tw:mt-5" role="status">@Ui("Bạn chưa hoàn thành bài kiểm tra nào.")</div>
        }
        else
        {
            <div class="table-responsive tw:mt-5">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">@Ui("Các lần làm bài kiểm tra đã hoàn thành")</caption>
                    <thead><tr><th scope="col">@Ui("Bài kiểm tra")</th><th scope="col">@Ui("Hoàn thành")</th><th scope="col">@Ui("Điểm")</th><th scope="col">@Ui("Kết quả")</th><th scope="col">@Ui("Thao tác")</th></tr></thead>
                    <tbody>
                    @foreach (var attempt in attempts)
                    {
                        <tr>
                            <td>@Ui(attempt.QuizTitle)</td>
                            <td>@attempt.CompletedAtUtc.ToLocalTime().ToString("g", L.Culture)</td>
                            <td>@attempt.CorrectAnswers / @attempt.TotalQuestions (@attempt.ScorePercentage.ToString("0")%)</td>
                            <td><span class="badge @(attempt.Passed ? "bg-success" : "bg-danger")">@(attempt.Passed ? Ui("PASS") : Ui("NOT PASS"))</span></td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/game/result/@attempt.AttemptId">@Ui("Xem kết quả")</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@code {
    private IReadOnlyList<QuizAttemptResultDto> attempts = [];
    private bool loading = true;
    protected override async Task OnInitializedAsync()
    {
        var userId = await Auth.GetUserIdAsync();
        attempts = await Challenges.GetHistoryAsync(userId);
        loading = false;
    }
}
