@page "/progress"
@page "/progress/{UserId:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [StreamRendering]
@inherits LocalizedComponentBase
@using SoftSync.BLL.Interfaces
@using SoftSync.Common
@using SoftSync.Common.Dtos
@inject IProgressService ProgressService
@inject IRoadmapService RoadmapService
@inject IUserService UserService
@inject NavigationManager Nav

<section class="focus-progress-page" aria-labelledby="focus-progress-title">
    <header class="focus-progress-head">
        <div><span>@Tx("LEARNING INSIGHT", "PHÂN TÍCH HỌC TẬP")</span><h1 id="focus-progress-title">@Tx("Your progress", "Tiến độ của bạn")</h1><p>@Tx("See what is improving and where to focus next.", "Xem kỹ năng nào đang tiến bộ và nên tập trung vào đâu tiếp theo.")</p></div>
        <div class="pg-calendar focus-range">
            <button type="button" class="pg-calendar-trigger" @onclick="()=>calendarOpen=!calendarOpen" aria-expanded="@calendarOpen"><i class="bi bi-calendar3"></i>@DateRange<i class="bi bi-chevron-down"></i></button>
            @if(calendarOpen){<section class="pg-calendar-popover"><header><b>@Tx("Learning calendar", "Lịch học")</b><button type="button" @onclick="()=>calendarOpen=false" aria-label="@Tx("Close", "Đóng")"><i class="bi bi-x-lg"></i></button></header><label>@Tx("From", "Từ ngày")<input type="date" @bind="draftStart" /></label><label>@Tx("To", "Đến ngày")<input type="date" @bind="draftEnd" /></label><div class="pg-calendar-summary"><i class="bi bi-check2-circle"></i><span><b>@DraftActivityCount</b>@Tx("completed activities in this period", "hoạt động hoàn thành trong khoảng này")</span></div><footer><button type="button" class="secondary" @onclick="SetCurrentWeek">@Tx("This week", "Tuần này")</button><button type="button" class="apply" @onclick="ApplyDateRange">@Tx("Apply", "Áp dụng")</button></footer></section>}
        </div>
    </header>

    <section class="focus-growth" aria-labelledby="skill-growth-title">
        <div class="focus-growth-main"><div class="focus-section-title"><div><span>@Tx("LAST 8 WEEKS", "8 TUẦN GẦN ĐÂY")</span><h2 id="skill-growth-title">@Tx("Skill growth", "Tăng trưởng kỹ năng")</h2></div><button @onclick='() => Nav.NavigateTo("/assessment/" + UserId)'>@Tx("Review skills", "Xem đánh giá")<i class="bi bi-arrow-right"></i></button></div>
            <div class="focus-skill-bars">
                @foreach (var track in Tracks)
                {
                    var percent = TrackProgress(track);
                    <div><span><i class="bi @track.Icon"></i><b>@TrackName(track)</b><strong>@percent%</strong></span><div><i style="width:@percent%"></i></div><small>@TrackSummary(track)</small></div>
                }
            </div>
        </div>
        <aside class="focus-overall"><span>@Tx("OVERALL GROWTH", "TIẾN ĐỘ TỔNG THỂ")</span><strong>@Overall%</strong><p>@CompletedActivities / @TotalActivities @Tx("learning steps completed", "bước học đã hoàn thành")</p><button @onclick='() => Nav.NavigateTo("/roadmap")'>@Tx("Continue learning", "Tiếp tục học")<i class="bi bi-arrow-right"></i></button></aside>
    </section>

    <section class="focus-journey-table" aria-labelledby="learning-journey-title">
        <div class="focus-section-title"><div><span>@Tx("PIPELINE STATUS", "TRẠNG THÁI PIPELINE")</span><h2 id="learning-journey-title">@Tx("Learning journey", "Hành trình học tập")</h2></div><button @onclick='() => Nav.NavigateTo("/roadmap")'>@Tx("Open roadmap", "Mở lộ trình")<i class="bi bi-arrow-right"></i></button></div>
        @if (roadmapItems.Count == 0)
        {
            <div class="focus-progress-empty"><i class="bi bi-signpost-split"></i><h3>@Tx("Your roadmap is ready to begin", "Lộ trình của bạn đã sẵn sàng")</h3><button @onclick='() => Nav.NavigateTo("/roadmap")'>@Tx("Start learning", "Bắt đầu học")</button></div>
        }
        else
        {
            <div class="focus-journey-list">
                @foreach (var item in roadmapItems.Take(5))
                {
                    <article>
                        <div class="focus-course"><i class="bi @SkillIcon(item)"></i><span><b>@LocalizedSkillName(item.SkillName)</b><small>@Tx("Week", "Tuần") @item.WeekNumber · @item.Title</small></span></div>
                        <div class="focus-mini-pipeline" aria-label="@Tx("Lesson pipeline", "Pipeline bài học")">
                            @foreach (var step in Pipeline)
                            {
                                var state = StepState(item, step.Id);
                                <span class="@state" title="@Tx(step.En, step.Vi)"><i class="bi @(state == "done" ? "bi-check-lg" : state == "current" ? "bi-play-fill" : "bi-lock")"></i><b>@Tx(step.En, step.Vi)</b></span>
                            }
                        </div>
                        <div class="focus-row-progress"><b>@CompletedStepCount(item)/6</b><span><i style="width:@(CompletedStepCount(item)*100/6)%"></i></span></div>
                        <button aria-label="@Tx("Open lesson", "Mở bài học")" @onclick='() => Nav.NavigateTo("/roadmap")'><i class="bi bi-chevron-right"></i></button>
                    </article>
                }
            </div>
        }
    </section>

    <div class="focus-progress-bottom">
        <section><div class="focus-section-title"><div><span>@Tx("MILESTONES", "CỘT MỐC")</span><h2>@Tx("Recent achievements", "Thành tích gần đây")</h2></div></div><div class="focus-achievements"><div><i class="bi bi-fire"></i><span><b>@ActiveDays @Tx("day streak", "ngày liên tiếp")</b><small>@Tx("Keep your learning rhythm", "Duy trì nhịp học")</small></span></div><div><i class="bi bi-check-circle"></i><span><b>@CompletedActivities @Tx("steps completed", "bước đã hoàn thành")</b><small>@Tx("Across your current roadmap", "Trong lộ trình hiện tại")</small></span></div><div><i class="bi bi-stars"></i><span><b>@(user?.ExperiencePoints ?? 0) XP</b><small>@Tx("Earned from learning", "Tích lũy từ học tập")</small></span></div></div></section>
        <aside class="focus-next-action"><img src="/images/syncy-robot.png" alt="" /><div><span>@Tx("FOCUS NEXT", "TẬP TRUNG TIẾP THEO")</span><h2>@Tx("Turn insight into Practice", "Biến kiến thức thành Practice")</h2><p>@Tx("Continue the active lesson and complete its required Practice before Reflection.", "Tiếp tục bài đang học và hoàn thành Practice bắt buộc trước Reflection.")</p><button @onclick='() => Nav.NavigateTo("/roadmap")'>@Tx("Continue", "Tiếp tục")<i class="bi bi-arrow-right"></i></button></div></aside>
    </div>
</section>


@code{
 [Parameter]public int UserId{get;set;} [Inject]AuthenticationStateProvider AuthProvider{get;set;}=default!; private UserDto? user;private List<ProgressDto> progressLogs=[];private List<RoadmapItemDto> roadmapItems=[];private int selectedTrack;private bool calendarOpen;private DateTime rangeStart=DateTime.Today.AddDays(-6),rangeEnd=DateTime.Today,draftStart=DateTime.Today.AddDays(-6),draftEnd=DateTime.Today;
 private int TotalActivities=>roadmapItems.Sum(item=>item.TotalActivityCount);private int CompletedActivities=>roadmapItems.Sum(CompletedStepCount);private int Overall=>RoadmapProgressCalculator.Percent(CompletedActivities,TotalActivities);private LearningTrack CurrentTrack=>Tracks[selectedTrack];
 private IEnumerable<DateTime> ActivityDates=>roadmapItems.SelectMany(ActivityTimestamps).Select(x=>x.ToLocalTime());
 private int ActiveDays=>ConsecutiveActiveDays(ActivityDates.Select(x=>x.Date));
 private int CompletedInRange=>ActivityDates.Count(x=>InRange(x,rangeStart,rangeEnd));
 private string StudyTimeInRange=>FormatMinutes(roadmapItems.Sum(x=>StepMinutesInRange(x,rangeStart,rangeEnd)));
 private string DateRange=>$"{rangeStart:dd/MM/yyyy} - {rangeEnd:dd/MM/yyyy}";
 private List<DateTime> DraftStudyDates=>ActivityDates.Where(x=>InRange(x,draftStart,draftEnd)).Select(x=>x.Date).Distinct().OrderBy(x=>x).ToList();
 private int DraftActivityCount=>ActivityDates.Count(x=>InRange(x,draftStart,draftEnd));
 private int TrackProgress(LearningTrack track){var matches=roadmapItems.Where(x=>track.Keys.Any(k=>$"{x.SkillName} {x.Title}".Contains(k,StringComparison.OrdinalIgnoreCase))).ToList();var total=matches.Count*6;return total==0?0:matches.Sum(CompletedStepCount)*100/total;}
 private int EstimatedCompleted(LearningTrack track)=>(int)Math.Round(track.Modules.Count*TrackProgress(track)/100d);
 private static readonly (int Id,string En,string Vi)[] Pipeline=[(1,"Video","Video"),(2,"Script","Script"),(3,"Summary","Tóm tắt"),(4,"Quiz","Quiz"),(5,"Practice","Thực hành"),(6,"Reflection","Phản tư")];
 private static string SkillIcon(RoadmapItemDto item){var value=$"{item.SkillName} {item.Title}".ToLowerInvariant();return value.Contains("time")||value.Contains("thời gian")?"bi-clock-history":value.Contains("critical")||value.Contains("phản biện")?"bi-lightbulb":"bi-chat-dots";}
 private static string StepState(RoadmapItemDto item,int step){var done=step switch{1=>item.IsVideoCompleted||item.VideoCompletedAtUtc.HasValue,2=>item.ScriptCompletedAtUtc.HasValue,3=>item.SummaryCompletedAtUtc.HasValue,4=>item.IsPracticeCompleted||item.PracticeCompletedAtUtc.HasValue,5=>item.IsScenarioCompleted||item.ScenarioCompletedAtUtc.HasValue,6=>item.IsReflectionCompleted||item.ReflectionCompletedAtUtc.HasValue,_=>false};if(done)return "done";var accessible=step==1||step==2&&(item.IsVideoCompleted||item.VideoCompletedAtUtc.HasValue)||step==3&&item.ScriptCompletedAtUtc.HasValue||step==4&&item.SummaryCompletedAtUtc.HasValue||step==5&&(item.IsPracticeCompleted||item.PracticeCompletedAtUtc.HasValue)||step==6&&(item.IsScenarioCompleted||item.ScenarioCompletedAtUtc.HasValue);return accessible?"current":"locked";}
 private string ModuleState(LearningTrack track,int index){var completed=EstimatedCompleted(track);return index<completed?"done":index==completed?"current":"locked";}
 private static int CompletedStepCount(RoadmapItemDto item)=>item.CompletedActivityCount;
 private static IEnumerable<DateTime> ActivityTimestamps(RoadmapItemDto item)
 {
  if(item.VideoCompletedAtUtc is { } video)yield return video;
  if(item.ScriptCompletedAtUtc is { } script)yield return script;
  if(item.SummaryCompletedAtUtc is { } summary)yield return summary;
  if(item.PracticeCompletedAtUtc is { } practice)yield return practice;
  if(item.ScenarioCompletedAtUtc is { } scenario)yield return scenario;
  if(item.ReflectionCompletedAtUtc is { } reflection)yield return reflection;
 }
 private static int ConsecutiveActiveDays(IEnumerable<DateTime> dates)
 {
  var days=dates.Distinct().OrderByDescending(x=>x).ToHashSet();
  var cursor=days.Contains(DateTime.Today)?DateTime.Today:DateTime.Today.AddDays(-1);
  var streak=0;
  while(days.Contains(cursor)){streak++;cursor=cursor.AddDays(-1);}
  return streak;
 }
 private static bool InRange(DateTime value,DateTime start,DateTime end)=>value.Date>=start.Date&&value.Date<=end.Date;
 private static int StepMinutesInRange(RoadmapItemDto item,DateTime start,DateTime end)
 {
  var stamps=new[]{item.VideoCompletedAtUtc,item.ScriptCompletedAtUtc,item.SummaryCompletedAtUtc,item.PracticeCompletedAtUtc,item.ScenarioCompletedAtUtc,item.ReflectionCompletedAtUtc};
  var minutes=new[]{9,9,5,4,10,5};
  return stamps.Select((stamp,index)=>(stamp,index)).Where(x=>x.stamp.HasValue&&InRange(x.stamp.Value.ToLocalTime(),start,end)).Sum(x=>minutes[x.index]);
 }
 private string FormatMinutes(int minutes)=>minutes>=60?$"{minutes/60}h {minutes%60:D2}m":$"{minutes} min";
 private string LocalizedSkillName(string name)
 {
  if(L.Current==AppLanguage.Vi)return name.Replace("Time Management","Quản lý thời gian",StringComparison.OrdinalIgnoreCase).Replace("Critical Thinking","Tư duy phản biện",StringComparison.OrdinalIgnoreCase).Replace("Communication","Giao tiếp",StringComparison.OrdinalIgnoreCase);
  return name.Replace("Quản lý thời gian","Time Management",StringComparison.OrdinalIgnoreCase).Replace("Tư duy phản biện","Critical Thinking",StringComparison.OrdinalIgnoreCase).Replace("Giao tiếp","Communication",StringComparison.OrdinalIgnoreCase);
 }
 private string TrackName(LearningTrack x)=>Tx(x.NameEn,x.NameVi);private string TrackSummary(LearningTrack x)=>Tx(x.SummaryEn,x.SummaryVi);private string ModuleName(LearningModule x)=>Tx(x.NameEn,x.NameVi);private string ModuleType(string type)=>type switch{"Video"=>"Video","Quiz"=>"Quiz","Lesson"=>Tx("Lesson","Bài học"),_=>Tx("Game","Trò chơi")};
 protected override async Task OnInitializedAsync(){UserId=await AuthProvider.GetUserIdAsync();if(UserId<=0){Nav.NavigateTo("/Account/Login",true);return;}user=await UserService.GetUserByIdAsync(UserId);progressLogs=(await ProgressService.GetUserProgressAsync(UserId)).ToList();roadmapItems=(await RoadmapService.GetUserRoadmapAsync(UserId,UserId)).Items.OrderBy(x=>x.WeekNumber).ToList();}
 private void ApplyDateRange(){if(draftStart>draftEnd)(draftStart,draftEnd)=(draftEnd,draftStart);rangeStart=draftStart.Date;rangeEnd=draftEnd.Date;calendarOpen=false;}
 private void SetCurrentWeek(){draftStart=DateTime.Today.AddDays(-6);draftEnd=DateTime.Today;ApplyDateRange();}
 private void ScrollToStatistics()=>Nav.NavigateTo("/progress#progress-statistics");
 private void ScrollToAchievements()=>Nav.NavigateTo("/progress#progress-achievements");
 private string Tx(string en,string vi)=>L.Current==AppLanguage.Vi?vi:en;
 private sealed record LearningModule(string Type,string NameEn,string NameVi,string Route);
 private sealed record LearningTrack(string NameEn,string NameVi,string Icon,string SummaryEn,string SummaryVi,string[] Keys,List<LearningModule> Modules);
 private static readonly List<LearningTrack> Tracks =
 [
  new("Communication", "Giao tiếp", "bi-chat-dots", "Build confident communication through listening, feedback and practice.", "Rèn luyện giao tiếp tự tin qua lắng nghe, phản hồi và thực hành.", ["communication", "giao tiếp"],
  [
   new("Video", "Communication foundations", "Nền tảng giao tiếp", "/roadmap"),
   new("Lesson", "Active listening", "Lắng nghe chủ động", "/roadmap"),
   new("Quiz", "Communication situations", "Tình huống giao tiếp", "/roadmap")
  ]),
  new("Time management", "Quản lý thời gian", "bi-clock-history", "Plan priorities and build a sustainable study rhythm.", "Lập kế hoạch ưu tiên và xây dựng nhịp học bền vững.", ["time", "thời gian"],
  [
   new("Video", "Time management foundations", "Nền tảng quản lý thời gian", "/roadmap"),
   new("Practice", "Eisenhower Matrix", "Ma trận Eisenhower", "/roadmap"),
   new("Quiz", "Priority challenge", "Thử thách ưu tiên", "/roadmap")
  ]),
  new("Critical thinking", "Tư duy phản biện", "bi-lightbulb", "Analyze information, arguments and decisions more clearly.", "Phân tích thông tin, lập luận và quyết định rõ ràng hơn.", ["critical", "phản biện"],
  [
   new("Video", "Thinking foundations", "Nền tảng tư duy", "/roadmap"),
   new("Lesson", "Argument mapping", "Bản đồ lập luận", "/roadmap"),
   new("Quiz", "Reasoning challenge", "Thử thách lập luận", "/roadmap")
  ])
 ];
}

