@inherits ProgressLocalizedComponentBase
@page "/progress"
@page "/progress/{UserId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@attribute [StreamRendering]
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@inject IRoadmapService RoadmapService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject ILogger<Progress> Logger

<PageTitle>@T("Tiến độ") · SoftSync</PageTitle>
<HeadContent><link rel="stylesheet" href="css/progress-reference.css?v=20261022-v1" /></HeadContent>

<section class="pg-page" aria-label="@T("Tiến độ học tập")">
    @if (loading)
    {
        <div class="pg-state" role="status"><span class="pg-spinner" aria-hidden="true"></span><h1>@T("Đang tổng hợp tiến độ của bạn…")</h1></div>
    }
    else if (loadError)
    {
        <div class="pg-state" role="alert"><i class="bi bi-cloud-slash" aria-hidden="true"></i><h1>@T("Chưa thể tải tiến độ")</h1><p>@T("Vui lòng thử lại để xem tiến độ học đã lưu.")</p><button type="button" class="pg-primary" @onclick="LoadProgress">@T("Thử lại")</button></div>
    }
    else
    {
        <ProgressDashboard Items="@roadmapItems" UserId="@UserId" />
    }
</section>

@code {
    [Parameter] public int UserId { get; set; }
    private List<RoadmapItemDto> roadmapItems = [];
    private bool loading = true, loadError;
    protected override Task OnInitializedAsync() => LoadProgress();
    private async Task LoadProgress()
    {
        loading = true;
        loadError = false;
        try
        {
            UserId = await AuthProvider.GetUserIdAsync();
            if (UserId <= 0) { Nav.NavigateTo("/Account/Login", true); return; }
            roadmapItems = (await RoadmapService.GetUserRoadmapAsync(UserId, UserId)).Items.OrderBy(x => x.PriorityOrder).ThenBy(x => x.WeekNumber).ToList();
        }
        catch (Exception ex) { Logger.LogError(ex, "Could not load learning progress"); loadError = true; }
        finally { loading = false; }
    }
}
