@page "/settings"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits LocalizedComponentBase
@using SoftSync.BLL.Interfaces
@using SoftSync.Common
@using SoftSync.Common.Dtos
@using SoftSync.Common.Enums
@using SoftSync.DAL.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject IUserService UserService
@inject ISkillService SkillService
@inject IAssessmentService AssessmentService
@inject IProgressService ProgressService
@inject UserManager<ApplicationUser> UserManagerSvc
@inject SignInManager<ApplicationUser> SignInManagerSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject UserProfileState UserProfileState
@inject IJSRuntime JS
@inject ILogger<Settings> Logger
@implements IAsyncDisposable

<PageTitle>@L["nav.settings"] · SoftSync</PageTitle>
<div class="ss-settings-shell settings-studio">
    <header class="st-page-heading">
        <div><a class="st-breadcrumb" href="/more"><i class="bi bi-arrow-left" aria-hidden="true"></i> @Tx("Your space", "Không gian của bạn")</a><h1>@Tx("Make SoftSync yours", "Cài đặt của bạn")</h1><p>@Tx("A little more personal. A little more you.", "Một không gian học tập theo cách của riêng bạn.")</p></div>
        <span class="st-private-badge"><i class="bi bi-shield-check" aria-hidden="true"></i> @Tx("Your account, protected", "Tài khoản được bảo vệ")</span>
    </header>
    @if (loadFailed)
    {
        <div class="st-card st-empty" role="alert"><i class="bi bi-cloud-slash" aria-hidden="true"></i><h2>@Tx("We could not load your settings", "Chưa thể tải cài đặt")</h2><p>@Tx("Please reload the page and try again.", "Vui lòng tải lại trang và thử lại.")</p><a class="st-button st-button-primary" href="/settings" data-enhance-nav="false">@Tx("Try again", "Thử lại")</a></div>
    }
    else if (user is null)
    {
        <div class="st-card st-skeleton" role="status" aria-label="@Tx("Loading settings", "Đang tải cài đặt")"><span></span><span></span><span></span></div>
    }
    else
    {
        <fieldset disabled="@(!interactiveReady || saving)" class="st-fieldset">
        <section class="st-profile-banner" aria-label="@Tx("Your profile", "Hồ sơ của bạn")">
            <div class="st-avatar"><img src="@(string.IsNullOrWhiteSpace(user.AvatarUrl) ? Mascot.ImageFor(user.Gender) : user.AvatarUrl)" alt="@user.PublicName" /><label class="st-avatar-edit" title="@L["profile.avatar.change"]"><i class="bi bi-camera" aria-hidden="true"></i><InputFile OnChange="OnAvatarSelected" accept="image/png,image/jpeg,image/webp" aria-label="@L["profile.avatar.change"]" /></label></div>
            <div class="st-profile-name"><span class="st-eyebrow">@Tx("YOUR LEARNING SPACE", "KHÔNG GIAN HỌC TẬP")</span><h2>@user.PublicName <span class="st-level">@L["nav.level"] @user.Level</span></h2><p>@email</p></div>
            <div class="st-profile-facts"><div><strong>@user.ExperiencePoints</strong><span>XP</span></div><div><strong>@trackedSkillCount</strong><span>@Tx("Skills in progress", "Kỹ năng đang học")</span></div><div><strong>@assessedSkillCount</strong><span>@Tx("Skills assessed", "Kỹ năng đã đánh giá")</span></div></div>
        </section>
        @if (!string.IsNullOrEmpty(avatarError)) { <p class="st-feedback st-feedback-error" role="alert">@avatarError</p> }
        <div class="st-layout">
            <aside class="st-sidebar">
                <nav class="st-navigation" aria-label="@Tx("Settings sections", "Danh mục cài đặt")">
                    <span class="st-nav-label">@Tx("PREFERENCES", "TÙY CHỈNH CỦA BẠN")</span>
                    @foreach (var item in Sections)
                    {
                        <button type="button" class="st-nav-item @(tab == item.Value ? "is-active" : "")" aria-current="@(tab == item.Value ? "page" : null)" aria-controls="st-panel" data-section="@item.Value" @onclick="() => SelectTabAsync(item.Value)"><i class="bi @item.Icon" aria-hidden="true"></i><span><strong>@item.Title</strong><small>@item.Description</small></span><i class="bi bi-chevron-right st-nav-arrow" aria-hidden="true"></i></button>
                    }
                </nav>
                <div class="st-help-card"><span class="st-help-icon"><i class="bi bi-chat-heart" aria-hidden="true"></i></span><h3>@Tx("A little help?", "Bạn cần hỗ trợ?")</h3><p>@Tx("Your learning assistant is a conversation away.", "Trợ lý học tập luôn sẵn sàng đồng hành cùng bạn.")</p><a href="/assistant">@Tx("Ask SoftSync", "Trò chuyện với trợ lý") <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
                <form action="/Account/Logout" method="post" class="st-signout"><AntiforgeryToken /><input type="hidden" name="returnUrl" value="Account/Login" /><button type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>@L["nav.logout"]</button></form>
            </aside>
            <section id="st-panel" class="st-content" aria-labelledby="st-panel-heading">
                <header class="st-section-heading"><div class="st-section-symbol"><i class="bi @ActiveSection.Icon" aria-hidden="true"></i></div><div><h2 id="st-panel-heading">@ActiveSection.Title</h2><p>@SectionDescription</p></div><span class="st-section-index">@((Array.FindIndex(Sections, x => x.Value == tab) + 1).ToString("00")) / 07</span></header>
                @if (tab == Tab.Account)
                {
                    <section class="st-card" aria-labelledby="st-personal-title">
                        <header class="st-card-heading"><div><h3 id="st-personal-title">@Tx("Personal information", "Thông tin cá nhân")</h3><p>@Tx("Let us get to know you a little better.", "Thông tin giúp SoftSync hiểu bạn hơn.")</p></div><span class="st-soft-tag"><i class="bi bi-person-check" aria-hidden="true"></i>@Tx("Only you", "Chỉ mình bạn")</span></header>
                        <div class="st-form-grid">
                            <div class="st-field"><label for="fullName">@L["profile.fullName"] <span aria-hidden="true">*</span></label><div class="st-input-wrap"><i class="bi bi-person" aria-hidden="true"></i><input id="fullName" autocomplete="name" maxlength="100" required @bind="user.FullName" @bind:event="oninput" /></div></div>
                            <div class="st-field"><label for="displayName">@L["settings.displayName"]</label><div class="st-input-wrap"><i class="bi bi-at" aria-hidden="true"></i><input id="displayName" maxlength="60" @bind="user.DisplayName" @bind:event="oninput" placeholder="@user.FullName" aria-describedby="st-display-hint" /></div><small id="st-display-hint">@Tx("The name you will see throughout SoftSync.", "Tên xuất hiện trong không gian học tập của bạn.")</small></div>
                            <div class="st-field"><label for="age">@L["wizard.about.ageGroup"]</label><div class="st-input-wrap"><i class="bi bi-calendar3" aria-hidden="true"></i><select id="age" value="@ProfileAgeGroups.ForAge(user.Age)" @onchange="OnAgeGroupChanged"><option value="">@Tx("Select your age group", "Chọn nhóm tuổi")</option>@foreach (var group in ProfileAgeGroups.Options) { <option value="@group.Key">@L[group.LabelKey]</option> }</select></div></div>
                            <div class="st-field"><label for="gender">@Tx("Gender", "Giới tính")</label><div class="st-input-wrap"><i class="bi bi-person-badge" aria-hidden="true"></i><select id="gender" @bind="user.Gender"><option value="@Gender.Unspecified">@L["wizard.gender.other"]</option><option value="@Gender.Male">@L["wizard.gender.male"]</option><option value="@Gender.Female">@L["wizard.gender.female"]</option></select></div></div>
                            <div class="st-field"><label for="email">@L["auth.email"] <i class="bi bi-lock" aria-hidden="true"></i></label><div class="st-input-wrap is-readonly"><i class="bi bi-envelope" aria-hidden="true"></i><input id="email" value="@email" readonly /></div><small>@Tx("Your sign-in email is managed by your account provider.", "Email đăng nhập được quản lý bởi nhà cung cấp tài khoản.")</small></div>
                            <div class="st-field"><label for="phone">@L["auth.phone"] <i class="bi bi-lock" aria-hidden="true"></i></label><div class="st-input-wrap is-readonly"><i class="bi bi-telephone" aria-hidden="true"></i><input id="phone" value="@phone" readonly placeholder="@Tx("Not provided", "Chưa cập nhật")" /></div></div>
                        </div>
                    </section>
                    <section class="st-card" aria-labelledby="st-linked-title"><header class="st-card-heading"><div><h3 id="st-linked-title">@L["settings.linkedAccounts"]</h3><p>@Tx("Your connected sign-in methods.", "Quản lý các phương thức đăng nhập của bạn.")</p></div><i class="bi bi-link-45deg st-heading-icon" aria-hidden="true"></i></header><div class="st-provider-list">
                        @foreach (var provider in linkedProviders)
                        {
                            <div class="st-provider"><span class="st-provider-logo" style="--provider-bg:@provider.Bg;--provider-color:@provider.Fg"><i class="bi @provider.Icon" aria-hidden="true"></i></span><div><strong>@provider.Name</strong><small>@(provider.Connected ? Tx("Connected to your account", "Đã liên kết với tài khoản") : provider.Available ? Tx("Available to connect", "Có thể liên kết") : Tx("Not supported yet", "Hiện chưa hỗ trợ"))</small></div>
                                @if (provider.Connected) { <span class="st-connected"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@Tx("Connected", "Đã liên kết")</span> }
                                else if (provider.Available) { <form action="/Account/PerformExternalLogin" method="post"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="/settings" /><button type="submit" name="provider" value="@provider.Scheme" class="st-button st-button-secondary">@L["settings.linked.connect"]<i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></form> }
                                else { <span class="st-unavailable">@Tx("Unavailable", "Chưa khả dụng")</span> }
                            </div>
                        }
                        @if (linkedProviders.Count == 0) { <p class="st-inline-note">@Tx("Sign-in providers could not be loaded. Your profile settings are still available.", "Chưa tải được phương thức đăng nhập. Bạn vẫn có thể chỉnh sửa hồ sơ.")</p> }
                    </div></section>
                }
                else if (tab == Tab.Learning)
                {
                    <section class="st-card"><header class="st-card-heading"><div><h3>@Tx("Your learning direction", "Định hướng học tập")</h3><p>@Tx("Build a plan that fits your goals and your pace.", "Lựa chọn mục tiêu và nhịp độ phù hợp với bạn.")</p></div><i class="bi bi-compass st-heading-icon" aria-hidden="true"></i></header>
                        <div class="st-card-body">
                            <fieldset class="st-choice-group"><legend>@L["profile.goal"]</legend><div class="st-goal-grid">@foreach (var goal in goals) { <button type="button" class="st-goal @(user.Goal == goal.Value ? "is-selected" : "")" aria-pressed="@(user.Goal == goal.Value ? "true" : "false")" @onclick="() => user.Goal = goal.Value"><i class="bi @goal.Key" aria-hidden="true"></i><span>@L[goal.Value]</span><i class="bi @(user.Goal == goal.Value ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i></button> }</div></fieldset>
                            <fieldset class="st-choice-group"><legend>@L["settings.prioritySkills"]</legend><p>@Tx("Select the skills you want to focus on.", "Bạn có thể chọn nhiều kỹ năng muốn tập trung.")</p><div class="st-chips">@if (skills is not null) { @foreach (var skill in skills) { <button type="button" class="st-chip @(selectedSkillIds.Contains(skill.Id) ? "is-selected" : "")" aria-pressed="@(selectedSkillIds.Contains(skill.Id) ? "true" : "false")" @onclick="() => ToggleSkill(skill.Id)"><i class="bi @skill.IconName" aria-hidden="true"></i>@Ui(skill.Name) @if (selectedSkillIds.Contains(skill.Id)) { <i class="bi bi-check2" aria-hidden="true"></i> }</button> } }</div></fieldset>
                            <fieldset class="st-choice-group"><legend>@L["settings.currentLevel"]</legend><div class="st-segment">@foreach (var level in new[] { LearningLevel.Beginner, LearningLevel.Intermediate, LearningLevel.Advanced }) { <button type="button" class="@(user.CurrentLevel == level ? "is-selected" : "")" aria-pressed="@(user.CurrentLevel == level ? "true" : "false")" @onclick="() => user.CurrentLevel = level">@L[$"settings.level.{level.ToString().ToLower()}"]</button> }</div></fieldset>
                        </div>
                    </section>
                    <section class="st-card"><header class="st-card-heading"><div><h3>@Tx("A rhythm that works for you", "Nhịp học của riêng bạn")</h3><p>@Tx("Small, consistent steps make a difference.", "Dành một chút thời gian mỗi ngày để tiến bộ.")</p></div><i class="bi bi-calendar-week st-heading-icon" aria-hidden="true"></i></header><div class="st-card-body">
                        <div class="st-form-grid st-form-grid-plain"><div class="st-field"><label for="dailyMinutes">@L["settings.dailyMinutes"]</label><select id="dailyMinutes" @bind="user.DailyStudyMinutes"><option value="0">@Tx("Not set", "Chưa thiết lập")</option>@foreach (var minutes in new[] { 15, 30, 45, 60, 90 }) { <option value="@minutes">@minutes @L["settings.minutes"]</option> }</select></div><div class="st-field"><label for="studyDays">@L["settings.daysPerWeek"]</label><select id="studyDays" @bind="user.StudyDaysPerWeek"><option value="0">@Tx("Not set", "Chưa thiết lập")</option>@for (var day = 1; day <= 7; day++) { <option value="@day">@day @Tx("days / week", "ngày / tuần")</option> }</select></div></div>
                        <fieldset class="st-choice-group"><legend>@L["settings.preferredTime"]</legend><div class="st-time-grid">@foreach (var time in new[] { StudyTime.Morning, StudyTime.Afternoon, StudyTime.Evening, StudyTime.Night }) { <button type="button" class="st-time @(user.PreferredStudyTime == time ? "is-selected" : "")" aria-pressed="@(user.PreferredStudyTime == time ? "true" : "false")" @onclick="() => user.PreferredStudyTime = time"><i class="bi @TimeIcon(time)" aria-hidden="true"></i>@L[$"settings.time.{time.ToString().ToLower()}"]</button> }</div></fieldset>
                    </div></section>
                }
                else if (tab == Tab.Appearance)
                {
                    <section class="st-card"><header class="st-card-heading"><div><h3>@Tx("A space that feels like you", "Không gian theo sở thích của bạn")</h3><p>@Tx("Preview changes as you make them.", "Các tùy chọn hiển thị được áp dụng ngay để bạn xem thử.")</p></div><i class="bi bi-palette2 st-heading-icon" aria-hidden="true"></i></header><div class="st-card-body">
                        <fieldset class="st-choice-group"><legend>@L["settings.language"]</legend><div class="st-segment"><button type="button" class="@(langCode == "vi" ? "is-selected" : "")" aria-pressed="@(langCode == "vi" ? "true" : "false")" @onclick='() => SetLanguage("vi")'>🇻🇳 Tiếng Việt</button><button type="button" class="@(langCode == "en" ? "is-selected" : "")" aria-pressed="@(langCode == "en" ? "true" : "false")" @onclick='() => SetLanguage("en")'>English</button></div></fieldset>
                        <fieldset class="st-choice-group"><legend>@L["settings.theme"]</legend><div class="st-theme-grid">@foreach (var theme in new[] { ThemePreference.Light, ThemePreference.Dark, ThemePreference.System }) { <button type="button" class="st-theme @(user.Theme == theme ? "is-selected" : "")" aria-pressed="@(user.Theme == theme ? "true" : "false")" @onclick="() => SetTheme(theme)"><span class="st-theme-preview st-theme-@theme.ToString().ToLower()" aria-hidden="true"><span></span><span></span><span></span></span><span><i class="bi @(theme == ThemePreference.Light ? "bi-sun" : theme == ThemePreference.Dark ? "bi-moon-stars" : "bi-display")" aria-hidden="true"></i>@L[$"settings.theme.{theme.ToString().ToLower()}"]<i class="bi @(user.Theme == theme ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i></span></button> }</div></fieldset>
                        <fieldset class="st-choice-group"><legend>@Tx("Text size", "Cỡ chữ")</legend><div class="st-segment">@foreach (var size in new[] { "small", "normal", "large" }) { <button type="button" class="@(fontScale == size ? "is-selected" : "")" aria-pressed="@(fontScale == size ? "true" : "false")" @onclick="() => SetFontScale(size)"><span class="st-font-@size">Aa</span> @FontLabel(size)</button> }</div></fieldset>
                        <div class="st-toggle-row"><div><label for="reduceMotion">@L["settings.reduceMotion"]</label><p>@L["settings.reduceMotion.hint"]</p></div><input id="reduceMotion" class="st-switch" type="checkbox" role="switch" checked="@user.ReduceMotion" @onchange="OnReduceMotionChanged" /></div>
                        <div class="st-toggle-row"><div><label for="highContrast">@Tx("High contrast", "Tương phản cao")</label><p>@Tx("Make text, borders and controls easier to see.", "Giúp chữ, đường viền và nút bấm dễ nhận biết hơn.")</p></div><input id="highContrast" class="st-switch" type="checkbox" role="switch" checked="@highContrast" @onchange="OnHighContrastChanged" /></div>
                        <p class="st-device-note"><i class="bi bi-laptop" aria-hidden="true"></i>@Tx("Text size and contrast are remembered on this device.", "Cỡ chữ và độ tương phản được ghi nhớ trên thiết bị này.")</p>
                    </div></section>
                }
                else if (tab == Tab.Security)
                {
                    <section class="st-card"><header class="st-card-heading"><div><h3>@L["settings.password.title"]</h3><p>@Tx("Use a unique password to keep your account secure.", "Sử dụng mật khẩu riêng để bảo vệ tài khoản của bạn.")</p></div><i class="bi bi-key st-heading-icon" aria-hidden="true"></i></header>
                        <form class="st-card-body st-password-form" action="/Account/ChangePassword" method="post" data-enhance="false"><AntiforgeryToken /><input type="hidden" name="_handler" value="change-password" />
                            @if (hasLocalPassword) { <div class="st-field"><label for="settings-current-password">@L["settings.password.current"]</label><input id="settings-current-password" name="Input.OldPassword" type="@(showPasswords ? "text" : "password")" autocomplete="current-password" required /></div> }
                            <div class="st-field"><label for="settings-new-password">@L["settings.password.new"]</label><input id="settings-new-password" name="Input.NewPassword" type="@(showPasswords ? "text" : "password")" autocomplete="new-password" minlength="6" maxlength="100" required @bind="newPassword" @bind:event="oninput" aria-describedby="st-password-hint" /><small id="st-password-hint">@Tx("At least 6 characters. Avoid reusing a password.", "Tối thiểu 6 ký tự. Hạn chế dùng lại mật khẩu cũ.")</small></div>
                            <div class="st-field"><label for="settings-confirm-password">@L["settings.password.confirm"]</label><input id="settings-confirm-password" name="Input.ConfirmPassword" type="@(showPasswords ? "text" : "password")" autocomplete="new-password" minlength="6" maxlength="100" required @bind="confirmPassword" @bind:event="oninput" aria-invalid="@(confirmPassword.Length > 0 && newPassword != confirmPassword ? "true" : null)" />@if (confirmPassword.Length > 0 && newPassword != confirmPassword) { <small class="st-error" role="status">@Tx("The passwords do not match.", "Mật khẩu nhập lại chưa khớp.")</small> }</div>
                            <label class="st-check-label"><input type="checkbox" @bind="showPasswords" />@Tx("Show passwords", "Hiển thị mật khẩu")</label><div><button type="submit" class="st-button st-button-primary" disabled="@(newPassword.Length < 6 || newPassword != confirmPassword)"><i class="bi bi-lock" aria-hidden="true"></i>@L["settings.password.submit"]</button></div>
                        </form>
                    </section>
                    <details class="st-card st-danger"><summary><span class="st-danger-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span><span><strong>@Tx("Account management", "Quản lý tài khoản")</strong><small>@Tx("Pause or permanently delete your account.", "Tạm khóa hoặc xóa vĩnh viễn tài khoản.")</small></span><i class="bi bi-chevron-down" aria-hidden="true"></i></summary><div class="st-card-body"><div class="st-action-row"><div><h3>@L["settings.suspend.title"]</h3><p>@L["settings.suspend.hint"]</p></div><button type="button" class="st-button st-button-secondary" @onclick="() => showSuspend = true">@L["settings.suspend.button"]</button></div><div class="st-action-row"><div><h3>@L["settings.delete.title"]</h3><p>@L["settings.delete.hint"]</p></div><button type="button" class="st-button st-button-danger" @onclick="() => showDelete = true">@L["settings.delete.button"]</button></div></div></details>
                }
                else if (tab == Tab.Notifications)
                {
                    <section class="st-card st-notifications"><span class="st-feature-icon"><i class="bi bi-bell" aria-hidden="true"></i><span></span></span><h3>@Tx("Stay in the loop", "Đừng bỏ lỡ điều quan trọng")</h3><p>@Tx("Find announcements and updates from SoftSync in your notification inbox.", "Theo dõi thông báo và cập nhật từ SoftSync trong hộp thông báo của bạn.")</p><a href="/notifications" class="st-button st-button-primary">@Tx("Open notification inbox", "Mở hộp thông báo")<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><div class="st-coming-soon"><i class="bi bi-clock-history" aria-hidden="true"></i><div><strong>@Tx("More options are on the way", "Thêm lựa chọn trong thời gian tới")</strong><p>@Tx("Automatic study reminders and community subscriptions are not available yet.", "Nhắc học tự động và đăng ký thông báo cộng đồng hiện chưa khả dụng.")</p></div></div></section>
                }
                else if (tab == Tab.Privacy)
                {
                    <section class="st-card"><header class="st-card-heading"><div><h3>@Tx("Your information, thoughtfully handled", "Thông tin của bạn được tôn trọng")</h3><p>@Tx("Know what is shared and what stays in your account.", "Hiểu rõ những gì được chia sẻ và lưu trong tài khoản.")</p></div><i class="bi bi-shield-lock st-heading-icon" aria-hidden="true"></i></header><div class="st-card-body st-privacy-list"><article><span><i class="bi bi-person-lock" aria-hidden="true"></i></span><div><h3>@Tx("A personal learning profile", "Hồ sơ học tập cá nhân")</h3><p>@Tx("Your profile and learning records are accessed through your signed-in account. Public learner profiles and public leaderboards are not available.", "Bạn truy cập hồ sơ và kết quả học qua tài khoản đăng nhập. SoftSync hiện chưa có hồ sơ học viên hoặc bảng xếp hạng công khai.")</p></div></article><article><span><i class="bi bi-chat-square-heart" aria-hidden="true"></i></span><div><h3>@Tx("Share with intention", "Chủ động khi chia sẻ")</h3><p>@Tx("When asking a mentor for support, only share the context you choose. Your Reflection text is not attached automatically.", "Khi nhờ Mentor hỗ trợ, bạn chủ động chọn ngữ cảnh muốn gửi. Nội dung phản tư không được tự động đính kèm.")</p></div></article></div></section>
                    <section class="st-card st-support-card"><header class="st-card-heading"><div><h3>@Tx("Support & information", "Hỗ trợ & thông tin")</h3></div></header><SupportOptionLinks /></section>
                }
                else if (tab == Tab.Danger)
                {
                    <section class="st-card st-plan"><span class="st-soft-tag">SOFTSYNC FREE</span><h3>@Tx("Your space to grow", "Không gian để bạn phát triển")</h3><p>@Tx("You are currently using the free plan.", "Bạn đang sử dụng gói miễn phí của SoftSync.")</p><div class="st-plan-price">0 <span>₫ / @Tx("month", "tháng")</span></div><div class="st-inline-note"><i class="bi bi-info-circle" aria-hidden="true"></i>@Tx("Paid subscriptions and payments are not available yet. No action is needed.", "Gói trả phí và thanh toán hiện chưa được mở. Bạn không cần thực hiện thêm thao tác nào.")</div></section>
                }
                @if (tab is Tab.Account or Tab.Learning or Tab.Appearance)
                {
                    <footer class="st-save-bar"><div class="st-save-state" role="status"><i class="bi @(HasUnsavedChanges ? "bi-pencil-square" : "bi-cloud-check")" aria-hidden="true"></i><span>@(saving ? Tx("Saving your preferences…", "Đang lưu tùy chọn của bạn…") : HasUnsavedChanges ? Tx("You have unsaved changes", "Bạn có thay đổi chưa lưu") : Tx("Your preferences are up to date", "Cài đặt của bạn đã được cập nhật"))</span></div><button type="button" class="st-button st-button-primary" @onclick="SaveAsync" disabled="@(saving || !HasUnsavedChanges)"><i class="bi @(saving ? "bi-arrow-repeat" : "bi-check2")" aria-hidden="true"></i>@(saving ? Tx("Saving…", "Đang lưu…") : L["settings.save"])</button></footer>
                }
                @if (!string.IsNullOrEmpty(savedMessage)) { <div class="st-feedback @(saveFailed ? "st-feedback-error" : "st-feedback-success")" @key="toastSeq" role="@(saveFailed ? "alert" : "status")"><i class="bi @(saveFailed ? "bi-exclamation-circle" : "bi-check-circle")" aria-hidden="true"></i>@savedMessage</div> }
            </section>
        </div>
        </fieldset>
        <footer class="st-page-footer"><span>SoftSync <span aria-hidden="true">·</span> @Tx("Learn. Connect. Grow.", "Học hỏi. Kết nối. Phát triển.")</span><a href="/about">@Tx("About SoftSync", "Về SoftSync")<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></footer>
    }
</div>
@if (showSuspend || showDelete)
{
    <div class="st-dialog-backdrop" @onclick="CloseDialogs" @onkeydown="DialogKeyDown">
        <section class="st-dialog" role="dialog" aria-modal="true" aria-labelledby="st-dialog-title" @onclick:stopPropagation="true" tabindex="-1" @ref="dialogElement">
            <button type="button" class="st-dialog-close" @onclick="CloseDialogs" aria-label="@Tx("Close", "Đóng")"><i class="bi bi-x-lg" aria-hidden="true"></i></button><span class="st-danger-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span><h2 id="st-dialog-title">@(showDelete ? L["settings.delete.title"] : L["settings.suspend.title"])</h2><p>@(showDelete ? L["settings.delete.confirm"] : L["settings.suspend.confirm"])</p>
            @if (showDelete) { <label for="st-delete-confirm">@L["settings.delete.typePrompt"] <strong>@DeleteWord</strong></label><input id="st-delete-confirm" @bind="deleteConfirmText" @bind:event="oninput" autocomplete="off" placeholder="@DeleteWord" /> }
            <form action="@(showDelete ? "/Account/DeleteAccount" : "/Account/Suspend")" method="post" data-enhance="false"><AntiforgeryToken /><button type="button" class="st-button st-button-secondary" @onclick="CloseDialogs">@L["logout.confirm.cancel"]</button><button type="submit" class="st-button st-button-danger" disabled="@(showDelete && !DeleteConfirmed)">@(showDelete ? L["settings.delete.button"] : L["settings.suspend.button"])</button></form>
        </section>
    </div>
}

@code {
    private string Tx(string en, string vi) => L.Current == AppLanguage.Vi ? vi : en;

    private enum Tab { Account, Learning, Notifications, Appearance, Privacy, Danger, Security }
    private record SettingsSection(Tab Value, string Icon, string Title, string Description);
    private SettingsSection[] Sections => [
        new(Tab.Account, "bi-person", Tx("Profile", "Hồ sơ cá nhân"), Tx("Details & connected accounts", "Thông tin & tài khoản liên kết")),
        new(Tab.Security, "bi-shield-check", Tx("Security", "Bảo mật"), Tx("Password & account access", "Mật khẩu & quản lý tài khoản")),
        new(Tab.Learning, "bi-mortarboard", Tx("Learning", "Học tập"), Tx("Goals & study rhythm", "Mục tiêu & nhịp học")),
        new(Tab.Notifications, "bi-bell", Tx("Notifications", "Thông báo"), Tx("Stay up to date", "Cập nhật dành cho bạn")),
        new(Tab.Appearance, "bi-palette", Tx("Appearance", "Giao diện"), Tx("Display & language", "Hiển thị & ngôn ngữ")),
        new(Tab.Privacy, "bi-fingerprint", Tx("Privacy", "Quyền riêng tư"), Tx("Your information & support", "Thông tin & hỗ trợ")),
        new(Tab.Danger, "bi-credit-card", Tx("Your plan", "Gói sử dụng"), Tx("Your current subscription", "Thông tin gói hiện tại"))
    ];
    private SettingsSection ActiveSection => Sections.First(x => x.Value == tab);
    private string SectionDescription => tab switch {
        Tab.Account => Tx("Manage the details that make this space yours.", "Quản lý thông tin để không gian này mang dấu ấn của bạn."),
        Tab.Security => Tx("A few simple steps to keep your account safe.", "Chủ động bảo vệ tài khoản và thông tin đăng nhập."),
        Tab.Learning => Tx("Shape a learning plan around your everyday life.", "Thiết kế hành trình học phù hợp với cuộc sống của bạn."),
        Tab.Notifications => Tx("Keep up with the things that matter to you.", "Theo dõi những cập nhật quan trọng dành cho bạn."),
        Tab.Appearance => Tx("Make every visit comfortable and familiar.", "Tùy chỉnh để mỗi lần học đều thoải mái và quen thuộc."),
        Tab.Privacy => Tx("Understand how your learning information is shared.", "Hiểu rõ cách thông tin học tập của bạn được chia sẻ."),
        _ => Tx("Everything about your current SoftSync plan.", "Thông tin về gói SoftSync bạn đang sử dụng.")
    };
    private static string TimeIcon(StudyTime time) => time switch { StudyTime.Morning => "bi-sunrise", StudyTime.Afternoon => "bi-sun", StudyTime.Evening => "bi-sunset", _ => "bi-moon-stars" };
    private string FontLabel(string size) => size switch { "small" => Tx("Small", "Nhỏ"), "large" => Tx("Large", "Lớn"), _ => Tx("Normal", "Vừa") };
    private bool showPasswords;
    private string newPassword = "", confirmPassword = "";
    private string? savedSnapshot;
    private bool HasUnsavedChanges => savedSnapshot is not null && savedSnapshot != SettingsSnapshot();
    private string SettingsSnapshot() => System.Text.Json.JsonSerializer.Serialize(new {
        user?.FullName, user?.DisplayName, user?.Age, user?.Gender, user?.Goal, user?.CurrentLevel,
        user?.DailyStudyMinutes, user?.StudyDaysPerWeek, user?.PreferredStudyTime,
        Language = L.Code, user?.Theme, user?.ReduceMotion, fontScale, highContrast,
        Skills = selectedSkillIds.Order().ToArray()
    });
    private ElementReference dialogElement;
    private IJSObjectReference? settingsModule;
    private Tab? renderedSection;
    private bool dialogWasOpen;
    private void CloseDialogs() { showSuspend = false; CancelDelete(); }
    private void DialogKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") CloseDialogs(); }
    private Tab tab = Tab.Account;
    [SupplyParameterFromQuery(Name = "section")] public string? RequestedSection { get; set; }
    protected override void OnParametersSet()
    {
        if (Enum.TryParse<Tab>(RequestedSection, true, out var requested) && Enum.IsDefined(requested))
        {
            tab = requested;
        }
    }

    private const long MaxAvatarBytes = 3 * 1024 * 1024;
    private UserDto? user;
    private int userId;
    private string? email;
    private string? phone;
    private bool hasLocalPassword;
    private string langCode => L.Code;

    private IEnumerable<SkillDto>? skills;
    private readonly List<int> selectedSkillIds = new();

    // Hero stats
    private int trackedSkillCount;
    private int assessedSkillCount;

    // Linked account rows for the mockup grid.
    private record LinkedProvider(string Scheme, string Name, string Icon, string Bg, string Fg, bool Available, bool Connected);
    private List<LinkedProvider> linkedProviders = new();

    // Preset goals stored as translation keys (same set as the onboarding wizard),
    // so the saved value stays language-agnostic and re-translates on display.
    private readonly (string Key, string Value)[] goals =
    {
        ("bi-chat-dots", "wizard.goal.communication"),
        ("bi-briefcase", "wizard.goal.internship"),
        ("bi-trophy", "wizard.goal.leadership"),
        ("bi-people", "wizard.goal.teamwork")
    };

    private bool saving;
    private bool interactiveReady;
    private bool saveFailed;
    private string? savedMessage;
    private int toastSeq; // bumped each save so the toast remounts and replays its animation
    private string? avatarError;
    private bool loadFailed;
    private string fontScale = "normal";
    private bool highContrast;

    private bool showSuspend;
    private bool showDelete;
    private string deleteConfirmText = "";
    private string DeleteWord => L["settings.delete.word"];
    private bool DeleteConfirmed => string.Equals(deleteConfirmText.Trim(), DeleteWord, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        userId = state.User.GetUserId();
        email = state.User.FindFirst(ClaimTypes.Email)?.Value ?? state.User.Identity?.Name;
        phone = state.User.FindFirst(ClaimTypes.MobilePhone)?.Value;

        try
        {
            user = await UserService.GetUserByIdAsync(userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Settings profile failed for user {UserId}", userId);
            loadFailed = true;
            return;
        }
        if (user is null)
        {
            Logger.LogWarning("Settings could not load user profile for authenticated user {UserId}", userId);
            loadFailed = true;
            return;
        }

        try
        {
        skills = await SkillService.GetAllSkillsAsync();
        selectedSkillIds.AddRange(await UserService.GetSelectedSkillIdsAsync(userId));

        // Hero stats — pull real data where we have it.
        var results = await AssessmentService.GetLatestResultsAsync(userId, userId);
        assessedSkillCount = results.Select(x => x.SkillId).Distinct().Count();
        var progress = await ProgressService.GetUserProgressAsync(userId);
        trackedSkillCount = progress.Count();

        // Which external logins are currently linked to this user, and which are configured on the server.
        var appUser = await UserManagerSvc.FindByIdAsync(userId.ToString());
        hasLocalPassword = appUser is not null && await UserManagerSvc.HasPasswordAsync(appUser);
        var currentLogins = appUser is null ? new HashSet<string>() :
            (await UserManagerSvc.GetLoginsAsync(appUser)).Select(l => l.LoginProvider).ToHashSet();
        var configured = (await SignInManagerSvc.GetExternalAuthenticationSchemesAsync())
            .Select(s => s.Name).ToHashSet();

        linkedProviders = new()
        {
            new("Google",    "Google",    "bi-google",    "#fee2e2", "#dc2626", configured.Contains("Google"),    currentLogins.Contains("Google")),
            new("GitHub",    "GitHub",    "bi-github",    "#1f2937", "#f9fafb", configured.Contains("GitHub"),    currentLogins.Contains("GitHub")),
            new("Facebook",  "Facebook",  "bi-facebook",  "#dbeafe", "#1d4ed8", configured.Contains("Facebook"),  currentLogins.Contains("Facebook")),
            new("Microsoft", "Microsoft", "bi-microsoft", "#e0f2fe", "#0369a1", configured.Contains("Microsoft"), currentLogins.Contains("Microsoft")),
        };
        }
        catch (Exception ex)
        {
            // Skill/stat/provider panels are optional. Keep account settings usable
            // even when one of those data sources is temporarily unavailable.
            Logger.LogWarning(ex, "Optional Settings data failed for user {UserId}", userId);
            skills ??= [];
            linkedProviders = [];
        }

        if (user is not null && string.IsNullOrEmpty(user.PreferredLanguage))
            user.PreferredLanguage = langCode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On a fresh browser (empty localStorage) seed the theme from the value
        // saved to the user's account. Won't override a choice made on this device.
        if (firstRender && user is not null)
        {
            var theme = await JS.InvokeAsync<ThemeState>("ssTheme.syncFromServer",
                user.Theme.ToString().ToLower(), user.ReduceMotion);
            if (Enum.TryParse<ThemePreference>(theme.Preference, true, out var preference))
                user.Theme = preference;
            user.ReduceMotion = theme.ReduceMotion;
            fontScale = await JS.InvokeAsync<string>("ssFontSize.init");
            highContrast = await JS.InvokeAsync<bool>("ssContrast.init");
            interactiveReady = true;
            savedSnapshot = SettingsSnapshot();
            StateHasChanged();
        }
        var dialogOpen = showSuspend || showDelete;
        if (interactiveReady && renderedSection != tab)
        {
            settingsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/settings-accessibility.js");
            await settingsModule.InvokeVoidAsync("revealSection", tab.ToString());
            renderedSection = tab;
        }
        if (dialogOpen != dialogWasOpen)
        {
            settingsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/settings-accessibility.js");
            if (dialogOpen) await settingsModule.InvokeVoidAsync("openDialog", dialogElement);
            else await settingsModule.InvokeVoidAsync("closeDialog");
        }
        dialogWasOpen = dialogOpen;
    }

    private void ToggleSkill(int id)
    {
        if (!selectedSkillIds.Remove(id)) selectedSkillIds.Add(id);
    }

    private void OnAgeGroupChanged(ChangeEventArgs e)
    {
        if (user is not null && e.Value is string group)
            user.Age = ProfileAgeGroups.Select(group, user.Age);
    }

    private async Task SelectTabAsync(Tab next)
    {
        tab = next;
        savedMessage = null;
        newPassword = confirmPassword = "";
        showPasswords = false;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("section", next.ToString()), replace: true);
        if (next != Tab.Appearance || user is null) return;
        var theme = await JS.InvokeAsync<ThemeState>("ssTheme.get");
        if (Enum.TryParse<ThemePreference>(theme.Preference, true, out var preference))
            user.Theme = preference;
        user.ReduceMotion = theme.ReduceMotion;
        fontScale = await JS.InvokeAsync<string>("ssFontSize.init");
        highContrast = await JS.InvokeAsync<bool>("ssContrast.init");
    }

    private async Task SetLanguage(string code)
    {
        if (user is not null) user.PreferredLanguage = code;
        await JS.InvokeVoidAsync("ssLang.set", code);
        L.SetLanguage(LocalizationService.Parse(code));
    }

    private async Task SetTheme(ThemePreference th)
    {
        if (user is null) return;
        user.Theme = th;
        await JS.InvokeVoidAsync("ssTheme.set", th.ToString().ToLower(), user.ReduceMotion);
    }

    private async Task SetFontScale(string scale)
    {
        fontScale = scale;
        await JS.InvokeVoidAsync("ssFontSize.set", scale);
    }

    private async Task OnReduceMotionChanged(ChangeEventArgs e)
    {
        if (user is null) return;
        var theme = await JS.InvokeAsync<ThemeState>("ssTheme.get");
        if (Enum.TryParse<ThemePreference>(theme.Preference, true, out var preference))
            user.Theme = preference;
        user.ReduceMotion = e.Value is bool b && b;
        await JS.InvokeVoidAsync("ssTheme.set", user.Theme.ToString().ToLower(), user.ReduceMotion);
    }

    private async Task OnHighContrastChanged(ChangeEventArgs e)
    {
        highContrast = e.Value is bool enabled && enabled;
        await JS.InvokeVoidAsync("ssContrast.set", highContrast);
    }

    private async Task SaveAsync()
    {
        if (user is null || saving) return;
        saving = true;
        saveFailed = false;
        savedMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(user.FullName) || user.FullName.Trim().Length > 100
                || user.DisplayName.Length > 60 || user.Age is < 0 or > 120)
            {
                saveFailed = true;
                savedMessage = Tx("Enter a full name (up to 100 characters), a display name of up to 60 characters, and an age from 0 to 120.",
                    "Hãy nhập họ tên (tối đa 100 ký tự), tên hiển thị tối đa 60 ký tự và tuổi từ 0 đến 120.");
                toastSeq++;
                return;
            }
            var theme = await JS.InvokeAsync<ThemeState>("ssTheme.get");
            if (Enum.TryParse<ThemePreference>(theme.Preference, true, out var preference))
                user.Theme = preference;
            user.ReduceMotion = theme.ReduceMotion;
            user.PreferredLanguage = L.Code;
            user.FullName = user.FullName.Trim();
            user.DisplayName = user.DisplayName.Trim();
            await UserService.UpdateSettingsAsync(userId, user);
            await UserService.AddSkillSelectionsAsync(userId, selectedSkillIds);
            UserProfileState.NotifyDisplayNameChanged(user.PublicName);
            savedSnapshot = SettingsSnapshot();
            savedMessage = L["settings.saved"];
            toastSeq++; // bump so the toast remounts and replays its animation
        }
        catch (Exception ex)
        {
            saveFailed = true;
            toastSeq++;
            Logger.LogError(ex, "Settings could not be saved for user {UserId}", userId);
            savedMessage = Tx("Could not save all settings. Please retry.", "Chưa lưu được đầy đủ cài đặt. Vui lòng thử lại.");
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class ThemeState
    {
        public string Preference { get; set; } = "light";
        public bool ReduceMotion { get; set; }
    }

    private void CancelDelete()
    {
        showDelete = false;
        deleteConfirmText = "";
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        avatarError = null;
        var file = e.File;
        if (file is null || user is null) return;
        if (file.Size > MaxAvatarBytes) { avatarError = L["profile.avatar.tooLarge"]; return; }
        if (!file.ContentType.StartsWith("image/")) { avatarError = L["profile.avatar.notImage"]; return; }

        try
        {
            user.AvatarUrl = await ToDataUrlAsync(file);
            await UserService.SetAvatarAsync(userId, user.AvatarUrl);
            UserProfileState.NotifyAvatarChanged(user.AvatarUrl);
        }
        catch (Exception ex)
        {
            avatarError = L["profile.avatar.uploadFailed"] + " " + ex.Message;
        }
    }

    private static async Task<string> ToDataUrlAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxAvatarBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }

    public async ValueTask DisposeAsync()
    {
        if (settingsModule is null) return;
        try
        {
            await settingsModule.InvokeVoidAsync("closeDialog");
            await settingsModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
