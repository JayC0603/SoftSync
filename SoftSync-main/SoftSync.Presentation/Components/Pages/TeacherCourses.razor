@inherits LocalizedComponentBase
@page "/teacher"
@page "/teacher/courses"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SoftSync.BLL.Auth.CourseAuthorization.TeacherPolicy)]
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@using SoftSync.Common.Enums
@using SoftSync.Presentation.Services
@inject ICourseService Courses
@inject IChallengeService Challenges
@inject AuthenticationStateProvider Auth
@inject CourseUploadService Uploads

@inject ISkillService Skills
@inject IJSRuntime JS

<PageTitle>@Ui.Text("Teacher Studio · SoftSync")</PageTitle>
<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="ConfirmNavigation" />
<main class="ss-workspace" aria-busy="@busy">
<PageHeader Title="@Tx("Teacher Studio", "Không gian giảng dạy")" Eyebrow="@Tx("CREATE • TEACH • IMPROVE", "TẠO NỘI DUNG • GIẢNG DẠY • PHÁT TRIỂN")" Description="@Tx("Build your course, add lessons, then prepare the final quiz.", "Tạo khóa học, thêm bài học và chuẩn bị bài kiểm tra cuối khóa.")" />
@if(busy){<LoadingState Text="@Tx("Processing your content…", "Đang xử lý nội dung…")" />}
@if(!string.IsNullOrWhiteSpace(message)){<div class="alert ss-editor-feedback @(error?"alert-danger":"alert-success")" role="@(error?"alert":"status")" @key="message"><i class="bi @(error?"bi-exclamation-circle":"bi-check-circle")" aria-hidden="true"></i> @Ui.Text(message)</div>}
<div class="ss-studio-layout">
<aside class="ss-panel"><h2>@Ui.Text("My Courses")</h2><button type="button" class="btn btn-primary mb-3" disabled="@busy" @onclick="()=>ChangeCourse(null)"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Ui.Text("Create Course")</button>
<label for="managed-course-search" class="form-label">@Tx("Find your course", "Tìm khóa học của bạn")</label><input id="managed-course-search" class="form-control mb-3" type="search" @bind="search" @bind:event="oninput" />
@if(!FilteredCourses.Any()){<p class="ss-muted">@Tx("No courses yet. Create your first course to begin.", "Chưa có khóa học. Tạo khóa học đầu tiên để bắt đầu.")</p>}
<div class="ss-studio-list">@foreach(var item in FilteredCourses){<button type="button" disabled="@busy" aria-pressed="@(course.Id==item.Id)" @onclick="()=>ChangeCourse(item.Id)"><strong class="d-block">@item.Title</strong><small>@Ui.Text(item.Status.ToString()) · @item.Lessons.Count @Ui.Text("Lessons")</small></button>}</div>
</aside>
<section class="ss-panel">
@if(!standaloneQuiz){
<nav class="ss-builder-nav" aria-label="@Tx("Course builder sections", "Các phần biên soạn khóa học")">
<button type="button" disabled="@busy" aria-pressed="@(panel==0)" @onclick="()=>ChangePanel(0)">@Tx("1. Details", "1. Thông tin")</button>
<button type="button" disabled="@(busy||course.Id==0)" aria-pressed="@(panel==1)" @onclick="()=>ChangePanel(1)">@Tx("2. Lessons", "2. Bài học")</button>
<button type="button" disabled="@(busy||course.Id==0)" aria-pressed="@(panel==2)" @onclick="()=>ChangePanel(2)">@Tx("3. Final quiz", "3. Kiểm tra cuối khóa")</button>
</nav>
}
<p class="ss-muted" role="status">@(Dirty?Tx("Unsaved changes — remember to save before leaving.","Có thay đổi chưa lưu — hãy lưu trước khi rời trang."):Tx("Changes are saved only when you choose Save.","Thay đổi chỉ được lưu khi bạn chọn Lưu."))</p>
<fieldset disabled="@busy">
<div class="ss-editor-content" @key="editorVersion">
@if(panel==0){
<h2>@(course.Id==0?Ui.Text("Create Course"):Ui.Text("Edit Course"))</h2>
<label class="form-label" for="course-title">@Ui.Text("Title")</label><input id="course-title" class="form-control" maxlength="200" @bind="course.Title" />
<label class="form-label tw:mt-3" for="course-description">@Ui.Text("Description")</label><textarea id="course-description" class="form-control" @bind="course.Description"></textarea>
<label class="form-label" for="course-skill">@Tx("Skill", "Kỹ năng")</label><select id="course-skill" class="form-select" @bind="course.SkillId">@foreach(var s in skills){<option value="@s.Id">@SkillName(s)</option>}</select>
<details class="ss-builder-section"><summary>@Tx("Course appearance", "Ảnh khóa học")</summary><label class="form-label tw:mt-3" for="thumbnail-url">@Ui.Text("Thumbnail URL")</label><input id="thumbnail-url" class="form-control" @bind="course.ThumbnailUrl" />
<label class="form-label tw:mt-2" for="thumbnail-file">@Ui.Text("Or upload thumbnail (JPG, PNG, WEBP; max 5 MB)")</label><InputFile id="thumbnail-file" class="form-control" OnChange="UploadThumbnail" accept=".jpg,.jpeg,.png,.webp" />
<label class="form-label tw:mt-3" for="thumbnail-alt">@Ui.Text("Thumbnail alt text")</label><input id="thumbnail-alt" class="form-control" maxlength="300" aria-describedby="thumbnail-alt-help" @bind="course.ThumbnailAltText" /><div id="thumbnail-alt-help" class="form-text">@Ui.Text("Describe meaningful information in the image; leave empty only when it is decorative.")</div>
</details>
<div class="ss-action-bar ss-sticky-actions"><SaveButton Busy="@saving" Disabled="@busy" OnClick="()=>Run(SaveCourse, true)" />
@if(course.Id>0){<button type="button" class="btn btn-outline-primary" @onclick="()=>Run(PublishCourse)" disabled="@(Dirty||course.Lessons.Count==0||course.Status==CourseStatus.Published)">@Ui.Text("Publish")</button><a href="/teacher/courses/@course.Id/analytics">@Ui.Text("Course analytics")</a>}</div>
@if(course.Id==0){<p class="ss-muted">@Tx("Save this course first to add lessons and a quiz.", "Lưu khóa học trước để thêm bài học và bài kiểm tra.")</p>}
}
else if(panel==1){
<h2>@Ui.Text("Lessons")</h2><p class="ss-muted">@Tx("Keep lessons focused. A video needs captions or a transcript.", "Mỗi bài tập trung vào một nội dung. Video cần phụ đề hoặc bản chép lời.")</p>
<ol>@foreach(var item in course.Lessons.OrderBy(x=>x.Order)){<li class="mb-2">@item.Title <button type="button" class="btn btn-sm btn-link" @onclick="()=>EditLesson(item)">@Ui.Text("Edit")</button></li>}</ol>
<button type="button" class="btn btn-outline-primary mb-3" @onclick="NewLesson">@Ui.Text("Add lesson")</button>
<h3>@(lesson.Id==0?Tx("New lesson", "Bài học mới"):Tx("Edit lesson", "Sửa bài học"))</h3>
<label class="form-label" for="lesson-title">@Ui.Text("Lesson title")</label><input id="lesson-title" class="form-control" @bind="lesson.Title" />
<label class="form-label" for="lesson-description">@Ui.Text("Description")</label><textarea id="lesson-description" class="form-control" @bind="lesson.Description"></textarea><details class="ss-builder-section" open><summary>@Tx("Video & captions", "Video & phụ đề")</summary><label class="form-label tw:mt-2" for="video-url">@Ui.Text("Video URL (.mp4/.webm)")</label><input id="video-url" class="form-control" @bind="lesson.VideoUrl" />
<label class="form-label tw:mt-2" for="video-file">@Ui.Text("Or upload video (max 200 MB)")</label><InputFile id="video-file" class="form-control" OnChange="UploadVideo" accept=".mp4,.webm" />
<label class="form-label tw:mt-2" for="caption-url">@Ui.Text("Caption URL (.vtt)")</label><input id="caption-url" class="form-control" @bind="lesson.CaptionUrl" />
</details><label class="form-label tw:mt-2" for="transcript">@Ui.Text("Transcript")</label><textarea id="transcript" class="form-control" @bind="lesson.Transcript"></textarea>

<div class="ss-action-bar ss-sticky-actions"><SaveButton Busy="@saving" Disabled="@busy" OnClick="()=>Run(SaveLesson, true)" /></div>
<details><summary>@Tx("Preview lesson", "Xem trước bài học")</summary><h3>@lesson.Title</h3><LessonMedia Lesson="@lesson" /></details>
}
else if(panel==2){
<h2>@Ui.Text("Final Quiz")</h2>
<p class="ss-muted">@Tx("Add any number of questions (at least one), with four options and one correct answer per question. Passing requires at least 50% correct.", "Thêm số câu tùy ý (ít nhất 1 câu), mỗi câu 4 lựa chọn và 1 đáp án đúng. Đạt khi trả lời đúng ít nhất 50%.")</p>
@if(quiz.Id==0){<label class="form-label" for="quiz-title">@Ui.Text("Quiz title")</label><input id="quiz-title" class="form-control" @bind="quiz.Title" /><button class="btn btn-primary mt-3" type="button" @onclick="()=>Run(CreateQuiz)">@Ui.Text("Create quiz")</button>}
else {
<p><strong>@quiz.Title</strong> · @quiz.Questions.Count @Tx("questions", "câu hỏi") · @Ui.Text(quiz.Status.ToString())</p>
<div class="ss-action-bar"><a href="/teacher/quizzes/@quiz.Id/results">@Ui.Text("Learner results")</a><a href="/teacher/quizzes/@quiz.Id/analytics">@Ui.Text("Quiz analytics")</a></div>
<ol>@foreach(var item in quiz.Questions.OrderBy(x=>x.Order)){<li>@item.QuestionText @if(quiz.Status==CourseStatus.Draft){<button class="btn btn-link btn-sm" type="button" @onclick="()=>EditQuestion(item)">@Ui.Text("Edit")</button>}</li>}</ol>
@if(quiz.Status==CourseStatus.Draft){
<fieldset><legend>@(question.Id==0?Ui.Text("Add question"):Tx("Edit question","Sửa câu hỏi"))</legend>
<label class="form-label" for="question-type">@Ui.Text("Question type")</label><select id="question-type" class="form-select" @bind="question.Type"><option value="@ChallengeQuestionType.Knowledge">@Ui.Text("Knowledge")</option><option value="@ChallengeQuestionType.Scenario">@Ui.Text("Scenario")</option></select>
<label class="form-label" for="question-text">@Ui.Text("Question")</label><textarea id="question-text" class="form-control" @bind="question.QuestionText"></textarea>
<label class="form-label tw:mt-2" for="scenario">@Ui.Text("Scenario")</label><textarea id="scenario" class="form-control" @bind="question.Scenario"></textarea>
<label class="form-label tw:mt-2" for="explanation">@Ui.Text("Explanation")</label><textarea id="explanation" class="form-control" @bind="question.Explanation"></textarea>
<label class="form-label tw:mt-2" for="question-image">@Ui.Text("Question image")</label><InputFile id="question-image" class="form-control" OnChange="UploadQuestionImage" accept=".jpg,.jpeg,.png,.webp" />
<label class="form-label tw:mt-2" for="question-alt">@Ui.Text("Image alt text")</label><input id="question-alt" class="form-control" aria-describedby="question-alt-help" @bind="question.ImageAltText" /><div id="question-alt-help" class="form-text">@Ui.Text("Required when the question image communicates information needed to answer.")</div>
<fieldset class="tw:mt-3"><legend class="tw:text-base tw:font-semibold">@Ui.Text("Answer options and correct answer")</legend>@for(var i=0;i<question.Options.Count;i++){var index=i;var correctId=$"correct-option-{index}";var textId=$"option-text-{index}";<div class="ss-question-option"><span><input id="@correctId" type="radio" name="correct-answer" checked="@question.Options[index].IsCorrect" @onchange="() => SetCorrect(index)" /><label class="visually-hidden" for="@correctId">@Tx($"Mark option {index + 1} as correct", $"Chọn đáp án {index + 1} là đáp án đúng")</label></span><label class="visually-hidden" for="@textId">@Tx($"Option {index + 1} text", $"Nội dung đáp án {index + 1}")</label><input id="@textId" class="form-control" @bind="question.Options[index].Text" /></div>}@if(aiDraftNeedsConfirmation){<p class="text-danger tw:mt-2" role="alert">@Ui.Text("Select the correct answer yourself to confirm the AI suggestion.")</p>}</fieldset>

<details class="ss-builder-section"><summary><i class="bi bi-stars" aria-hidden="true"></i> @Tx("Optional: generate an AI draft", "Tùy chọn: tạo bản nháp bằng AI")</summary>
<div class="alert alert-info" role="note"><strong>@Ui.Text("AI creates an editable draft only.")</strong> @Ui.Text("Review every field and explicitly confirm the correct answer before saving.")</div>
<label class="form-label" for="ai-learning-context">@Ui.Text("Learning context for AI")</label><textarea id="ai-learning-context" class="form-control" maxlength="6000" @bind="aiLearningContext" aria-describedby="ai-context-help"></textarea><div id="ai-context-help" class="form-text">@Ui.Text("Paste only lesson content needed for this question; do not include student data.")</div>
<button type="button" class="btn btn-outline-primary tw:my-2" disabled="@aiBusy" @onclick="()=>Run(GenerateQuestionDraft)"><i class="bi bi-stars" aria-hidden="true"></i> @(aiBusy ? Ui.Text("Generating draft...") : Ui.Text("Generate with AI"))</button>
<span class="visually-hidden" role="status" aria-live="polite">@Ui.Text(aiStatus)</span>
@if(!string.IsNullOrWhiteSpace(aiStatus)){<div class="alert @(aiError ? "alert-warning" : "alert-success")" role="@(aiError ? "alert" : "status")">@Ui.Text(aiStatus)</div>}
</details>
<div class="ss-action-bar ss-sticky-actions"><SaveButton Busy="@saving" Disabled="@busy" OnClick="()=>Run(AddQuestion, true)" />
<button type="button" class="btn btn-outline-secondary" @onclick="NewQuestionEditor">@Ui.Text("Add question")</button></div>
</fieldset>
<button type="button" class="btn btn-outline-primary" disabled="@(quiz.Questions.Count==0||Dirty)" @onclick="()=>Run(PublishQuiz)">@Tx("Publish quiz", "Xuất bản bài kiểm tra")</button>
}
else{<p class="alert alert-info">@Tx("Published quizzes cannot be edited here. Learner attempts and correct-answer history are preserved.", "Bài kiểm tra đã xuất bản không được sửa tại đây. Lịch sử làm bài và đáp án được giữ nguyên.")</p>}
}}
</div></fieldset>
</section></div></main>
@code {
[SupplyParameterFromQuery(Name="managedQuizId")] public int? ManagedQuizId {get;set;}
private int? loadedManagedQuizId;
private bool standaloneQuiz;
protected override async Task OnParametersSetAsync()
{
    if(ManagedQuizId is not int id || loadedManagedQuizId==id)return;
    loadedManagedQuizId=id;
    await Run(async()=>{
        var selected=await Challenges.GetForManagementAsync(id,userId,isAdmin);
        if(selected is null){NewCourse();error=true;message=Tx("Quiz unavailable or you do not have permission to manage it.","Bài kiểm tra không tồn tại hoặc bạn không có quyền quản lý.");return;}
        if(selected.CourseId is int courseId)await SelectCourse(courseId);else NewCourse();
        quiz=selected;standaloneQuiz=selected.CourseId is null;panel=2;question=NewQuestion();aiDraftNeedsConfirmation=false;aiStatus="";editorVersion++;savedSnapshot=Snapshot();
    });
}
private int panel; private int editorVersion; private bool saving; private bool busy; private string search=""; private string savedSnapshot=""; private IReadOnlyList<SkillDto> skills=[];
private IEnumerable<CourseDto> FilteredCourses => courses.Where(x=>x.Title.Contains(search,StringComparison.OrdinalIgnoreCase));
private string Tx(string en,string vi)=>Ui.Current==AppLanguage.Vi?vi:en;
private string SkillName(SkillDto s)=>Ui.Current==AppLanguage.En?s.Name:s.Name switch {"Communication"=>"Giao tiếp","Teamwork"=>"Làm việc nhóm","Time Management"=>"Quản lý thời gian","Critical Thinking"=>"Tư duy phản biện","Problem Solving"=>"Giải quyết vấn đề","Emotional Management"=>"Quản lý cảm xúc","Adaptability"=>"Khả năng thích ứng",_=>s.Name};
private string Snapshot()=>System.Text.Json.JsonSerializer.Serialize(new {course,lesson,quiz,question,aiLearningContext});
private bool Dirty=>savedSnapshot.Length>0&&savedSnapshot!=Snapshot();
private async Task ChangePanel(int target){if(busy||panel==target||!await ConfirmDiscard())return;if(Dirty&&course.Id>0)await Run(()=>SelectCourse(course.Id));panel=target;editorVersion++;}
private async Task<bool> ConfirmDiscard()=>!Dirty||await JS.InvokeAsync<bool>("confirm",Tx("Discard unsaved changes?","Bỏ thay đổi chưa lưu?"));
private async Task NewQuestionEditor(){if(!await ConfirmDiscard())return;question=NewQuestion();aiDraftNeedsConfirmation=false;aiStatus="";editorVersion++;savedSnapshot=Snapshot();}
private async Task ConfirmNavigation(LocationChangingContext context){if(Dirty&&!await JS.InvokeAsync<bool>("confirm",Tx("Leave without saving your changes?","Rời trang khi chưa lưu thay đổi?")))context.PreventNavigation();}
private async Task ChangeCourse(int? id){if(busy)return;if(Dirty&&!await JS.InvokeAsync<bool>("confirm",Tx("Discard unsaved changes?","Bỏ thay đổi chưa lưu?")))return;await Run(async()=>{if(id is int value)await SelectCourse(value);else NewCourse();editorVersion++;});}
private async Task Run(Func<Task> action,bool save=false){if(busy)return;busy=true;saving=save;message=null;error=false;try{await action();}catch(Exception){error=true;message=Tx("We could not save or load this content. Your input is still here; please try again.","Chưa xử lý được nội dung. Dữ liệu nhập vẫn được giữ; vui lòng thử lại.");}finally{aiBusy=false;saving=false;busy=false;}}
private async Task NewLesson(){if(!await ConfirmDiscard())return;lesson=new(){CourseId=course.Id};editorVersion++;savedSnapshot=Snapshot();}
private async Task EditLesson(CourseLessonDto item){if(!await ConfirmDiscard())return;lesson=System.Text.Json.JsonSerializer.Deserialize<CourseLessonDto>(System.Text.Json.JsonSerializer.Serialize(item))!;editorVersion++;savedSnapshot=Snapshot();}
private async Task EditQuestion(ChallengeQuestionEditorDto item){if(!await ConfirmDiscard())return;question=System.Text.Json.JsonSerializer.Deserialize<ChallengeQuestionEditorDto>(System.Text.Json.JsonSerializer.Serialize(item))!;aiDraftNeedsConfirmation=false;aiStatus="";editorVersion++;savedSnapshot=Snapshot();}

private int userId; private bool isAdmin; private IReadOnlyList<CourseDto> courses=[]; private CourseDto course=new(); private CourseLessonDto lesson=new(); private ChallengeQuizDto quiz=new(); private ChallengeQuestionEditorDto question=NewQuestion(); private string? message; private bool error; private string aiLearningContext=""; private string aiStatus=""; private bool aiBusy; private bool aiError; private bool aiDraftNeedsConfirmation;
protected override async Task OnInitializedAsync(){var state=await Auth.GetAuthenticationStateAsync(); userId=int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,out var id)?id:0; isAdmin=state.User.IsInRole("Admin"); await Run(async()=>{skills=(await Skills.GetAllSkillsAsync()).ToList();await Reload();savedSnapshot=Snapshot();});}
private async Task Reload()=>courses=await Courses.GetManagedAsync(userId,isAdmin);
private void NewCourse(){standaloneQuiz=false;course=new();lesson=new();quiz=new();question=NewQuestion();panel=0;aiStatus="";savedSnapshot=Snapshot();}
private async Task SelectCourse(int id){standaloneQuiz=false;question=NewQuestion();aiStatus="";course=await Courses.GetForManagementAsync(id,userId,isAdmin)??new();lesson=new(){CourseId=id};quiz=course.Quizzes.FirstOrDefault() is { } summary ? await Challenges.GetForManagementAsync(summary.Id,userId,isAdmin)??new():new();savedSnapshot=Snapshot();}
private async Task SaveCourse(){try{var id=await Courses.SaveCourseAsync(course,userId,isAdmin);error=id is null;message=error?"Could not save course. Check the entered data and try again.":"Course saved.";if(id is not null){await SelectCourse(id.Value);await Reload();}}catch(Exception){error=true;message="Could not save course because the server rejected the operation. Please reload and try again.";}}
private async Task PublishCourse(){error=!await Courses.PublishCourseAsync(course.Id,userId,isAdmin);message=error?"Add at least one lesson before publishing.":"Course published.";await SelectCourse(course.Id);}
private async Task SaveLesson(){lesson.CourseId=course.Id;var id=await Courses.SaveLessonAsync(lesson,userId,isAdmin);error=id is null;message=error?"Could not save lesson.":"Lesson saved.";if(id is not null){await SelectCourse(course.Id);savedSnapshot=Snapshot();}}
private async Task CreateQuiz(){quiz.CourseId=course.Id;quiz.SkillId=course.SkillId;var id=await Challenges.SaveQuizAsync(quiz,userId,isAdmin);error=id is null;message=error?"Could not create quiz.":"Quiz created.";if(id is not null){quiz=await Challenges.GetForManagementAsync(id.Value,userId,isAdmin)??new();savedSnapshot=Snapshot();}}
private void SetCorrect(int index){for(var i=0;i<question.Options.Count;i++)question.Options[i].IsCorrect=i==index;aiDraftNeedsConfirmation=false;}
private async Task GenerateQuestionDraft(){if(aiBusy)return;aiBusy=true;aiError=false;aiStatus="Generating an editable draft. The quiz is not being saved or published.";var draft=await Challenges.GenerateQuestionDraftAsync(new(){QuizId=quiz.Id,LessonTitle=lesson.Title,LessonContent=aiLearningContext,TargetSkill=$"Skill {quiz.SkillId}",Difficulty=quiz.Difficulty,QuestionType=question.Type},userId,isAdmin);if(draft is null){aiError=true;aiStatus="AI is unavailable or returned an invalid draft. You can continue creating the question manually, or retry.";}else{question.QuestionText=draft.QuestionText;question.Scenario=draft.Scenario;question.Explanation=draft.Explanation;question.ImageAltText=draft.SuggestedAltText;question.Options=draft.Options.Select((text,index)=>new ChallengeOptionEditorDto{Text=text,IsCorrect=index==draft.SuggestedCorrectOptionIndex,Order=index+1}).ToList();aiDraftNeedsConfirmation=true;aiStatus="Draft generated. Review and edit it, then select the correct answer yourself before saving.";}aiBusy=false;}
private async Task AddQuestion(){if(aiDraftNeedsConfirmation){error=true;message="Confirm the correct answer yourself before saving this AI draft.";return;}error=!await Challenges.SaveQuestionAsync(quiz.Id,question,userId,isAdmin);message=error?"Enter one question, four options and select exactly one correct answer.":"Question saved.";if(!error){quiz=await Challenges.GetForManagementAsync(quiz.Id,userId,isAdmin)??new();question=NewQuestion();aiStatus="";savedSnapshot=Snapshot();}}
private async Task PublishQuiz(){error=!await Challenges.PublishAsync(quiz.Id,userId,isAdmin);message=error?Tx("Quiz must contain at least one valid question, with four options and one correct answer per question.","Bài kiểm tra cần ít nhất 1 câu hợp lệ, mỗi câu có 4 lựa chọn và 1 đáp án đúng."):"Quiz published.";quiz=await Challenges.GetForManagementAsync(quiz.Id,userId,isAdmin)??new();if(!error)savedSnapshot=Snapshot();}
private async Task UploadThumbnail(InputFileChangeEventArgs e)=>await Run(()=>Upload(e, path=>course.ThumbnailUrl=path, true));
private async Task UploadVideo(InputFileChangeEventArgs e)=>await Run(()=>Upload(e, path=>lesson.VideoUrl=path, false));
private async Task UploadQuestionImage(InputFileChangeEventArgs e)=>await Run(()=>Upload(e, path=>question.ImageUrl=path, true));
private async Task Upload(InputFileChangeEventArgs e,Action<string> set,bool image){try{set(image?await Uploads.SaveImageAsync(e.File):await Uploads.SaveVideoAsync(e.File));error=false;message="Upload complete.";}catch(InvalidOperationException ex){error=true;message=ex.Message;}}
private static ChallengeQuestionEditorDto NewQuestion()=>new(){Options=[new(),new(),new(),new()]};
}
