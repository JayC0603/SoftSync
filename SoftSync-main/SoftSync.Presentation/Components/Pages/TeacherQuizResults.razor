@page "/teacher/quizzes/{QuizId:int}/results"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SoftSync.BLL.Auth.CourseAuthorization.TeacherPolicy)]
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@inject IChallengeService Challenges
@inject AuthenticationStateProvider Auth

<PageTitle>Quiz Results · SoftSync</PageTitle>
<main class="tw:min-h-screen tw:bg-slate-50 tw:px-4 tw:py-10"><section class="tw:mx-auto tw:max-w-5xl" aria-labelledby="teacher-results-title" aria-busy="@loading">
    <a href="/teacher/courses" class="btn btn-link tw:px-0">← Teacher Studio</a>
    <h1 id="teacher-results-title" class="tw:text-3xl tw:font-bold">Kết quả người học</h1>
    @if (loading) { <p role="status">Đang tải kết quả người học...</p> }
    else if (results.Count == 0) { <div class="alert alert-info tw:mt-5" role="status">Không có kết quả hoặc bạn không sở hữu quiz này.</div> }
    else {
        <div class="table-responsive tw:mt-5"><table class="table table-hover"><caption class="visually-hidden">Kết quả các lần làm quiz</caption>
        <thead><tr><th scope="col">Attempt</th><th scope="col">Hoàn thành</th><th scope="col">Điểm</th><th scope="col">Kết quả</th><th scope="col">Thao tác</th></tr></thead><tbody>
        @foreach(var item in results){<tr><td>#@item.AttemptId</td><td>@item.CompletedAtUtc.ToLocalTime().ToString("g")</td><td>@item.CorrectAnswers / @item.TotalQuestions</td><td>@(item.Passed ? "PASS" : "NOT PASS")</td><td><a class="btn btn-sm btn-outline-primary" href="/game/review/@item.AttemptId">Review</a></td></tr>}
        </tbody></table></div>
    }
</section></main>

@code {
    [Parameter] public int QuizId { get; set; }
    private IReadOnlyList<QuizAttemptResultDto> results = [];
    private bool loading = true;
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var state = await Auth.GetAuthenticationStateAsync();
        results = await Challenges.GetQuizResultsAsync(QuizId, state.User.GetUserId(), state.User.IsInRole("Admin"));
        loading = false;
    }
}
