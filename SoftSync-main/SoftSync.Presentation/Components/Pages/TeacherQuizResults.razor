@inherits LocalizedComponentBase
@page "/teacher/quizzes/{QuizId:int}/results"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SoftSync.BLL.Auth.CourseAuthorization.TeacherPolicy)]
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@inject IChallengeService Challenges
@inject AuthenticationStateProvider Auth

<PageTitle>@Ui.Text("Quiz Results · SoftSync")</PageTitle>
<main class="ss-workspace"><section class="tw:mx-auto tw:max-w-5xl" aria-labelledby="teacher-results-title" aria-busy="@loading">
    <a href="/teacher/courses" class="btn btn-link tw:px-0">@Ui.Text("← Teacher Studio")</a>
    <h1 id="teacher-results-title" class="tw:text-3xl tw:font-bold">@Ui.Text("Kết quả người học")</h1>
    @if (loading) { <p role="status">@Ui.Text("Đang tải kết quả người học...")</p> }
    else if (results.Count == 0) { <div class="alert alert-info tw:mt-5" role="status">@Ui.Text("Không có kết quả hoặc bạn không sở hữu quiz này.")</div> }
    else {
        <div class="table-responsive tw:mt-5"><table class="table table-hover"><caption class="visually-hidden">@Ui.Text("Kết quả các lần làm quiz")</caption>
        <thead><tr><th scope="col">@Ui.Text("Attempt")</th><th scope="col">@Ui.Text("Hoàn thành")</th><th scope="col">@Ui.Text("Điểm")</th><th scope="col">@Ui.Text("Kết quả")</th><th scope="col">@Ui.Text("Thao tác")</th></tr></thead><tbody>
        @foreach(var item in results){<tr><td>#@item.AttemptId</td><td>@item.CompletedAtUtc.ToLocalTime().ToString("g", Ui.Culture)</td><td>@item.CorrectAnswers / @item.TotalQuestions</td><td>@(item.Passed ? Ui.Text("PASS") : Ui.Text("NOT PASS"))</td><td><a class="btn btn-sm btn-outline-primary" href="/game/review/@item.AttemptId">@Ui.Text("Review")</a></td></tr>}
        </tbody></table></div>
    }
</section></main>

@code {
    [Parameter] public int QuizId { get; set; }
    private IReadOnlyList<QuizAttemptResultDto> results = [];
    private bool loading = true;
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var state = await Auth.GetAuthenticationStateAsync();
        results = await Challenges.GetQuizResultsAsync(QuizId, state.User.GetUserId(), state.User.IsInRole("Admin"));
        loading = false;
    }
}
