@page "/assistant"
@page "/assistant/{UserId:int}"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@inject IAiAssistantService AssistantService
@inject IChatHistoryService ChatHistoryService
@inject NavigationManager Nav
@inject ILogger<Assistant> Logger
@inject IJSRuntime JS

<PageTitle>SYNCY · SoftSync</PageTitle>

<div class="sy-workspace" data-syncy-workspace>
    <aside class="sy-sidebar" aria-label="@Ui("Không gian hội thoại", "Conversation space")">
        <a href="/assistant" class="sy-brand"><span class="sy-brand-mark"><img src="/images/logo.png" alt="" width="30" height="30" /></span><span>SYNCY<small>BY SOFTSYNC</small></span></a>
        <button type="button" class="sy-new-chat" @onclick="NewChat" disabled="@isTyping"><i class="bi bi-plus-lg" aria-hidden="true"></i>@L["assistant.newChat"]<i class="bi bi-pencil-square" aria-hidden="true"></i></button>

        <div class="sy-history-section">
            <div class="sy-section-label">@Ui("HỘI THOẠI GẦN ĐÂY", "RECENT CONVERSATIONS")</div>
            @if (chatSessions.Count > 0)
            {
                <nav class="sy-session-list" aria-label="@Ui("Lịch sử hội thoại", "Conversation history")">
                    @foreach (var session in chatSessions)
                    {
                        <button type="button" class="@(session.Id == currentSessionId ? "is-active" : null)" @onclick="() => OpenSessionAsync(session)" disabled="@isTyping" aria-current="@(session.Id == currentSessionId ? "true" : null)"><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>@SessionTitle(session)</span></button>
                    }
                </nav>
            }
            else
            {
                <div class="sy-history-empty"><i class="bi bi-chat-square-dots" aria-hidden="true"></i><p>@Ui("Một cuộc trò chuyện hay bắt đầu từ một câu hỏi nhỏ.", "A good conversation starts with a small question.")</p></div>
            }
            @if (UserId <= 0)
            {
                <a class="sy-history-signin" href="/Account/Login?ReturnUrl=%2Fassistant"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>@Ui("Đăng nhập để lưu hội thoại", "Sign in to save conversations")</a>
            }
        </div>

        <nav class="sy-explore" aria-label="@L["assistant.suggested"]">
            <div class="sy-section-label">@Ui("TIẾP TỤC KHÁM PHÁ", "KEEP EXPLORING")</div>
            <a href="/roadmap"><i class="bi bi-signpost-split" aria-hidden="true"></i>@L["assistant.exploreLessons"]<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            <a href="/progress"><i class="bi bi-bar-chart-line" aria-hidden="true"></i>@L["assistant.trackProgress"]<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            <a href="/community"><i class="bi bi-people" aria-hidden="true"></i>@L["assistant.joinCommunity"]<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        </nav>
        <div class="sy-companion-card"><span class="sy-companion-star">✦</span><p>@Ui("Mỗi bước nhỏ,", "Small steps,")<br /><strong>@Ui("một phiên bản tốt hơn.", "a better you.")</strong></p><img src="/images/syncy-robot.png" alt="" width="88" height="88" decoding="async" /></div>
        <div class="sy-sidebar-foot"><span class="sy-small-dot"></span>@Ui("Không gian học tập của bạn", "Your space to grow")</div>
    </aside>

    <section class="sy-main" aria-label="@Ui("Trò chuyện cùng SYNCY", "Chat with SYNCY")">
        <header class="sy-chat-header">
            <div class="sy-chat-identity"><span class="sy-avatar sy-avatar-header"><i class="bi bi-stars" aria-hidden="true"></i></span><div><h1>SYNCY <span>AI</span></h1><p>@Ui("Người bạn đồng hành học tập", "Your learning companion")</p></div></div>
            <span class="sy-context-pill"><i class="bi bi-stars" aria-hidden="true"></i>@Ui("Cùng bạn tiến bộ", "Here to help you grow")</span>
            <button id="sy-new-mobile" type="button" class="sy-mobile-new" @onclick="NewChat" disabled="@isTyping" aria-label="@L["assistant.newChat"]" title="@L["assistant.newChat"]"><i class="bi bi-pencil-square" aria-hidden="true"></i></button>
        </header>

        <details class="sy-mobile-history">
            <summary><i class="bi bi-clock-history" aria-hidden="true"></i>@Ui("Lịch sử hội thoại", "Conversation history")<i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
            <div class="sy-mobile-history-body">
                @if (chatSessions.Count > 0)
                {
                    @foreach (var session in chatSessions)
                    {
                        <button type="button" class="@(session.Id == currentSessionId ? "is-active" : null)" @onclick="() => OpenSessionAsync(session)" disabled="@isTyping"><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>@SessionTitle(session)</span></button>
                    }
                }
                else
                {
                    <p>@Ui("Chưa có hội thoại đã lưu. Cùng bắt đầu một câu chuyện mới nhé.", "No saved conversations yet. Let's start a new one.")</p>
                }
                @if (UserId <= 0)
                {
                    <a href="/Account/Login?ReturnUrl=%2Fassistant">@Ui("Đăng nhập để lưu hội thoại", "Sign in to save conversations")<i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                }
            </div>
        </details>

        <div class="sy-conversation" @ref="chatViewport">
            @if (!HasConversation)
            {
                <section class="sy-welcome">
                    <div class="sy-welcome-mascot"><img src="/images/syncy-robot.png" alt="SYNCY" width="88" height="88" decoding="async" /><span>✦</span></div>
                    <span class="sy-eyebrow">@Ui("MỘT CHÚT TÒ MÒ. MỘT BƯỚC TIẾN MỚI.", "A LITTLE CURIOSITY. A NEW STEP FORWARD.")</span>
                    <h2>@Ui("Hôm nay, mình có thể", "How can I help you")<br /><span>@Ui("giúp gì cho bạn?", "grow today?")</span></h2>
                    <p>@Ui("Một kỹ năng muốn rèn luyện, một tình huống khó xử, hay đơn giản là một điều bạn đang băn khoăn.", "A skill to practise, a tricky situation, or simply something that's been on your mind.")</p>
                    <div class="sy-prompt-heading">@Ui("BẠN CÓ THỂ BẮT ĐẦU TỪ ĐÂY", "A FEW PLACES TO START")</div>
                    <div class="sy-prompt-grid">
                        <button type="button" @onclick='() => SetPrompt("lesson")'><span class="sy-prompt-icon sy-purple"><i class="bi bi-book" aria-hidden="true"></i></span><span><strong>@L["assistant.prompt.lesson"]</strong><small>@L["assistant.prompt.lessonSub"]</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                        <button type="button" @onclick='() => SetPrompt("practice")'><span class="sy-prompt-icon sy-peach"><i class="bi bi-chat-heart" aria-hidden="true"></i></span><span><strong>@L["assistant.prompt.practice"]</strong><small>@L["assistant.prompt.practiceSub"]</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                        <button type="button" @onclick='() => SetPrompt("advice")'><span class="sy-prompt-icon sy-mint"><i class="bi bi-lightbulb" aria-hidden="true"></i></span><span><strong>@L["assistant.prompt.advice"]</strong><small>@L["assistant.prompt.adviceSub"]</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                        <button type="button" @onclick='() => Nav.NavigateTo("/progress")'><span class="sy-prompt-icon sy-blue"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><span><strong>@L["assistant.prompt.progress"]</strong><small>@L["assistant.prompt.progressSub"]</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button>
                    </div>
                </section>
            }
            <div class="sy-message-log" role="log" aria-live="polite" aria-relevant="additions" aria-busy="@isTyping.ToString().ToLowerInvariant()" aria-label="@Ui("Nội dung hội thoại", "Conversation messages")">
                @foreach (var msg in messages.Where(x => x.ContentKey is null))
                {
                    var isUser = msg.Sender == SoftSync.Common.Enums.ChatSender.User;
                    <article @key="msg.ClientKey" id="chat-@msg.ClientKey" class="sy-message @(isUser ? "sy-user" : "sy-assistant")">
                        <span class="sy-avatar" aria-hidden="true"><i class="bi @(isUser ? "bi-person" : "bi-stars")"></i></span>
                        <div class="sy-message-body"><div class="sy-message-name">@(isUser ? Ui("Bạn", "You") : "SYNCY")</div><div class="sy-message-text">@MessageText(msg)</div>
                            @if (msg.Actions.Count > 0)
                            {
                                <div class="sy-quick-actions">@foreach (var action in msg.Actions) { <button type="button" @onclick="() => HandleAction(action)">@action.Label</button> }</div>
                            }
                            @if (!isUser)
                            {
                                <button type="button" class="sy-copy" @onclick="() => CopyMessageAsync(msg)" aria-label="@Ui("Sao chép câu trả lời", "Copy reply")"><i class="bi @(copiedMessageId == msg.ClientKey ? "bi-check2" : "bi-copy")" aria-hidden="true"></i>@(copiedMessageId == msg.ClientKey ? Ui("Đã chép", "Copied") : Ui("Sao chép", "Copy"))</button>
                            }
                        </div>
                    </article>
                }
                @if (isTyping)
                {
                    <div class="sy-message sy-assistant sy-typing" role="status"><span class="sy-avatar" aria-hidden="true"><i class="bi bi-stars"></i></span><div><span class="sy-message-name">SYNCY</span><span class="sy-typing-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="sy-sr-only">@L["assistant.typing"]</span></div></div>
                }
            </div>
        </div>

        <footer class="sy-composer">
            @if (HasConversation)
            {
                <div class="sy-follow-ups"><button type="button" @onclick='() => SetPrompt("lesson")'>@L["assistant.prompt.lesson"]<i class="bi bi-arrow-up-right" aria-hidden="true"></i></button><button type="button" @onclick='() => SetPrompt("practice")'>@L["assistant.prompt.practice"]<i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></div>
            }
            <div class="sy-compose-box">
                <label class="sy-sr-only" for="syncy-message">@L["assistant.inputPlaceholder"]</label>
                <textarea id="syncy-message" data-syncy-composer rows="2" placeholder="@L["assistant.inputPlaceholder"]" @bind="userInput" @bind:event="oninput"></textarea>
                <div class="sy-compose-bottom"><span><i class="bi bi-stars" aria-hidden="true"></i>@Ui("Cứ hỏi, mình ở đây.", "Ask away. I'm here.")</span><button id="syncy-send" type="button" @onclick="SendMessage" disabled="@(isTyping || string.IsNullOrWhiteSpace(userInput))" aria-label="@L["redesign.ai.send"]"><span>@Ui("Gửi", "Send")</span><i class="bi bi-arrow-up" aria-hidden="true"></i></button></div>
            </div>
            <div class="sy-composer-caption"><span>@Ui("Một cuộc trò chuyện. Một góc nhìn mới.", "A conversation. A fresh perspective.")</span><span class="sy-keyboard-hint">Enter <kbd>↵</kbd><span>·</span>Shift + Enter @Ui("xuống dòng", "for a new line")</span></div>
        </footer>
    </section>
</div>

@code {
    [Parameter] public int UserId { get; set; }
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;
    private string userInput = "";
    private bool isTyping = false;
    private bool browserHistoryReady;
    private ElementReference chatViewport;
    private bool scrollToLatest;
    private bool focusComposer;
    private string? copiedMessageId;
    private bool HasConversation => messages.Any(x => x.ContentKey is null);
    private string MessageText(AssistantMessage message) => message.ContentKey is not null ? L[message.ContentKey]
        : L.Current == SoftSync.Presentation.Services.AppLanguage.Vi ? message.ViContent : message.EnContent;
    private int currentSessionId;
    private List<ChatSessionDto> chatSessions = [];
    private List<AssistantMessage> messages = new()
    {
        new AssistantMessage
        {
            ContentKey = "assistant.welcome"
        }
    };

    private void NewChat()
    {
        if (isTyping) return;
        currentSessionId = 0;
        messages = [new AssistantMessage { ContentKey = "assistant.welcome" }];
        userInput = "";
        copiedMessageId = null;
        scrollToLatest = true;
        focusComposer = true;
    }

    private void SetPrompt(string type)
    {
        userInput = type switch
        {
            "lesson" => L["assistant.prompt.lessonText"],
            "practice" => L["assistant.prompt.practiceText"],
            _ => L["assistant.prompt.adviceText"]
        };
        focusComposer = true;
    }

    private async Task CopyMessageAsync(AssistantMessage message)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", MessageText(message));
            copiedMessageId = message.ClientKey;
        }
        catch (JSException) { Logger.LogWarning("Clipboard is unavailable for this browser."); }
    }

    private string SessionTitle(ChatSessionDto session) =>
        L.Current == SoftSync.Presentation.Services.AppLanguage.Vi ? session.TitleVi : session.TitleEn;

    protected override async Task OnInitializedAsync()
    {
        // Never trust a user id supplied in the URL for private chat history.
        UserId = await AuthProvider.GetUserIdAsync();
        try
        {
            chatSessions = (await ChatHistoryService.GetSessionsAsync(UserId)).ToList();
            currentSessionId = chatSessions.FirstOrDefault()?.Id ?? 0;
            var history = await ChatHistoryService.GetHistoryAsync(UserId, currentSessionId);
            if (history.Count > 0)
            {
                messages = history.Select(x => new AssistantMessage { Sender = x.Sender, ViContent = x.ViContent, EnContent = x.EnContent }).ToList();
                scrollToLatest = true;
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load AI chat history for user {UserId}", UserId); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToLatest || focusComposer)
        {
            try
            {
                if (scrollToLatest) await JS.InvokeVoidAsync("ssChatHistory.scrollChat", chatViewport);
                if (focusComposer) await JS.InvokeVoidAsync("ssChatHistory.focusComposer");
            }
            catch (JSException) { /* Navigation can disconnect the old chat viewport. */ }
            scrollToLatest = false;
            focusComposer = false;
        }
        if (!firstRender || UserId <= 0) return;
        browserHistoryReady = true;
        try
        {
            var local = await JS.InvokeAsync<List<BrowserChatMessage>>("ssChatHistory.load", UserId, currentSessionId);
            if (!messages.Any(x => x.Sender == SoftSync.Common.Enums.ChatSender.User) && local.Count > 0)
            {
                messages = local.Select(x => new AssistantMessage { Sender = x.Sender, ViContent = x.ViContent, EnContent = x.EnContent }).ToList();
                scrollToLatest = true;
            }
            else
                await PersistBrowserHistoryAsync();
            StateHasChanged();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Browser chat-history fallback is unavailable for user {UserId}", UserId); }
    }

    private async Task SendMessage()
    {
        if (isTyping || string.IsNullOrWhiteSpace(userInput)) return;
        isTyping = true;
        scrollToLatest = true;

        var userMsg = userInput;
        userInput = "";
        messages.Add(new AssistantMessage { Sender = SoftSync.Common.Enums.ChatSender.User, EnContent = userMsg, ViContent = userMsg });
        await TrySaveHistoryAsync(SoftSync.Common.Enums.ChatSender.User, userMsg, userMsg);
        await PersistBrowserHistoryAsync();

        isTyping = true;
        StateHasChanged();

        try
        {
            var viReply = await AssistantService.GetReplyAsync("[vi]" + userMsg, UserId);
            var enReply = await AssistantService.GetReplyAsync("[en]" + userMsg, UserId);
            messages.Add(new AssistantMessage { ViContent = viReply, EnContent = enReply });
            await TrySaveHistoryAsync(SoftSync.Common.Enums.ChatSender.Assistant, viReply, enReply);
            await PersistBrowserHistoryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI assistant failed for user {UserId}; showing the user-facing fallback", UserId);
            var error = new AssistantMessage
            {
                ViContent = "SYNCY chưa thể kết nối với AI. Vui lòng thử lại sau.",
                EnContent = "SYNCY could not connect to AI. Please try again later."
            };
            messages.Add(error);
            await TrySaveHistoryAsync(SoftSync.Common.Enums.ChatSender.Assistant, error.ViContent, error.EnContent);
            await PersistBrowserHistoryAsync();
        }
        finally
        {
            isTyping = false;
            scrollToLatest = true;
        }
    }

    private async Task TrySaveHistoryAsync(SoftSync.Common.Enums.ChatSender sender, string viContent, string enContent)
    {
        try
        {
            currentSessionId = await ChatHistoryService.SaveAsync(UserId, currentSessionId, sender, viContent, enContent);
            chatSessions = (await ChatHistoryService.GetSessionsAsync(UserId)).ToList();
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save AI chat history for user {UserId} with sender {Sender}", UserId, sender); }
    }

    private async Task OpenSessionAsync(ChatSessionDto session)
    {
        if (isTyping) return;
        currentSessionId = session.Id;
        var history = await ChatHistoryService.GetHistoryAsync(UserId, session.Id);
        messages = history.Select(x => new AssistantMessage { Sender = x.Sender, ViContent = x.ViContent, EnContent = x.EnContent }).ToList();
        scrollToLatest = true;
        await PersistBrowserHistoryAsync();
    }

    private async Task PersistBrowserHistoryAsync()
    {
        if (!browserHistoryReady || UserId <= 0) return;
        var history = messages.Where(x => x.ContentKey is null)
            .TakeLast(100)
            .Select(x => new BrowserChatMessage { Sender = x.Sender, ViContent = x.ViContent, EnContent = x.EnContent })
            .ToList();
        await JS.InvokeVoidAsync("ssChatHistory.save", UserId, currentSessionId, history);
    }

    private void HandleAction(ChatAction action)
    {
        switch (action.Key)
        {
            case "assessment": Nav.NavigateTo($"/assessment/{UserId}"); break;
            case "roadmap": Nav.NavigateTo("/roadmap"); break;
            case "cases": Nav.NavigateTo("/case-studies"); break;
            case "community": Nav.NavigateTo("/community"); break;
            case "progress": Nav.NavigateTo("/progress"); break;
            case "upgrade": Nav.NavigateTo("/settings"); break;
            case "mentor": AddBot("👥 SoftSync hướng tới việc kết nối người dùng với Mentor và Expert trong các phiên bản tiếp theo. Hiện tại, bạn có thể sử dụng AI Mentor để được hỗ trợ, định hướng và khám phá cộng đồng.", new ChatAction("Khám phá cộng đồng", "community")); break;
            case "about": AddBot("🌊 Chào mừng bạn đến với SoftSync Space!\n\nSoftSync là nền tảng ứng dụng AI giúp học sinh, sinh viên và người trẻ phát triển kỹ năng mềm qua bài đánh giá, tình huống mô phỏng và cộng đồng học tập.\n\nSYNCY giúp bạn rèn luyện giao tiếp, lãnh đạo, quản lý thời gian, tư duy phản biện và giải quyết vấn đề; đồng thời phân tích điểm mạnh và gợi ý lộ trình phù hợp.\n\nBạn muốn tìm hiểu thêm về phần nào?", new ChatAction("❤️ Sứ mệnh", "mission"), new ChatAction("🚀 Cách hoạt động", "how"), new ChatAction("✨ Điểm khác biệt", "difference"), new ChatAction("👥 Mentor", "mentor"), new ChatAction("📈 Dashboard", "dashboard"), new ChatAction("🎮 Game", "game"), new ChatAction("🌍 Tầm nhìn", "vision")); break;
            case "premium": AddBot("💎 SoftSync Premium – 69.000đ/tháng\n\nNâng cấp để trải nghiệm các tính năng nâng cao và được AI hỗ trợ chuyên sâu hơn.\n\n✅ AI phản hồi nhanh và ưu tiên xử lý\n✅ Truy cập các AI Mentor chuyên biệt\n✅ Phân tích kỹ năng và báo cáo chi tiết\n✅ Lộ trình học tập cá nhân hóa\n✅ Mở khóa tình huống nâng cao\n✅ Thống kê tiến độ theo thời gian\n\nChỉ khoảng 2.300đ/ngày cho hành trình phát triển kỹ năng cùng AI.", new ChatAction("💎 Nâng cấp Premium", "upgrade"), new ChatAction("📋 So sánh Free & Premium", "compare"), new ChatAction("❓ Hỏi thêm về Premium", "ask-premium")); break;
            case "compare": AddBot("📋 Free: AI Chat, đánh giá kỹ năng, AI Mentor và Dashboard cơ bản.\n\n⭐ Premium (69K/tháng): AI Mentor đầy đủ, phân tích chuyên sâu, Dashboard chi tiết, tình huống nâng cao, báo cáo PDF và hỗ trợ ưu tiên.", new ChatAction("💎 Nâng cấp Premium", "upgrade")); break;
            case "ask-premium": userInput = "Mình muốn hỏi thêm về SoftSync Premium"; break;
            case "mission": AddBot("❤️ Sứ mệnh của SoftSync là giúp người trẻ hiểu năng lực của mình và rèn kỹ năng mềm theo cách dễ tiếp cận, thực tế và có định hướng."); break;
            case "how": AddBot("🚀 Đầu tiên, AI giúp bạn đánh giá kỹ năng. Sau đó, SYNCY phân tích kết quả, đề xuất lộ trình cá nhân hóa và gợi ý bài học, trò chơi hoặc tình huống thực tế. Tiến độ được ghi nhận để bạn thấy sự phát triển theo thời gian."); break;
            case "difference": AddBot("✨ SoftSync kết hợp đánh giá, AI Mentor, lộ trình cá nhân hóa và luyện tập qua tình huống trong cùng một hành trình."); break;
            case "dashboard": AddBot("📈 Dashboard giúp bạn theo dõi kết quả đánh giá, kỹ năng đang phát triển và hoạt động đã hoàn thành.", new ChatAction("Xem tiến độ", "progress")); break;
            case "game": AddBot("🎮 Game và tình huống mô phỏng giúp bạn luyện cách phản ứng trước vấn đề thực tế và nhận phản hồi trong môi trường an toàn.", new ChatAction("Thử tình huống", "cases")); break;
            case "vision": AddBot("🌍 SoftSync hướng tới một không gian học tập nơi mỗi người trẻ đều có AI đồng hành, lộ trình phù hợp và cơ hội kết nối với cộng đồng Mentor trong tương lai."); break;
        }
    }

    private void AddBot(string content, params ChatAction[] actions) => messages.Add(new() { EnContent = content, ViContent = content, Actions = actions.ToList() });
    private sealed class AssistantMessage { public string ClientKey { get; } = Guid.NewGuid().ToString("N"); public SoftSync.Common.Enums.ChatSender Sender { get; set; } = SoftSync.Common.Enums.ChatSender.Assistant; public string? ContentKey { get; set; } public string EnContent { get; set; } = ""; public string ViContent { get; set; } = ""; public List<ChatAction> Actions { get; set; } = []; }
    private sealed class BrowserChatMessage { public SoftSync.Common.Enums.ChatSender Sender { get; set; } public string EnContent { get; set; } = ""; public string ViContent { get; set; } = ""; }
    private sealed record ChatAction(string Label, string Key);
}

<style>
