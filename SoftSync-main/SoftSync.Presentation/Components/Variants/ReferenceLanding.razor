@inherits LocalizedComponentBase
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@T("SoftSync — Phát triển kỹ năng mềm cùng AI", "SoftSync — Grow your soft skills with AI")</PageTitle>
<HeadContent>
    <meta name="description" content="@T("Phát triển kỹ năng mềm qua lộ trình cá nhân hóa, bài học ngắn và thực hành cùng AI, với mentor đồng hành.", "Grow your soft skills with a personal learning path, short lessons, AI-supported practice and mentors.")" />
    <link rel="canonical" href="https://softsync.id.vn/" />
    <meta property="og:title" content="@T("SoftSync — Phát triển kỹ năng mềm cùng AI", "SoftSync — Grow your soft skills with AI")" />
    <meta property="og:image" content="https://softsync.id.vn/images/landing/alpine-lake-reference-v2.webp" />
</HeadContent>

<div class="welcome-landing">
    <section class="welcome-hero" aria-labelledby="welcome-title">
        <div class="welcome-hero-copy">
            <span class="welcome-eyebrow"><i class="bi bi-stars" aria-hidden="true"></i>@T("AI & mentor đồng hành", "With AI & mentor support")</span>
            <h1 id="welcome-title">@T("Phát triển kỹ năng mềm", "Grow your soft skills") <em>@T("cùng AI", "with AI")</em></h1>
            <p class="welcome-intro">@T("Hiểu điểm mạnh của bạn, học theo lộ trình phù hợp và luyện tập qua tình huống thực tế.", "Understand your strengths, follow a path that fits you and practice with real situations.")</p>
            <div class="welcome-actions">
                <a class="welcome-button welcome-primary" href="@StartHref">@StartLabel<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                <a class="welcome-text-link" href="#learning-journey">@T("Xem cách học", "See how it works")<i class="bi bi-arrow-down" aria-hidden="true"></i></a>
            </div>
            @if (!IsAuthenticated)
            {
                <p class="welcome-signin">@T("Đã có tài khoản?", "Already have an account?") <a href="/Account/Login">@T("Đăng nhập", "Sign in")</a></p>
            }
        </div>
        <figure class="welcome-preview">
            <figcaption><span><i class="bi bi-signpost-split" aria-hidden="true"></i>@T("Một bước nhỏ để tiến bộ", "A small step forward")</span><small>@T("Minh họa", "Preview")</small></figcaption>
            <div class="welcome-preview-art">
                <img src="/images/home-v3/welcome-landscape.webp" width="600" height="300" alt="" decoding="async" fetchpriority="high" />
                <span class="welcome-preview-badge"><i class="bi bi-compass" aria-hidden="true"></i>@T("Lộ trình của bạn", "Your learning path")</span>
            </div>
            <div class="welcome-lesson">
                <span class="welcome-icon"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
                <div><small>@T("Bài học đầu tiên", "Your first lesson")</small><h2>@T("Giao tiếp tự tin", "Communicate with confidence")</h2></div>
            </div>
            <ol class="welcome-preview-process" aria-label="@T("Học, thực hành và phản tư", "Learn, practice and reflect")">
                <li><i class="bi bi-book" aria-hidden="true"></i>@T("Học", "Learn")</li>
                <li><i class="bi bi-chat-square-text" aria-hidden="true"></i>@T("Thực hành", "Practice")</li>
                <li><i class="bi bi-lightbulb" aria-hidden="true"></i>@T("Phản tư", "Reflect")</li>
            </ol>
        </figure>
    </section>

    <section class="welcome-benefits welcome-section" aria-labelledby="welcome-benefits-title">
        <div class="welcome-section-heading"><span class="welcome-kicker">@T("Dành cho hành trình của bạn", "Built around your journey")</span><h2 id="welcome-benefits-title">@T("Học có hướng. Tiến bộ rõ ràng.", "Learn with direction. See your growth.")</h2></div>
        <div class="welcome-benefit-grid">
            <article><span class="welcome-icon"><i class="bi bi-signpost-split" aria-hidden="true"></i></span><div><h3>@T("Lộ trình phù hợp với bạn", "A path that fits you")</h3><p>@T("Bắt đầu từ năng lực hiện tại và mục tiêu bạn muốn đạt được.", "Start with your current skills and the goals you want to reach.")</p></div></article>
            <article><span class="welcome-icon welcome-icon-mint"><i class="bi bi-journal-check" aria-hidden="true"></i></span><div><h3>@T("Học ngắn, thực hành thật", "Short lessons, real practice")</h3><p>@T("Áp dụng bài học qua tình huống thực tế và hoạt động tương tác.", "Put lessons into practice with real situations and interactive activities.")</p></div></article>
            <article><span class="welcome-icon welcome-icon-lilac"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><div><h3>@T("Nhìn thấy sự tiến bộ", "See your progress")</h3><p>@T("Theo dõi quá trình học và nhận gợi ý cải thiện từ AI.", "Follow your learning and get suggestions for improvement from AI.")</p></div></article>
            <article><span class="welcome-icon welcome-icon-peach"><i class="bi bi-people" aria-hidden="true"></i></span><div><h3>@T("Có người đồng hành", "Support along the way")</h3><p>@T("Kết nối mentor, chia sẻ khó khăn và tìm hướng phát triển.", "Connect with mentors, share challenges and find your way forward.")</p></div></article>
        </div>
    </section>

    <section id="learning-journey" class="welcome-journey welcome-section" aria-labelledby="welcome-journey-title">
        <div class="welcome-section-heading"><span class="welcome-kicker">@T("Cách học cùng SoftSync", "How you learn with SoftSync")</span><h2 id="welcome-journey-title">@T("Từng bước, từ hiểu mình đến tiến bộ.", "Step by step, from insight to growth.")</h2><p>@T("Bốn bước kết nối việc học với sự thay đổi trong thực tế.", "Four steps that connect learning with real change.")</p></div>
        <ol class="welcome-steps">
            @foreach (var step in Steps.Select((value, index) => (value, index)))
            {
                <li><span class="welcome-step-number">@((step.index + 1).ToString("00"))</span><div><h3>@step.value.Title</h3><p>@step.value.Description</p></div></li>
            }
        </ol>
    </section>

    <section id="mentors" class="welcome-mentors welcome-section" aria-labelledby="welcome-mentors-title">
        <div class="welcome-section-heading welcome-heading-with-link"><div><span class="welcome-kicker">@T("Không phải học một mình", "You are not learning alone")</span><h2 id="welcome-mentors-title">@T("Mentor đồng hành cùng bạn", "Mentors in your corner")</h2></div><a class="welcome-text-link" href="/mentors">@T("Xem đội ngũ mentor", "Meet the mentors")<i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
        <div class="welcome-mentor-grid">
            <a class="welcome-mentor" href="/mentors/2"><img src="/images/optimized/mentor-nguyen-thuy-to-tram.webp" alt="" width="110" height="125" loading="lazy" /><div><h3>Th.S. Nguyễn Thuỵ Tố Trâm</h3><p>@T("Kỹ năng mềm và phát triển cộng đồng", "Soft skills and community development")</p><span class="welcome-tag">@T("Kỹ năng mềm", "Soft skills")</span></div><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            <a class="welcome-mentor" href="/mentors/1"><img src="/images/optimized/mentor-nguyen-hoang-van-anh.webp" alt="" width="110" height="125" loading="lazy" /><div><h3>Th.S. Nguyễn Hoàng Vân Anh</h3><p>@T("Tâm lý và phát triển cá nhân", "Psychology and personal development")</p><span class="welcome-tag">@T("Phát triển cá nhân", "Personal development")</span></div><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
            <a class="welcome-mentor" href="/mentors/3"><img src="/images/optimized/mentor-nguyen-xuan.webp" alt="" width="110" height="125" loading="lazy" /><div><h3>Th.S. Nguyễn Xuân</h3><p>@T("Giáo dục và công nghệ", "Education and technology")</p><span class="welcome-tag">@T("Phương pháp học", "Learning methods")</span></div><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        </div>
    </section>

    <section id="community" class="welcome-community welcome-section" aria-labelledby="welcome-community-title">
        <div><span class="welcome-kicker">@T("Cùng nhau đi xa hơn", "Grow together")</span><h2 id="welcome-community-title">@T("Một cộng đồng, nhiều sự đồng hành.", "A community to grow with.")</h2><p>@T("Cùng học tập, chia sẻ kinh nghiệm và truyền cảm hứng trên hành trình phát triển kỹ năng.", "Learn together, share experiences and inspire each other as you develop your skills.")</p><a class="welcome-text-link" href="/community">@T("Tham gia cộng đồng", "Join the community")<i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
        <img src="/images/learn-v3/mentor-support.png" alt="" width="240" height="260" loading="lazy" />
    </section>

    <section class="welcome-closing welcome-section" aria-labelledby="welcome-closing-title">
        <span class="welcome-closing-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
        <h2 id="welcome-closing-title">@T("Bắt đầu hành trình phát triển của bạn.", "Start your own growth journey.")</h2>
        <p>@T("Từng bài học nhỏ, từng bước tiến gần hơn đến phiên bản bạn mong muốn.", "One small lesson at a time, one step closer to who you want to become.")</p>
        <a class="welcome-button welcome-primary" href="@StartHref">@StartLabel<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </section>
</div>

@code {
    private string StartHref = "/Account/Register";
    private bool IsAuthenticated;
    private string StartLabel => IsAuthenticated ? T("Tiếp tục học", "Continue learning") : T("Bắt đầu miễn phí", "Start for free");
    private string T(string vi, string en) => L.Current == AppLanguage.Vi ? vi : en;
    private (string Title, string Description)[] Steps => [
        (T("Đánh giá đầu vào", "Understand your starting point"), T("Hiểu điểm mạnh, điểm cần cải thiện và mục tiêu của bạn.", "Discover your strengths, areas for growth and personal goals.")),
        (T("Lộ trình cá nhân hóa", "Find your personal path"), T("Nhận lộ trình phù hợp với năng lực và thời gian của bạn.", "Get a learning journey that fits your skills and schedule.")),
        (T("Học và thực hành", "Learn by doing"), T("Học qua bài học ngắn và vận dụng vào tình huống thực tế.", "Explore short lessons and apply them in real situations.")),
        (T("Phản tư và cải thiện", "Reflect and grow"), T("Nhận phản hồi từ AI, nhìn lại trải nghiệm và theo dõi tiến bộ.", "Get AI feedback, reflect on your experience and follow your growth."))
    ];
    protected override async Task OnInitializedAsync()
    {
        IsAuthenticated = (await AuthProvider.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
        if (IsAuthenticated) StartHref = "/dashboard";
    }
}
