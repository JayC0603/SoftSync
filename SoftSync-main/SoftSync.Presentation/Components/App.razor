@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="@ServerLanguage" data-theme="@ServerTheme" data-reduce-motion="@ReduceMotionAttr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-visual" />
    <meta name="theme-color" content="@BrowserThemeColor" />
    <base href="/" />
    <style>
        /* Critical first-paint canvas. This is intentionally inline and appears
           before external styles so refresh never exposes the purple fallback
           while Blazor/CSS is still loading. */
        html, body { min-height: 100%; margin: 0; background: #050917; }
        html[data-theme="dark"], html[data-theme="dark"] body { background: #050917; }
        html[data-theme="light"], html[data-theme="light"] body { background: #f7f8fa; }
        /* Hide the alternate Learn layout before any route CSS arrives. */
        @@media (max-width: 900px) { .learn-desktop { display: none !important; } }
        @@media (min-width: 901px) { .learn-v3 { display: none !important; } }
    </style>
    <script>
        // Migrate the old localStorage-only preference before the first paint.
        // Once the cookie exists, the server renders the selected language
        // directly and this block becomes a no-op on every later visit.
        (function () {
            try {
                var saved = localStorage.getItem('ss-lang');
                if (saved !== 'vi' && saved !== 'en') return;
                var match = document.cookie.match(/(?:^|; )ss-lang=([^;]*)/);
                var cookie = match ? decodeURIComponent(match[1]) : null;
                if (cookie === saved) {
                    sessionStorage.removeItem('ss-lang-cookie-migration');
                    return;
                }
                // Avoid a reload loop if this browser blocks cookies.
                if (sessionStorage.getItem('ss-lang-cookie-migration') === saved) return;
                sessionStorage.setItem('ss-lang-cookie-migration', saved);
                document.cookie = 'ss-lang=' + saved + '; path=/; max-age=31536000; samesite=lax';
                location.replace(location.href);
            } catch (e) { /* ignore */ }
        })();
    </script>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="preload" href="bootstrap-icons/fonts/bootstrap-icons.woff2?dd67030699838ea613ee6dbda90effa6" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="stylesheet" href="bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="@VersionedAsset("dist/app.css")" />
    <link rel="stylesheet" href="css/liquid-glass.css" />
    <link rel="stylesheet" href="css/focus-journey.css" />
    <link rel="stylesheet" href="css/ecosystem.css" />
    <link rel="stylesheet" href="@VersionedAsset("css/design-system.css")" />
    <script src="@VersionedAsset("js/design-system.js")"></script>
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
    <link rel="stylesheet" href="@VersionedAsset("css/vivid-theme.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/about-landing.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/dashboard-reference.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/mobile-layout.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/glass-buttons.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/account-menu.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/notifications.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/compact-layout.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/settings-account.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/mobile-home.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/brand-images.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/strict-mobile-home.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/mobile-dock.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/mobile-site-footer.css")" />
    @* Route CSS must be ready before enhanced navigation patches page content.
       Keep shared navigation overrides last so route styles cannot move the shell. *@
    <link rel="stylesheet" href="@VersionedAsset("css/adventure-map.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/learning-journey.css")" media="(min-width: 901px)" />
    <link rel="stylesheet" href="@VersionedAsset("css/learn-v3.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/learn-mobile-reference.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/progress-reference.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/cv-career.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/page-navigation.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/navigation-glass.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/mobile-options.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/reference-landing.css")" />
    <link rel="stylesheet" href="@VersionedAsset("css/mentor-reference.css")" />
    <script>
        // The server already renders data-theme on <html> from the ss-theme
        // cookie, so there's no flash and no revert on Blazor enhanced navigation.
        // This script only handles the parts the server can't know:
        //   1. Resolving "system" against the OS setting.
        //   2. Keeping the cookie in sync so the next SSR paints correctly.
        //   3. Reacting to OS theme changes while "system" is selected.
        (function () {
            function setCookie(name, value) {
                try { document.cookie = name + '=' + value + '; path=/; max-age=31536000; samesite=lax'; }
                catch (e) { /* ignore */ }
            }
            function apply() {
                try {
                    var pref = localStorage.getItem('ss-theme') || 'light';
                    var rm = localStorage.getItem('ss-reduce-motion') === '1';
                    var resolved = (pref === 'light' || pref === 'dark') ? pref
                        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                    var el = document.documentElement;
                    el.setAttribute('data-theme', resolved);
                    if (rm) el.setAttribute('data-reduce-motion', '1');
                    else el.removeAttribute('data-reduce-motion');
                    // Persist the RESOLVED value so the server can paint it next time.
                    setCookie('ss-theme', resolved);
                    setCookie('ss-reduce-motion', rm ? '1' : '0');
                } catch (e) { /* ignore */ }
            }
            apply();
            document.addEventListener('enhancedload', apply);
            // If the user chose "system", follow OS theme changes.
            try {
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
                    if (localStorage.getItem('ss-theme') === 'system') apply();
                });
            } catch (e) { /* older browsers */ }
        })();
    </script>
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="@VersionedAsset("js/page-navigation.js")"></script>
    <script src="@VersionedAsset("js/blazor-start.js")"></script>
    <script src="@VersionedAsset("dist/app.js")"></script>
</body>

</html>

@code {
    // Keep the router and layout alive between application pages. Account
    // endpoints retain static SSR so sign-in/out can write response cookies.
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string,
        (DateTimeOffset Modified, long Length, string Url)> AssetVersions = new();

    private string VersionedAsset(string path)
    {
        var asset = HostEnvironment.WebRootFileProvider.GetFileInfo(path);
        if (!asset.Exists) return path;
        var cacheKey = $"{HostEnvironment.WebRootPath}|{path}";
        if (AssetVersions.TryGetValue(cacheKey, out var cached)
            && cached.Modified == asset.LastModified && cached.Length == asset.Length)
            return cached.Url;
        using var stream = asset.CreateReadStream();
        var version = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(stream))[..16];
        var url = $"{path}?v={version}";
        AssetVersions[cacheKey] = (asset.LastModified, asset.Length, url);
        return url;
    }
    // Read the resolved theme the browser last persisted to the ss-theme cookie
    // and paint it straight onto <html> during SSR / enhanced navigation. This is
    // what stops the theme from flashing to light and reverting between pages.
    private string ServerTheme =>
        HttpContextAccessor.HttpContext?.Request.Cookies["ss-theme"] is "dark" ? "dark" : "light";

    private string BrowserThemeColor => ServerTheme == "dark" ? "#100d24" : "#f7f6fc";

    private string ServerLanguage =>
        HttpContextAccessor.HttpContext?.Request.Cookies["ss-lang"] is "en" ? "en" : "vi";

    // Returns "1" or null — Blazor omits the attribute entirely when it's null,
    // so we never emit a broken/empty data-reduce-motion.
    private string? ReduceMotionAttr =>
        HttpContextAccessor.HttpContext?.Request.Cookies["ss-reduce-motion"] == "1" ? "1" : null;
}
