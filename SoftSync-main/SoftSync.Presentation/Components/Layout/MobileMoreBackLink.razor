@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject NavigationManager Navigation

@if (Destination is { } destination)
{
    <a class="ss-mobile-more-back ss-more-back" href="@destination.Href" aria-label="@destination.Label" title="@destination.Label">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
        <span class="ss-more-back-label">@destination.Label</span>
    </a>
}

@code {
    private string path = "/";

    private (string Href, string Label)? Destination
    {
        get
        {
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length == 0) return null;
            var root = segments[0].ToLowerInvariant();
            if (root is not ("courses" or "schedule" or "resources" or "game" or "assistant"
                or "community" or "mentors" or "mentor-requests" or "about" or "teacher"
                or "settings" or "profile" or "notifications" or "cv-review")) return null;

            if (root == "courses" && segments.Length > 2)
                return ($"/courses/{segments[1]}", L["navigation.backCourse"]);
            if (root == "courses" && segments.Length == 2)
                return ("/courses", L["navigation.backCourses"]);
            if (root == "game" && segments.Length > 1)
                return ("/game", L["navigation.backGames"]);
            if (root == "community" && segments.Length > 1)
                return ("/community", L["navigation.backCommunity"]);
            if (root == "mentors" && segments.Length > 1)
                return ("/mentors", L["navigation.backMentors"]);
            if (root == "teacher" && segments.Length > 1)
                return ("/teacher", L["navigation.backTeacher"]);
            if (root == "cv-review" && segments.Length > 1)
                return ("/cv-review", L["navigation.backCvReviews"]);

            return ("/more", L["navigation.backMore"]);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdatePath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void UpdatePath() => path = new Uri(Navigation.Uri).AbsolutePath;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() =>
    {
        UpdatePath();
        StateHasChanged();
    });

    public override void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }
}
