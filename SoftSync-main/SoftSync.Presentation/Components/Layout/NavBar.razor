@rendermode InteractiveServer
@implements IDisposable
@using SoftSync.Presentation.Services
@inject LocalizationService L
@inject AuthenticationStateProvider AuthProvider
@inject LearnerAccessState Access

@* Sidebar navigation shares localization with HeaderActions and stays mounted while the router changes pages. *@

<nav id="ss-main-sidebar" class="ss-navbar tw:py-3 tw:px-6 tw:flex tw:justify-between tw:items-center" aria-label="@(L.Current == AppLanguage.Vi ? "Điều hướng chính" : "Main navigation")">
    <!-- Brand -->
    <a class="ss-brand tw:flex tw:items-center tw:gap-2 cursor-pointer" href="@HomeHref" aria-label="SoftSync - @L["nav.home"]">
        <div class="ss-brand-logo tw:flex tw:items-center tw:justify-center">
            <img src="images/logo.png" alt="S" class="tw:w-full tw:h-full tw:object-cover" />
        </div>
        <span class="tw:text-xl tw:font-bold ss-gradient-text">SoftSync</span>
    </a>

    <!-- Center: nav pills -->
    <div class="ss-navpills tw:flex tw:items-center tw:gap-1">
        @if (isAdmin)
        {
            <a class="@LinkClass("ss-navpill", "/admin/dashboard")" href="/admin/dashboard" aria-current="@CurrentLink("/admin/dashboard")"><i class="bi bi-speedometer2" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Tổng quan" : "Overview")</span></a>
            <a class="@LinkClass("ss-navpill", "/admin/learners")" href="/admin/learners" aria-current="@CurrentLink("/admin/learners")"><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Học viên" : "Learners")</span></a>
            <a class="@LinkClass("ss-navpill", "/admin/ai/settings")" href="/admin/ai/settings" aria-current="@CurrentLink("/admin/ai/settings")"><i class="bi bi-stars" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Gemini" : "Gemini")</span></a>
            <a class="@LinkClass("ss-navpill ss-desktop-integration", "/admin/ai-configuration")" href="/admin/ai-configuration" aria-current="@CurrentLink("/admin/ai-configuration")"><i class="bi bi-cpu" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Cấu hình AI" : "AI configuration")</span></a>
            <a class="@LinkClass("ss-navpill", "/admin/mentor-requests")" href="/admin/mentor-requests" aria-current="@CurrentLink("/admin/mentor-requests")"><i class="bi bi-person-check" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Yêu cầu Mentor" : "Mentor requests")</span></a>
            <a class="@LinkClass("ss-navpill", "/admin/users")" href="/admin/users" aria-current="@CurrentLink("/admin/users")" aria-label="@L["layout.manageUsers"]"><i class="bi bi-person-gear" aria-hidden="true"></i><span>@L["layout.manageUsers"]</span></a>
            <a class="@LinkClass("ss-navpill", "/admin/notifications")" href="/admin/notifications" aria-current="@CurrentLink("/admin/notifications")" aria-label="@L["nav.notifications"]"><i class="bi bi-megaphone" aria-hidden="true"></i><span>@L["nav.notifications"]</span></a>
            <a class="@LinkClass("ss-navpill", "/teacher")" href="/teacher" aria-current="@CurrentLink("/teacher")" aria-label="@(L.Current == AppLanguage.Vi ? "Quản lý khóa học" : "Manage courses")"><i class="bi bi-journal-text" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Quản lý khóa học" : "Manage courses")</span></a>
        }
        else
        {
        <a class="@LinkClass("ss-navpill", HomeHref)" href="@HomeHref" aria-current="@CurrentLink(HomeHref)" aria-label="@L["nav.home"]">
            <i class="bi bi-house-door"></i> <span>@L["nav.home"]</span>
        </a>
        <a class="@LinkClass("ss-navpill", "/roadmap")" href="/roadmap" aria-current="@CurrentLink("/roadmap")" aria-label="@L["nav.learn"]">
            <i class="bi bi-book"></i> <span>@L["nav.learn"]</span>
        </a>
        <a class="@LinkClass("ss-navpill", "/progress")" href="/progress" aria-current="@CurrentLink("/progress")" aria-label="@L["nav.progress"]">
            <i class="bi bi-graph-up-arrow"></i> <span>@L["nav.progress"]</span>
        </a>
        <a class="@LinkClass("ss-navpill", "/resources")" href="/resources" aria-current="@CurrentLink("/resources")" aria-label="@L["nav.resources"]">
            <i class="bi bi-folder"></i> <span>@L["nav.resources"]</span>
        </a>
        <a class="@LinkClass("ss-navpill", "/game")" href="/game" aria-current="@CurrentLink("/game")" aria-label="@L.Ui("Mini Game")">
            <i class="bi bi-controller"></i> <span>@L.Ui("Mini Game")</span>
        </a>
        <a class="@LinkClass("ss-navpill", "/assistant")" href="/assistant" aria-current="@CurrentLink("/assistant")" aria-label="SYNCY"><i class="bi bi-chat-heart"></i><span>SYNCY</span></a>
        <a class="@LinkClass("ss-navpill", "/cv")" href="/cv" aria-current="@CurrentLink("/cv")" aria-label="@L.Ui("Smart CV")"><i class="bi bi-file-earmark-person"></i><span>@(L.Current == AppLanguage.Vi ? "CV thông minh" : "Smart CV")</span></a>
        <a class="@LinkClass("ss-navpill ss-desktop-integration", "/courses")" href="/courses" aria-current="@CurrentLink("/courses")"><i class="bi bi-journal-bookmark" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Khóa học" : "Courses")</span></a>
        <a class="@LinkClass("ss-navpill ss-desktop-integration", "/schedule")" href="/schedule" aria-current="@CurrentLink("/schedule")"><i class="bi bi-calendar3" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Lịch cá nhân" : "My schedule")</span></a>
        <a class="@LinkClass("ss-navpill ss-desktop-integration", "/cv-review")" href="/cv-review" aria-current="@CurrentLink("/cv-review")"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Đánh giá CV" : "CV review")</span></a>
        }
    </div>

</nav>

@if (NavigationAccessRules.ShowBottomNavigation(RenderedPath, Access.IsAuthenticated, Access.IsStaff, DockStatus))
{
<nav class="ss-mobile-bottom-nav" aria-label="@L.Ui("Mobile navigation")">
    @if (isAdmin)
    {
        <a class="@LinkClass("ss-mobile-bottom-link", "/admin/users")" href="/admin/users" aria-current="@CurrentLink("/admin/users")"><i class="bi bi-person-gear" aria-hidden="true"></i><span>@L["layout.manageUsers"]</span></a>
        <a class="@LinkClass("ss-mobile-bottom-link", "/admin/notifications")" href="/admin/notifications" aria-current="@CurrentLink("/admin/notifications")"><i class="bi bi-megaphone" aria-hidden="true"></i><span>@L["nav.notifications"]</span></a>
        <a class="@LinkClass("ss-mobile-bottom-link", "/teacher")" href="/teacher" aria-current="@CurrentLink("/teacher")"><i class="bi bi-journal-text" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Khóa học" : "Courses")</span></a>
    }
    else
    {
    <a class="@LinkClass("ss-mobile-bottom-link", HomeHref)" href="@HomeHref" aria-current="@CurrentLink(HomeHref)">
        <i class="bi bi-house-door-fill"></i><span>@L["nav.home"]</span>
    </a>
    <a class="@LinkClass("ss-mobile-bottom-link", "/roadmap")" href="/roadmap" aria-current="@CurrentLink("/roadmap")">
        <i class="bi bi-book"></i><span>@L["nav.learn"]</span>
    </a>
    <a class="@LinkClass("ss-mobile-bottom-link", "/progress")" href="/progress" aria-current="@CurrentLink("/progress")">
        <i class="bi bi-bar-chart-fill"></i><span>@L["nav.progress"]</span>
    </a>
    <a class="@LinkClass("ss-mobile-bottom-link", "/cv")" href="/cv" aria-current="@CurrentLink("/cv")"><i class="bi bi-file-earmark-person"></i><span>CV</span></a>
    <a class="@LinkClass("ss-mobile-bottom-link", "/more")" href="/more" data-route-roots="@NavigationAccessRules.MoreRoutes" aria-current="@CurrentLink("/more")"><i class="bi bi-grid" aria-hidden="true"></i><span>@(L.Current == AppLanguage.Vi ? "Thêm" : "More")</span></a>
    }
</nav>
}

<style>
    .ss-navbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--glass-bg-strong);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        border-bottom: 1px solid var(--glass-border);
        min-height: 88px;
    }
    .ss-brand-logo {
        width: 38px; height: 38px;
        background: var(--gradient);
        border-radius: 10px;
        overflow: hidden;
    }
    .cursor-pointer { cursor: pointer; }
    .ss-brand { color: inherit; text-decoration: none; }

    /* Center nav pills */
    .ss-navpill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        border-radius: 999px;
        color: #4b5563;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.18s ease;
        white-space: nowrap;
    }
    .ss-navpill i { font-size: 1.05rem; }
    .ss-navpill:hover {
        color: var(--color-brand);
        background: rgba(99, 102, 241, 0.08);
    }
    .ss-navpill.active {
        color: var(--color-brand-dark);
        background: rgba(99, 102, 241, 0.14);
    }

    /* Icon buttons (language, search, bell) */
    .ss-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 0.6rem;
        border-radius: 12px;
        border: none;
        background: rgba(255, 255, 255, 0.6);
        color: #4b5563;
        cursor: pointer;
        transition: all 0.18s ease;
    }
    .ss-icon-btn:hover {
        background: #fff;
        color: var(--color-brand);
    }
    .ss-icon-btn i { font-size: 1.05rem; }
    .ss-lang-btn {
        gap: 0.4rem;
        width: 106px;
        padding: 0 0.75rem;
        border: 1px solid rgba(101, 91, 183, 0.14);
        box-shadow: 0 5px 14px rgba(58, 49, 129, 0.06);
    }
    .ss-lang-chevron { margin-left: auto; font-size: 0.72rem !important; }
    .ss-lang-code {
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.02em;
    }
    .ss-lang-name {
        color: inherit;
        font-size: 0.78rem;
        font-weight: 650;
        opacity: 0.82;
    }
    .ss-lang-code::after {
        content: "·";
        margin-left: 0.35rem;
        opacity: 0.55;
    }

    /* Notification bell badge */
    .ss-bell { position: relative; }
    .ss-bell-badge {
        position: absolute;
        top: -4px; right: -4px;
        min-width: 18px; height: 18px;
        padding: 0 4px;
        border-radius: 999px;
        background: var(--color-brand-accent);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 2px var(--glass-bg-strong);
    }

    /* User chip */
    .ss-userchip {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.3rem 0.6rem 0.3rem 0.35rem;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.18s ease;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
    }
    .ss-userchip:hover { background: rgba(255, 255, 255, 0.6); }
    .ss-avatar {
        width: 38px; height: 38px;
        border-radius: 999px;
        background: var(--gradient);
        color: #fff;
        font-size: 1.1rem;
        flex-shrink: 0;
        overflow: hidden;
    }
    .ss-avatar .ss-avatar-img {
        width: 100%; height: 100%;
        border-radius: 999px;
        object-fit: cover;
    }
    .ss-userchip-sub {
        font-size: 0.75rem;
        color: var(--color-brand);
        font-weight: 600;
    }
    .ss-auth-actions {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }
    .ss-login-link,
    .ss-register-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 0.95rem;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }
    .ss-login-link {
        color: #4b5563;
        background: rgba(255, 255, 255, 0.6);
    }
    .ss-register-link {
        color: #fff;
        background: var(--gradient);
        box-shadow: 0 10px 24px rgba(99, 102, 241, 0.24);
    }
    .ss-search-btn { display: none; }
    .ss-user-chevron { margin-left: 0.25rem; color: #26345f; font-size: 0.72rem; }
    .ss-mobile-bottom-nav { display: none; }

    @@media (max-width: 900px) {
        .ss-navpill span { display: none; }
        .ss-userchip .tw\:flex-col { display: none; }
    }

    /* Narrow phones: the row (brand + 5 pills + lang + search + bell + avatar)
       gets cramped. Tighten padding/gaps and drop the "EN"/"VI" label so the
       bar never overflows or wraps. */
    @@media (max-width: 560px) {
        .ss-navbar { padding-left: 0.75rem; padding-right: 0.75rem; }
        .ss-navpills { gap: 0; }
        .ss-navpill { padding: 0.5rem 0.55rem; }
        .ss-icon-btn { min-width: 36px; height: 36px; padding: 0 0.4rem; }
        .ss-lang-btn { width: 36px; }
        .ss-lang-name,
        .ss-lang-code::after { display: none; }
    }

    /* Mobile app shell: compact header plus thumb-friendly bottom navigation. */
    @@media (max-width: 760px) {
        .ss-navbar {
            position: sticky;
            top: 0;
            z-index: 900;
            min-height: 58px;
            padding: 0.55rem 0.75rem !important;
            gap: 0.5rem;
        }
        .ss-brand { flex: 1; min-width: 0; }
        .ss-brand-logo { width: 38px; height: 38px; }
        .ss-nav-actions { gap: 0.45rem !important; }
        .ss-nav-actions > .ss-icon-btn:not(.ss-lang-btn),
        .ss-bell { display: none; }
        .ss-lang-btn {
            width: auto;
            min-width: 58px;
            height: 38px;
            padding-inline: 0.55rem;
        }
        .ss-lang-name, .ss-lang-code::after { display: none; }
        .ss-userchip { padding: 2px; border-radius: 50%; }
        .ss-avatar { width: 38px; height: 38px; }

        .ss-navpills { display: none !important; }

        .ss-mobile-bottom-nav {
            position: fixed;
            left: 0.65rem;
            right: 0.65rem;
            bottom: max(0.65rem, env(safe-area-inset-bottom));
            z-index: 1000;
            display: grid !important;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 0.2rem !important;
            min-height: 64px;
            padding: 0.4rem;
            border: 1px solid rgba(139, 92, 246, 0.22);
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 18px 45px rgba(49, 46, 129, 0.24);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            backdrop-filter: blur(18px) saturate(160%);
        }
        .ss-mobile-bottom-link {
            position: relative;
            display: flex;
            min-width: 0;
            min-height: 52px;
            padding: 0.35rem 0.15rem;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.1rem;
            border-radius: 15px;
            color: #64748b;
            line-height: 1.05;
            text-decoration: none;
        }
        .ss-mobile-bottom-link i { font-size: 1.1rem; }
        .ss-mobile-bottom-link span {
            display: block;
            max-width: 100%;
            overflow: hidden;
            font-size: 0.58rem;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .ss-mobile-bottom-link.active {
            color: #6847eb;
            background: rgba(104, 71, 235, 0.08);
        }
        .ss-mobile-bottom-link.active::after {
            content: "";
            position: absolute;
            left: 22%;
            right: 22%;
            bottom: 0;
            height: 3px;
            border-radius: 999px;
            background: #6847eb;
        }
        html[data-theme="dark"] .ss-mobile-bottom-nav {
            background: rgba(28, 24, 57, 0.94);
            border-color: rgba(167, 139, 250, 0.25);
        }
        html[data-theme="dark"] .ss-mobile-bottom-link { color: #cbd5e1; }
        html[data-theme="dark"] .ss-mobile-bottom-link.active {
            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.18);
        }
    }

    @@media (max-width: 390px) {
        .ss-brand > span { display: inline; font-size: 0.95rem; }
        .ss-brand-logo { width: 34px; height: 34px; }
        .ss-auth-actions .ss-register-link { display: none; }
        .ss-auth-actions .ss-login-link {
            display: inline-flex;
            min-height: 38px;
            padding-inline: 0.55rem;
            background: transparent;
            font-size: 0.75rem;
        }
    }

    /* Dark theme: lighten nav text/icons so they read on the deep canvas. */
    html[data-theme="dark"] .ss-navpill { color: #cbd5e1; }
    html[data-theme="dark"] .ss-navpill:hover { color: #fff; background: rgba(139, 92, 246, 0.18); }
    html[data-theme="dark"] .ss-navpill.active { color: #fff; background: rgba(139, 92, 246, 0.28); }
    html[data-theme="dark"] .ss-icon-btn {
        background: rgba(45, 39, 86, 0.6);
        color: #cbd5e1;
    }
    html[data-theme="dark"] .ss-icon-btn:hover { background: rgba(139, 92, 246, 0.3); color: #fff; }
    html[data-theme="dark"] .ss-userchip:hover { background: rgba(139, 92, 246, 0.18); }
    html[data-theme="dark"] .ss-login-link { background: rgba(45, 39, 86, 0.6); color: #e5e7eb; }

    /* Shared modal (used by Settings suspend/delete confirm) */
    .ss-modal-backdrop {
        position: fixed; inset: 0; z-index: 200;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(4px);
        display: flex; align-items: center; justify-content: center;
        padding: 1rem;
        animation: ss-fade-in 0.2s ease;
    }
    .ss-modal {
        width: 100%; max-width: 380px;
        background: #fff;
        border-radius: 22px;
        padding: 1.75rem;
        box-shadow: var(--shadow-glass-hover);
        animation: ss-pop-in 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @@keyframes ss-fade-in { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes ss-pop-in {
        from { opacity: 0; transform: translateY(12px) scale(0.94); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
</style>

@code {
    // Follow the page rendered by SSR, not the URL that changes before its
    // enhanced-navigation response arrives.
    [Parameter] public string RenderedPath { get; set; } = "/";
    private bool IsCurrent(string href) => (href == "/more" && NavigationAccessRules.IsMoreRoute(RenderedPath)) || RenderedPath.Equals(href, StringComparison.OrdinalIgnoreCase)
        || (href != "/" && RenderedPath.StartsWith(href.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase));
    private string LinkClass(string css, string href) => IsCurrent(href) ? css + " active" : css;
    private string? CurrentLink(string href) => IsCurrent(href) ? "page" : null;

    // Keep SSR destinations during hydration instead of briefly resetting Home to '/'.
    [PersistentState] public bool authenticated { get; set; }
    [PersistentState] public bool isAdmin { get; set; }
    // Reuse this request's server-verified result while the same identity
    // hydrates. Unknown/error/logout states never reuse an older account's UI.
    [PersistentState] public int? VerifiedCompletedUser { get; set; }
    private AssessmentAccessStatus DockStatus => Access.Status == AssessmentAccessStatus.Loading
        && VerifiedCompletedUser == Access.UserId ? AssessmentAccessStatus.Complete : Access.Status;
    private string HomeHref => isAdmin ? "/admin/dashboard" : authenticated ? "/dashboard" : "/";
    protected override void OnInitialized() { L.OnChanged += StateHasChangedSafe; Access.Changed += StateHasChangedSafe; }
    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthProvider.GetAuthenticationStateAsync()).User;
        authenticated = principal.Identity?.IsAuthenticated == true;
        isAdmin = principal.IsInRole("Admin");
    }
    protected override async Task OnParametersSetAsync()
    {
        await Access.LoadAsync();
        VerifiedCompletedUser = Access.Status == AssessmentAccessStatus.Complete ? Access.UserId : null;
    }
    private void StateHasChangedSafe() => InvokeAsync(StateHasChanged);
    public void Dispose() { L.OnChanged -= StateHasChangedSafe; Access.Changed -= StateHasChangedSafe; }
}
