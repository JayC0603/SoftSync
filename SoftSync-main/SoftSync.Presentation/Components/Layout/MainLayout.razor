@inherits LayoutComponentBase
@inject LocalizationService L

<div class="page">
    <a class="ss-skip-link" href="#main-content"><LocalizedText Text="Skip to main content" /></a>
    <NavBar />
    <WelcomeToast />

    <div class="ss-workspace">
        <header class="ss-workspace-topbar">
            <button type="button" class="ss-sidebar-toggle ss-shell-control" data-sidebar-toggle aria-controls="ss-main-sidebar" aria-expanded="false" aria-label="@L["layout.toggleSidebar"]" onclick="window.ssDesign.toggleSidebar()"><i class="bi bi-list" aria-hidden="true"></i></button>
            <a class="ss-mobile-brand" href="/dashboard" aria-label="SoftSync"><img src="/images/logo.png" alt="" width="32" height="32" /><span>SoftSync</span></a>
            <div class="ss-workspace-left">
                <WorkspaceTitle />
            </div>
            <HeaderActions />
        </header>

        <main id="main-content" tabindex="-1" class="container tw:py-12 ss-main-content">
            @Body
        </main>
        <AppFooter />
    </div>
</div>

<AppErrorNotice />
