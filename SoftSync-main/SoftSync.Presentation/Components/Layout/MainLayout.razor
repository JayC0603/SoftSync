@inherits LayoutComponentBase
@inject LocalizationService L

<div class="page">
    <a class="ss-skip-link" href="#main-content">Skip to main content</a>
    <NavBar />
    <WelcomeToast />

    <div class="ss-workspace">
        <header class="ss-workspace-topbar">
            <div class="ss-workspace-left">
                <button type="button" class="ss-shell-control ss-sidebar-toggle" onclick="window.ssDesign.toggleSidebar(this)" aria-label="@L["layout.toggleSidebar"]" aria-expanded="true">
                    <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
                </button>
                <WorkspaceTitle />
            </div>
            <HeaderActions />
        </header>

        <main id="main-content" tabindex="-1" class="container tw:py-12 ss-main-content">
            @Body
        </main>
        <AppFooter />
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error notification">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
</div>
