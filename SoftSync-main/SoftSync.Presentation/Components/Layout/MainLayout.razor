@inherits LayoutComponentBase

<div class="page">
    <a class="ss-skip-link" href="#main-content">Skip to main content</a>
    <NavBar />
    <WelcomeToast />

    <div id="main-content" tabindex="-1" class="container tw:py-12 ss-main-content">
        @Body
    </div>
    <AppFooter />
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error notification">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
</div>
