@rendermode InteractiveServer
@inherits LocalizedComponentBase
@using SoftSync.Common.Enums

<footer class="eco-footer">
    <div class="eco-footer-inner">
        <div class="eco-footer-brand"><strong>SoftSync</strong><span>@Tx("Learn with purpose. Practice with confidence.", "Học có mục tiêu. Thực hành đầy tự tin.")</span></div>
        <nav aria-label="@Tx("About SoftSync", "Thông tin SoftSync")">
            <a href="/about">@Tx("About", "Về chúng tôi")</a>
            <a href="/mentors">@Tx("Mentors", "Cố vấn")</a>
            <a href="/community">@Tx("Community", "Cộng đồng")</a>
            <a href="/resources">@Tx("Resources", "Tài nguyên")</a>
        </nav>
        <div class="eco-footer-socials">
            <a class="eco-footer-icon" href="https://www.facebook.com/SoftSyncSpace" target="_blank" rel="noopener noreferrer" title="@Tx("Facebook page", "Trang Facebook")" aria-label="@Tx("Open SoftSync Facebook page in a new tab", "Mở trang Facebook SoftSync trong thẻ mới")">
                <i class="bi bi-facebook" aria-hidden="true"></i>
            </a>
        <a class="eco-external eco-footer-icon" href="https://softsync.id.vn/" target="_blank" rel="noopener noreferrer" title="@Tx("Official website", "Trang web chính thức")" aria-label="@Tx("Open SoftSync website in a new tab", "Mở trang web SoftSync trong thẻ mới")">
            <i class="bi bi-globe2" aria-hidden="true"></i>
        </a>
        </div>
    </div>
</footer>

@code { private string Tx(string en, string vi) => L.Current == AppLanguage.Vi ? vi : en; }
