@rendermode InteractiveServer
@inherits LocalizedComponentBase
@inject IJSRuntime JS

<header class="ss-public-header ss-unified-public-header">
    <a class="ss-public-brand" href="/" aria-label="SoftSync"><img src="/images/logo.png" alt="" width="36" height="36" /><strong>SoftSync</strong></a>
    <nav class="ss-public-links" aria-label="@Tx("Main navigation", "Điều hướng chính")">
        <NavLink href="/" Match="NavLinkMatch.All">@L["nav.home"]</NavLink><NavLink href="/about">@Tx("About", "Giới thiệu")</NavLink><NavLink href="/mentors">Mentor</NavLink><NavLink href="/community">@Tx("Community", "Cộng đồng")</NavLink>
    </nav>
    <div class="ss-public-actions">
        <details class="ss-header-language ss-header-menu">
            <summary class="ss-header-control ss-header-language-trigger" aria-label="@L["layout.languageMenu"]">
                <img class="ss-language-flag" src="@(L.Current == AppLanguage.Vi ? "/images/flags/vi.svg" : "/images/flags/en.svg")" width="28" height="20" alt="@(L.Current == AppLanguage.Vi ? "Tiếng Việt" : "English")" />
            </summary>
            <div class="ss-header-dropdown">
                <button type="button" aria-pressed="@(L.Current == AppLanguage.Vi)" @onclick="() => SetLanguage(AppLanguage.Vi)"><img src="/images/flags/vi.svg" width="28" height="20" alt="" />Tiếng Việt</button>
                <button type="button" aria-pressed="@(L.Current == AppLanguage.En)" @onclick="() => SetLanguage(AppLanguage.En)"><img src="/images/flags/en.svg" width="28" height="20" alt="" />English</button>
            </div>
        </details>
        <button type="button" class="ss-shell-control" onclick="window.ssDesign.toggleTheme()" aria-label="@L["layout.toggleTheme"]"><i class="bi bi-circle-half" aria-hidden="true"></i></button>
        <a class="ss-public-start" href="/Account/Register"><span>@Tx("Start for free", "Bắt đầu miễn phí")</span><i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        <button type="button" class="ss-shell-control ss-public-drawer-trigger" onclick="document.getElementById('ss-public-drawer').showModal()" aria-haspopup="dialog" aria-controls="ss-public-drawer" aria-label="@Tx("Open navigation", "Mở điều hướng")"><i class="bi bi-list" aria-hidden="true"></i></button>
    </div>
</header>
<dialog id="ss-public-drawer" class="ss-public-drawer" aria-labelledby="ss-public-drawer-title" onclick="if(event.target===this)this.close()">
    <div class="ss-public-drawer-content">
        <form method="dialog" class="ss-public-drawer-heading"><strong id="ss-public-drawer-title">SoftSync</strong><button class="ss-shell-control" aria-label="@Tx("Close navigation", "Đóng điều hướng")"><i class="bi bi-x-lg" aria-hidden="true"></i></button></form>
        <nav aria-label="@Tx("Explore SoftSync", "Khám phá SoftSync")" onclick="if(event.target.closest('a'))document.getElementById('ss-public-drawer').close()">
            <a href="/about">@Tx("About SoftSync", "Về SoftSync")</a>
            <a href="/#learning-journey">@Tx("Growth journey", "Hành trình phát triển")</a>
            <a href="/#features">@Tx("Key features", "Tính năng nổi bật")</a>
            <a href="/mentors">@Tx("Mentors & community", "Mentor & Cộng đồng")</a>
            <a href="/resources">@Tx("Learning resources", "Tài nguyên học tập")</a>
            <span aria-disabled="true" title="TBD — URL">@Tx("Help", "Trợ giúp")</span>
            <span aria-disabled="true" title="TBD — URL">@Tx("Contact", "Liên hệ")</span>
            <span aria-disabled="true" title="TBD — URL">@Tx("Privacy policy", "Chính sách bảo mật")</span>
        </nav>
        <div class="ss-public-drawer-auth"><a href="/Account/Login">@L["nav.login"]</a><a href="/Account/Register">@Tx("Register", "Đăng ký")</a></div>
    </div>
</dialog>

@code {
    private string Tx(string en, string vi) => L.Current == AppLanguage.Vi ? vi : en;
    private async Task SetLanguage(AppLanguage next)
    {
        await JS.InvokeVoidAsync("ssLang.set", next == AppLanguage.Vi ? "vi" : "en");
        L.SetLanguage(next);
    }
}
