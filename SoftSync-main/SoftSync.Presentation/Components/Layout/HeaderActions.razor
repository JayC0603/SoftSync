@rendermode InteractiveServer
@implements IDisposable
@using SoftSync.BLL.Interfaces
@using SoftSync.Common.Dtos
@using SoftSync.Common.Enums
@inject LocalizationService L
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthProvider
@inject UserProfileState UserProfileState

<div class="ss-header-actions">
    <details class="ss-header-language ss-header-menu">
        <summary class="ss-header-control" aria-label="@L["layout.languageMenu"]">
            <i class="bi bi-globe2" aria-hidden="true"></i><span>@CurrentLanguageCode</span><i class="bi bi-chevron-down ss-header-chevron" aria-hidden="true"></i>
        </summary>
        <div class="ss-header-dropdown">
            <button type="button" disabled="@(!interactiveReady)" aria-pressed="@(L.Current == AppLanguage.Vi)" @onclick="() => SetLanguageAsync(AppLanguage.Vi)">@L["layout.language.vi"]</button>
            <button type="button" disabled="@(!interactiveReady)" aria-pressed="@(L.Current == AppLanguage.En)" @onclick="() => SetLanguageAsync(AppLanguage.En)">@L["layout.language.en"]</button>
        </div>
    </details>
    <button type="button" class="ss-shell-control ss-header-theme" onclick="window.ssDesign.toggleTheme()" aria-label="@L["layout.toggleTheme"]"><i class="bi bi-circle-half" aria-hidden="true"></i></button>
    <AuthorizeView>
        <Authorized>
            <details class="ss-header-profile ss-header-menu">
                <summary class="ss-header-control ss-header-user" aria-label="@L["layout.profileMenu"]">
                    <span class="ss-header-avatar">
                        @if (!string.IsNullOrEmpty(profile?.AvatarUrl))
                        {
                            <img src="@profile.AvatarUrl" alt="" width="34" height="34" />
                        }
                        else
                        {
                            <img src="@Mascot.ImageFor(profile?.Gender ?? Gender.Unspecified)" alt="" width="34" height="34" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
                            <i class="bi bi-person-fill ss-header-avatar-fallback" aria-hidden="true"></i>
                        }
                    </span>
                    <span class="ss-header-user-info"><strong title="@(profile?.PublicName ?? context.User.Identity?.Name)">@(profile?.PublicName ?? context.User.Identity?.Name)</strong>
                        @if (profile is not null) { <small>@L["nav.level"] @profile.Level</small> }
                    </span>
                    <i class="bi bi-chevron-down ss-header-chevron" aria-hidden="true"></i>
                </summary>
                <div class="ss-header-dropdown ss-header-profile-dropdown">
                    <div class="ss-header-menu-identity"><strong>@(profile?.PublicName ?? context.User.Identity?.Name)</strong>@if (profile is not null) { <small>@L["nav.level"] @profile.Level</small> }</div>
                    <a href="/profile"><i class="bi bi-person" aria-hidden="true"></i>@L["nav.profile"]</a>
                    <a href="/roadmap"><i class="bi bi-book" aria-hidden="true"></i>@L["nav.learn"]</a>
                    <a href="/settings"><i class="bi bi-gear" aria-hidden="true"></i>@L["nav.settings"]</a>
                    <a href="/cv"><i class="bi bi-file-earmark-person" aria-hidden="true"></i>@(L.Current == AppLanguage.Vi ? "CV thông minh" : "Smart CV")</a>
                    <AuthorizeView Roles="Teacher,Admin" Context="staffContext"><Authorized><a href="/teacher"><i class="bi bi-person-video3" aria-hidden="true"></i>Teacher Studio</a></Authorized></AuthorizeView>
                    <AuthorizeView Roles="Admin" Context="adminContext"><Authorized><a href="/admin/users"><i class="bi bi-person-gear" aria-hidden="true"></i>@L["layout.manageUsers"]</a></Authorized></AuthorizeView>
                    <form action="/Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="returnUrl" value="Account/Login" /><button type="submit"><i class="bi bi-box-arrow-right" aria-hidden="true"></i>@L["nav.logout"]</button></form>
                </div>
            </details>
        </Authorized>
        <NotAuthorized>
            <a class="ss-header-login" href="/Account/Login">@L["nav.login"]</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private UserDto? profile;
    private bool interactiveReady;

    protected override void OnInitialized()
    {
        L.OnChanged += StateHasChangedSafe;
        UserProfileState.AvatarChanged += OnAvatarChanged;
        UserProfileState.DisplayNameChanged += OnDisplayNameChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            interactiveReady = true;
            await InvokeAsync(StateHasChanged);
            // Load the user's profile (avatar + level) in its own DI scope so we
            // don't share the page's scoped DbContext (avoids a concurrent-query
            // crash when a page also queries the DB during its own init).
            await LoadProfileAsync();
        }
    }

    private async Task SetLanguageAsync(AppLanguage next)
    {
        await JS.InvokeVoidAsync("ssLang.set", next == AppLanguage.Vi ? "vi" : "en");
        L.SetLanguage(next);
    }

    private string CurrentLanguageCode => L.Current == AppLanguage.Vi ? "VI" : "EN";

    private void StateHasChangedSafe() => InvokeAsync(StateHasChanged);

    private void OnAvatarChanged(string avatarUrl)
    {
        if (profile is not null)
        {
            profile.AvatarUrl = avatarUrl;
            _ = InvokeAsync(StateHasChanged);
        }
        else
        {
            _ = LoadProfileAsync();
        }
    }

    private void OnDisplayNameChanged(string displayName)
    {
        if (profile is not null)
        {
            profile.DisplayName = displayName;
            _ = InvokeAsync(StateHasChanged);
        }
        else
        {
            _ = LoadProfileAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        var userId = await AuthProvider.GetUserIdAsync();
        if (userId <= 0) return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var userService = scope.ServiceProvider.GetRequiredService<IUserService>();
        profile = await userService.GetUserByIdAsync(userId);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChanged -= StateHasChangedSafe;
        UserProfileState.AvatarChanged -= OnAvatarChanged;
        UserProfileState.DisplayNameChanged -= OnDisplayNameChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
