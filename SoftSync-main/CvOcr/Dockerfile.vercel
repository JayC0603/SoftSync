FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 OMP_NUM_THREADS=2 PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
RUN useradd --create-home ocr && mkdir -p /home/ocr/.paddlex && chown -R ocr:ocr /home/ocr/.paddlex
COPY app.py layout.py engine.py ./
USER ocr
# Download model weights at build time; runtime startup does not need downloads.
RUN python -c "from engine import create_engine; create_engine()"
EXPOSE 80
CMD ["/bin/sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-80} --workers 1 --no-access-log"]
