# Public URL of the ASP.NET Core API. The Next.js frontend itself is deployed
# by Vercel and receives a https://<project>.vercel.app URL automatically.
BACKEND_URL="https://your-backend-service.onrender.com"

# FastAPI service used by the complete CV dashboard at /cv. This stays on the
# server; browser requests go through the /api/cv proxy.
CV_API_URL="https://your-cv-api-service.example.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id"
